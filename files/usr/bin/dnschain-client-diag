#!/bin/sh
# ============================================================
# dnschain-client-diag — 客户机链路诊断与分级自愈
# ------------------------------------------------------------
# 设计依据：docs/adr/0009-client-link-diagnosis.md
# 术语：GLOSSARY.md 的「客户机链路诊断」「四段链路」「分级自愈」
#
# 职责：
#   1. 读 dnsmasq 日志（logread），解析出「哪台客户机 / 查了什么域名 /
#      转发给哪条链 / 收到什么答案」
#   2. 按四段链路判定失败（① 客户机→dnsmasq ② dnsmasq→dnsproxy
#      ③ dnsproxy→上游 ④ 客户机→目标IP）
#   4. 达阈值时按 L1→L2→L3→L4 逐级自愈
#   5. 失败记录与自愈审计落 tmpfs，供页面读取
#
# 子命令：
#   scan            扫一轮日志，更新失败记录，必要时触发自愈
#   daemon          常驻循环（procd 托管），每 interval 秒 scan 一次
#   list            输出客户机列表（TSV，供页面解析）
#   detail <IP>     输出某客户机的失败时间线（TSV）
#   autofix-log     输出自愈审计记录（TSV）
#   undo <id>       撤销一条自动调整
#   heal <level>    手动触发指定级别自愈（L1/L2/L3）
#   status          输出诊断功能的运行状态
#
# ⚠️ 本脚本必须 POSIX sh（dash）兼容 —— CI 用 sh -n 双检。
# ============================================================

. /usr/share/dnschain/dnschain.sh 2>/dev/null || exit 1

DIAG_FLOW_LOG="${DNSCHAIN_STATE_DIR}/client-flow.log"
DIAG_FAIL_LOG="${DNSCHAIN_STATE_DIR}/client-fail.log"
DIAG_FIX_LOG="${DNSCHAIN_STATE_DIR}/autofix.log"
DIAG_FIX_STATE="${DNSCHAIN_STATE_DIR}/autofix.state"
DIAG_LAST_SCAN="${DNSCHAIN_STATE_DIR}/diag-last-scan"
DIAG_LOCK="${DNSCHAIN_STATE_DIR}/.diag.lock"

# ── 自动补全（v0.24.0，ADR-0010）──────────────────────────────
#
# 计数器：<域名>|<客户机>|<次数>|<首次>|<最近>
# 由流水表（DIAG_FLOW_LOG）按游标增量累加而来。
# 为什么单独一张表而不是直接查流水：流水只留 600 秒，
# 而判定一个域名「值得学」需要跨多轮累计（阈值默认 3 次、
# 可能分散在半小时里）。游标保证同一批流水不会被重复累加。
DIAG_LEARN_COUNTER="${DNSCHAIN_STATE_DIR}/learn-counters.txt"
DIAG_LEARN_CURSOR="${DNSCHAIN_STATE_DIR}/learn-cursors.txt"
# 重试队列：<域名>|<失败轮数>|<最近时刻>
# 「两条链都不通」的域名不写规则，但要记轮数 —— 否则每轮都会
# 重新实测一遍（每轮 ×9 秒），永远学不完。
DIAG_LEARN_RETRY="${DNSCHAIN_STATE_DIR}/learn-retry.txt"
DIAG_LEARN_AUDIT="${DNSCHAIN_STATE_DIR}/learn-audit.log"
# L4 翻转的独立时间窗（与 L1-L3 的 autofix.state 分开）
DIAG_LEARN_L4="${DNSCHAIN_STATE_DIR}/learn-l4.state"
# 学习互斥锁 + 运行状态
#
# 为什么必须有锁（v0.24.0 实测踩过）：
#   学习一轮实测 68~152 秒（43~92 个候选 × 每条最多 24 秒）。
#   LuCI 的按钮走 CGI，超时后浏览器报 502 Bad Gateway，
#   而**进程还在跑** —— 用户以为失败又点一次，于是同一时刻
#   实测出现 **6 个 learn 进程并发**，每个都在做 DNS 探测，
#   把路由器与上游一起打满。
#   故：① 加锁，第二个实例直接退出并说明原因；
#       ② 页面按钮改成「后台启动 + 轮询状态」，不阻塞请求。
DIAG_LEARN_LOCK="${DNSCHAIN_STATE_DIR}/.learn.lock"
DIAG_LEARN_RUN="${DNSCHAIN_STATE_DIR}/learn-run.state"
# 学习进度：<TOTAL=..>/<DONE=..>/<CURRENT=..>，每判定完一个域名就更新
DIAG_LEARN_PROGRESS="${DNSCHAIN_STATE_DIR}/learn-progress.state"

# 「两条链都不通」累计多少轮后放弃（不再实测）
#
# 为什么是 3：单轮两条链都失败可能只是网络抖动（尤其跨境），
# 连续 3 轮都失败说明这个域名本身有问题（已下线 / 需要客户端
# 特定 SNI），再测也是白花时间。放弃后仍留在重试队列里，
# 用户点「清空计数器」可以重新开始。
_LEARN_GIVEUP_MAX=3

# 单轮学习的硬时间预算（秒）
#
# 每个域名最坏要 2 条链 × (1+retries) 次 × timeout，
# 默认 3 秒 × 4 次 × 2 = 24 秒。75 个候选就是 30 分钟。
# 清单里写的是「后台跑、页面显示进度」，但 daemon 是单线程 ——
# 学习一旦跑起来就挡住了日志消费。故设预算，超了就留到下一轮。
_LEARN_BUDGET_SEC=600

# ------------------------------------------------------------
# 日志解析
#
# dnsmasq 的日志格式（实测，见 ADR-0009 §2.1）：
#
#   dnsmasq[1]: 187349 192.168.3.193/35143 query[A] asia.pool.ntp.org from 192.168.3.193
#   dnsmasq[1]: 187349 192.168.3.193/35143 forwarded asia.pool.ntp.org to 127.0.0.1#5353
#   dnsmasq[1]: 187349 192.168.3.193/35143 reply asia.pool.ntp.org is 168.144.182.136
#
# 一个查询 ID 把「谁问的 / 问什么 / 转发给谁 / 答了什么」串起来。
# 按查询 ID 聚合，才能判断「有没有 reply」—— 这是第 ② 段的判据。
# ------------------------------------------------------------

# 提取「客户机 IP → 上游 → 是否收到 reply」的聚合视图
#
# 输出每行：<客户机IP>|<域名>|<上游>|<reply状态>|<答案>
# reply状态：ok / servfail / timeout / noreply（有 forwarded 但无 reply）
#
# ⚠️ 必须用 awk 单遍聚合，不能逐行 shell 调用 ——
#    实测 dnsmasq 日志一轮可上千行，逐行 fork 会拖垮 N2930。
_diag_parse() {
	awk '
	BEGIN { first_id = ""; last_id = ""; saw_cname = 0 }
	function flush() {
		if (qid == "") return
		if (domain == "") return
		# 窗口首尾的查询都可能不完整，一并丢弃：
		#
		#   首条 —— 它的 reply 可能在窗口之前就被读走了
		#   末条 —— 它的 reply 可能还没写进日志（日志正在增长）
		#
		# 实测两个方向都踩过：
		#   api.deepseek.com  首条截断 → 4 条真实 A 记录在窗口外 → 误判 noreply
		#   chat-4.tmspk.net  末条未完成 → 有 reply 但不在窗口内 → 误判 noreply
		#
		# 代价是每轮少算最多两个查询，可忽略。
		if (qid == first_id || qid == last_id) {
			qid = ""; domain = ""; up = ""; state = ""; ans = ""
			client = ""; saw_cname = 0
			return
		}
		#
		# ⚠️ 三种「无终态」必须分开，混了会大面积误报（实测踩过）：
		#
		#   pending  —— 已收到 <CNAME> 但终态答案还没到。
		#               最常见原因：**日志滑动窗口截断**。实测
		#               www.163.com 的 query[A] 与 query[AAAA] 都是
		#               forwarded → reply <CNAME> 就到窗口边界了，
		#               终态 A/AAAA 行落在窗口外。这是采样边界问题，
		#               **不是失败** —— 若判成失败，每次扫都会把正常
		#               域名记成故障并触发误自愈。
		#   noreply  —— 有 forwarded 但**一条 reply 都没有**。这是
		#               真实的第 ② 段失败（上游确实没回）。
		#   noquery  —— 只有 query 行、无 forwarded。dnsmasq 把并发
		#               相同查询合并了，正常行为，不是失败。
		#
		if (state == "" && saw_cname) state = "pending"
		else if (state == "" && up != "") state = "noreply"
		else if (state == "") state = "noquery"
		printf "%s|%s|%s|%s|%s\n", client, domain, up, state, ans
		qid = ""; domain = ""; up = ""; state = ""; ans = ""
		client = ""; saw_cname = 0
	}
	{
		# ⚠️ 必须先剥离行尾的 CR（\r）。
		#
		#    实测踩过：样本文件经 Windows 传输后带 CRLF，于是 f[6] 是
		#    "SERVFAIL\r" 而不是 "SERVFAIL"，字符串比较全部失配 ——
		#    失败被静默判成 ok，诊断功能等于失效。路由器日志本身虽为 LF，
		#    但 logread 输出经管道/终端可能带 CR，防御性剥离成本极低。
		sub(/\r$/, "")
		# 只处理 dnsmasq 的行
		if (index($0, "dnsmasq[") == 0) next
		# 取冒号后的内容
		p = index($0, "]: ")
		if (p == 0) next
		rest = substr($0, p + 3)
		n = split(rest, f, " ")
		if (n < 3) next

		# f[1] = 查询ID，f[2] = IP/端口
		thisid = f[1]
		if (thisid !~ /^[0-9]+$/) next

		# ⚠️ 丢弃「窗口首条」不完整的查询。
		#
		#    滑动窗口（tail -n N）必然把第一条查询的尾部截掉：它的
		#    reply 行可能在窗口之前就被读走了。实测 api.deepseek.com：
		#    ID 250633 的 4 条真实 A 记录（171.108.215.12 等）落在窗口外，
		#    窗口内只剩它的 query + forwarded → 被判成 noreply 失败，
		#    而该域名实际解析完全正常。
		#
		#    做法：记下窗口里出现的**第一个** query ID，它在 flush 时
		#    一律丢弃 —— 我们无法知道它前面还有多少行没读到。
		#    代价是每轮少算一个查询，可忽略。
		#
		# 新查询 ID → 冲掉上一条
		#
		# ⚠️ 必须把 action 判断放在**这个 if 之外**。
		#    原实现把整段 action 分支写在 `if (thisid != qid) {...}` 内部，
		#    于是同一查询 ID 的第 2 行起（forwarded / reply）走不到任何分支：
		#      · forwarded 不被记录 → up 为空
		#      · reply 不被记录   → state 为空
		#    最终 flush 时 state=="" 且 up=="" → 记成 noquery。
		#    实测：metric.huya.com 正常返回 NODATA，却被记成失败，
		#    还对 hs.p2p.huya.com 误执行了 L1 自愈。
		if (thisid != qid) {
			flush()
			qid = thisid
			split(f[2], ipp, "/")
			client = ipp[1]
			if (first_id == "") first_id = thisid
		}
		action = f[3]
		if (action == "query[A]" || action == "query[AAAA]" || action == "query[HTTPS]" || action == "query[ANY]") {
			# query[TYPE] domain from IP
			if (domain == "") domain = f[4]
		} else if (action == "forwarded") {
			# 只在还没记录域名时取（query 行的域名才是客户机问的原始域名）
			if (domain == "") domain = f[4]
			if (n >= 6) up = f[6]
		} else if (action == "reply" || action == "cached") {
			# reply / cached <域名> is <答案>
			#
			# ⚠️ `cached` 必须与 `reply` 同等处理。
			#    实测动作分布（一台路由器，最近一段日志）：
			#      reply 439 / cached 182 / forwarded 114 / nftset 24
			#    cached 是**命中缓存直接回复**，占第二多。原实现只认
			#    reply，于是所有缓存命中的查询 state 为空 →
			#    有 forwarded 的判成 noreply（误报失败）、
			#    无 forwarded 的判成 noquery。
			#    实测 28 条「失败」里绝大多数是这条引起的。
			#
			# ⚠️ 一个查询 ID 会有**多条** reply —— CNAME 链每一跳一行，
			#    最后一行才是终态。实测（hs.p2p.huya.com，query[HTTPS]）：
			#
			#      221459 ... reply hs.p2p.huya.com is <CNAME>
			#      221459 ... reply hs.p2p.huya.com.c.volcfcdndvs.com is <CNAME>
			#      221459 ... reply huya-p2p.jx.volclivedvs.com is <CNAME>
			#      221459 ... reply huya-p2p.tx.volclivedvs.com is <CNAME>
			#      221459 ... reply sched-l1-dk.tx.volclivedvs.com is NODATA
			#
			#    这条链的终态是 NODATA（HTTPS 记录确实不存在），**完全正常**。
			#    若只认第一个 reply 或只在 state 为空时记 NODATA，会判成
			#    noreply 并触发误自愈 —— 实测踩过：三个能正常解析的
			#    域名被判失败，还对其中一个执行了 L1 自愈。
			#
			#    所以：**每条 reply 都覆盖 state**，最后一条说了算。
			if (n >= 5) {
				what = f[5]
				if (what == "is") {
					ans = f[6]
					# CNAME 是中间跳，不改变 state（等最终行），
					# 但要记住「链路已开始」——flush 时据此区分 pending
					# 与真正的 noreply。
					if (ans == "<CNAME>") {
						saw_cname = 1
					} else if (ans == "NODATA-IPv6" || ans == "NODATA") {
						state = "nodata"
					} else if (ans == "NXDOMAIN") {
						state = "nxdomain"
					} else if (ans == "SERVFAIL") {
						state = "servfail"
					} else if (ans == "REFUSED") {
						state = "refused"
					} else {
						state = "ok"
					}
				}
				# what == "query" → `reply query is duplicate`，去重提示，不算失败
			}
		}
	}
	END { last_id = qid; flush() }
	'
}

# ------------------------------------------------------------
# 流式解析（daemon 专用）
#
# 与 _diag_parse 的区别：
#   _diag_parse  处理**有限快照**，首尾必然残缺，只能丢弃边界
#   _diag_stream 处理**无限流**，按查询 ID 在内存里跟踪在途查询，
#                收到终态即输出，超龄未完成才判失败
#
# 为什么必须这样：实测一条查询会跨 20+ 行（CNAME 链 + nftset 行），
# 快照窗口切在中间就产生「有 forwarded 无 reply」的假象 ——
# www.apple.com（10 条真实 A 记录）与 api.deepseek.com 都因此被
# 误判成 noreply，还对 copilot.tencent.com 误执行了 L1 自愈。
#
# 输出：<客户机IP>|<域名>|<上游>|<状态>|<答案>
# ------------------------------------------------------------
_diag_stream() {
	awk '
	BEGIN {
		FS = " "
		line_no = 0
		AGE = 400        # 超过这么多行没动静，判定该查询已死
		CHECK = 100      # 每这么多行做一次超龄清理
	}

	# 输出一条记录并清掉它的所有状态
	function emit(id) {
		if (!(id in q_dom)) return
		if (q_dom[id] == "") { delete_id(id); return }
		st = q_state[id]
		if (st == "") {
			if (q_cname[id]) st = "pending"
			else if (q_up[id] != "") st = "noreply"
			else st = "noquery"
		}
		printf "%s|%s|%s|%s|%s\n", q_client[id], q_dom[id], q_up[id], st, q_ans[id]
		delete_id(id)
		# 记住这个 ID 已结束 —— 同 ID 的后续 reply 行（CNAME 链的其余
		# 地址记录）不能再建一条新记录，否则 www.apple.com 会输出两次。
		q_done[id] = 1
	}

	function delete_id(id) {
		delete q_dom[id]; delete q_up[id]; delete q_client[id]
		delete q_state[id]; delete q_ans[id]; delete q_seen[id]
		delete q_cname[id]
	}

	# 清理超龄在途查询（真失败的查询不会再有后续行）
	function sweep(now) {
		for (id in q_dom) {
			if (now - q_seen[id] > AGE) emit(id)
		}
	}

	{
		sub(/\r$/, "")
		if (index($0, "dnsmasq[") == 0) next
		p = index($0, "]: ")
		if (p == 0) next
		rest = substr($0, p + 3)
		n = split(rest, f, " ")
		if (n < 3) next

		thisid = f[1]
		if (thisid !~ /^[0-9]+$/) next

		line_no++
		action = f[3]

		# 该查询已输出过终态，后续同 ID 的 reply 行一律忽略
		if (thisid in q_done) next

		if (action ~ /^query\[/) {
			# 新查询开始：先输出同 ID 的旧记录（ID 不会复用，保险）
			if (thisid in q_dom) emit(thisid)
			split(f[2], ipp, "/")
			q_client[thisid] = ipp[1]
			q_dom[thisid] = f[4]
			q_up[thisid] = ""
			q_state[thisid] = ""
			q_ans[thisid] = ""
			q_cname[thisid] = 0
		} else if (action == "forwarded") {
			if (!(thisid in q_dom)) {
				# 没见过 query 行（窗口起点），补一个
				split(f[2], ipp, "/")
				q_client[thisid] = ipp[1]
				q_dom[thisid] = f[4]
				q_state[thisid] = ""
				q_ans[thisid] = ""
				q_cname[thisid] = 0
			}
			if (n >= 6) q_up[thisid] = f[6]
		} else if (action == "reply" || action == "cached") {
			if (!(thisid in q_dom)) {
				split(f[2], ipp, "/")
				q_client[thisid] = ipp[1]
				q_dom[thisid] = f[4]
				q_state[thisid] = ""
				q_ans[thisid] = ""
				q_cname[thisid] = 0
			}
			if (n >= 5 && f[5] == "is") {
				a = f[6]
				if (a == "<CNAME>") {
					q_cname[thisid] = 1
				} else if (a == "NODATA-IPv6" || a == "NODATA") {
					q_state[thisid] = "nodata"; q_ans[thisid] = a
				} else if (a == "NXDOMAIN") {
					q_state[thisid] = "nxdomain"; q_ans[thisid] = a
				} else if (a == "SERVFAIL") {
					q_state[thisid] = "servfail"; q_ans[thisid] = a
				} else if (a == "REFUSED") {
					q_state[thisid] = "refused"; q_ans[thisid] = a
				} else {
					q_state[thisid] = "ok"; q_ans[thisid] = a
				}
				# 终态一到就输出，不再等
				if (q_state[thisid] != "" && q_state[thisid] != "pending") {
					emit(thisid)
					next
				}
			}
		} else {
			next
		}

		q_seen[thisid] = line_no
		if (line_no % CHECK == 0) sweep(line_no)
	}

	END { for (id in q_dom) emit(id) }
	'
}

# ------------------------------------------------------------
# 失败判定
#
# 只有 state 为 servfail / timeout / noreply 才算失败。
# nodata / nxdomain / refused / ok / duplicate 都不算（ADR-0009 §3.4）。
# ------------------------------------------------------------
_diag_is_fail() {
	case "$1" in
		servfail|noreply) return 0 ;;
		*) return 1 ;;
	esac
}

# 追加一条失败记录（TSV）
#
# 格式：<epoch>|<客户机IP>|<域名>|<上游>|<状态>|<段>
#
# 段号由状态反推（ADR-0009 §3.2）：
#   noreply  → ② dnsmasq 转发了但上游没回
#   servfail → ③ 上游明确失败
_diag_record_fail() {
	local ts ip dom up st seg
	ts="$1"; ip="$2"; dom="$3"; up="$4"; st="$5"
	case "$st" in
		noreply)  seg=2 ;;
		servfail) seg=3 ;;
		*)        seg=0 ;;
	esac
	printf '%s|%s|%s|%s|%s|%s\n' "$ts" "$ip" "$dom" "$up" "$st" "$seg" >> "$DIAG_FAIL_LOG"
	[ -f "$DIAG_FAIL_LOG" ] && chmod 644 "$DIAG_FAIL_LOG" 2>/dev/null
}

# 追加一条**查询流水**（TSV）
#
# 格式：<epoch>|<客户机IP>|<域名>|<上游>|<状态>|<段>|<答案>
#
# 与失败记录的区别：**流水记全部查询，不分成功失败**。
# 用户要「客户机发起的查询完整链路」，成功查询也必须看得到 ——
# 只看失败列表无法回答「这台设备刚才查了什么、走的哪条链」。
#
# 状态取值见 GLOSSARY「不算失败」：ok / nodata / nxdomain / refused /
# duplicate / pending / noquery / servfail / noreply。
_diag_record_flow() {
	local ts ip dom up st seg ans
	ts="$1"; ip="$2"; dom="$3"; up="$4"; st="$5"; ans="$6"
	case "$st" in
		noreply)  seg=2 ;;
		servfail) seg=3 ;;
		noquery)  seg=1 ;;
		*)        seg=0 ;;
	esac
	printf '%s|%s|%s|%s|%s|%s|%s\n' "$ts" "$ip" "$dom" "$up" "$st" "$seg" "$ans" >> "$DIAG_FLOW_LOG"
	# 首次创建时 umask 可能给出 600，显式放开读权限供 LuCI 读取
	[ -f "$DIAG_FLOW_LOG" ] && chmod 644 "$DIAG_FLOW_LOG" 2>/dev/null
}

# 修剪流水：按保留时长与条目上限（与失败记录独立配置）
_diag_trim_flow() {
	local keep_sec max_n now cutoff tmp
	keep_sec=$(dc_get client_diag flow_retain_sec 600)
	max_n=$(dc_get client_diag flow_retain_max 1000)

	[ -f "$DIAG_FLOW_LOG" ] || return 0
	now=$(date +%s)
	cutoff=$((now - keep_sec))

	tmp=$(mktemp) || return 1
	awk -F'|' -v c="$cutoff" '$1 >= c' "$DIAG_FLOW_LOG" | tail -n "$max_n" > "$tmp"
	# ⚠️ mktemp 建的文件是 0600，而 LuCI 的 rpcd 以受限身份读 ——
	#    权限不对时页面显示「保留期内还没有查询流水」，而数据其实在。
	#    实测踩过：脚本里 flow 有 364 条输出，页面却一片空。
	chmod 644 "$tmp" 2>/dev/null
	mv -f "$tmp" "$DIAG_FLOW_LOG"
	chmod 644 "$DIAG_FLOW_LOG" 2>/dev/null
}

# 修剪失败记录：按保留时长与条目上限
_diag_trim() {
	local keep_sec max_n now cutoff tmp
	keep_sec=$(dc_get client_diag retain_sec 3600)
	max_n=$(dc_get client_diag retain_max 500)

	[ -f "$DIAG_FAIL_LOG" ] || return 0
	now=$(date +%s)
	cutoff=$((now - keep_sec))

	tmp=$(mktemp) || return 1
	# 先按时间过滤，再按条数截尾（保留最新的 max_n 条）
	awk -F'|' -v c="$cutoff" '$1 >= c' "$DIAG_FAIL_LOG" | tail -n "$max_n" > "$tmp"
	chmod 644 "$tmp" 2>/dev/null
	mv -f "$tmp" "$DIAG_FAIL_LOG"
	chmod 644 "$DIAG_FAIL_LOG" 2>/dev/null
}

# ------------------------------------------------------------
# 阈值判定：同一域名在窗口内累计失败次数
#
# 默认 5 分钟内 ≥3 次（ADR-0009 §3.4）
# ------------------------------------------------------------
_diag_fail_count() {
	local dom win now cutoff
	dom="$1"
	win=$(dc_get client_diag fail_window 300)
	now=$(date +%s)
	cutoff=$((now - win))

	[ -f "$DIAG_FAIL_LOG" ] || { echo 0; return; }
	awk -F'|' -v d="$dom" -v c="$cutoff" '$2 != "" && $3 == d && $1 >= c { n++ } END { print n + 0 }' "$DIAG_FAIL_LOG"
}

# ------------------------------------------------------------
# 分级自愈 L1 → L2 → L3
#
# L4（改归属）单独处理，因为它要写 UCI 且必须分区隔离。
#
# ⚠️ 时间窗：自动自愈默认每小时最多 1 次（ADR-0009 §3.5）。
#    手动触发（heal 子命令）不受限 —— 用户明知可以断网才会点。
# ------------------------------------------------------------
_diag_window_ok() {
	local win last now
	win=$(dc_get client_diag autofix_interval 3600)
	last=$(cat "$DIAG_FIX_STATE" 2>/dev/null)
	case "$last" in ''|*[!0-9]*) last=0 ;; esac
	now=$(date +%s)
	[ $((now - last)) -ge "$win" ]
}

_diag_mark_fix() {
	date +%s > "$DIAG_FIX_STATE"
}

# 执行一级自愈，返回 0 表示成功
#
# L1: flush（SIGHUP dnsmasq，零中断）
# L2: apply（重建 split.conf）
# L3: 重启 dnsmasq（实测 3 秒中断）
# L4: 改归属（实测后翻转，v0.24.0）
#
# ⚠️ L4 只对「已学过、且现在直连不通」的域名生效，见 _learn_flip。
#    对不在自动国内列表里的域名调用它是空操作 —— 返回 0 会让
#    _diag_autofix 误判「L4 成功」，故这里要求调用方先判断适用性。
_diag_heal_level() {
	local lv out
	lv="$1"
	case "$lv" in
		1)
			out=$(/usr/bin/dnschain-selftest flush 2>&1)
			case "$out" in
				OK=*) return 0 ;;
				*) return 1 ;;
			esac
			;;
		2)
			out=$(/usr/bin/dnschain-selftest apply 2>&1)
			case "$out" in
				OK=*) return 0 ;;
				*) return 1 ;;
			esac
			;;
		3)
			/etc/init.d/dnsmasq restart >/dev/null 2>&1
			return 0
			;;
		4)
			# L4 需要域名参数，由 _diag_heal_level 的第 2 个参数传入
			[ -n "$2" ] || return 1
			_learn_flip "$2"
			return $?
			;;
		*) return 1 ;;
	esac
}

# 记一条自愈审计（可撤销）
#
# 格式：<id>|<epoch>|<级别>|<触发域名>|<结果>|<备注>
_diag_log_fix() {
	local id ts lv dom res note
	ts="$1"; lv="$2"; dom="$3"; res="$4"; note="$5"
	id=$(date +%s)$$
	printf '%s|%s|%s|%s|%s|%s\n' "$id" "$ts" "$lv" "$dom" "$res" "$note" >> "$DIAG_FIX_LOG"

	# 审计也受条目上限约束
	local max_n tmp
	max_n=$(dc_get client_diag retain_max 500)
	tmp=$(mktemp) || return 0
	tail -n "$max_n" "$DIAG_FIX_LOG" > "$tmp" && mv -f "$tmp" "$DIAG_FIX_LOG"
}

# 自动自愈主流程：先 L1，无效升 L2，再无效升 L3，最后 L4
#
# ⚠️ L4 的门槛与 L1-L3 **不同**（v0.24.0）：
#   L1-L3 在 fail_threshold（默认 3）就触发，动作是清缓存/重放/重启，
#   都是幂等的服务动作，代价可控。
#   L4 改 UCI 并触发分流重建，代价高得多，故用独立的
#   learn_autofix_threshold（默认 5），且只对「已学成国内」的域名生效。
#
#   把两者混用一个阈值会出两种错：要么 L4 太早翻转（3 次失败就改
#   归属，而失败可能只是上游抖动），要么把 L1-L3 拖到 5 次才动
#   （用户明显感觉「坏了半天系统才自愈」）。
_diag_autofix() {
	local dom ts lv ok cnt l4_need l4_ok
	dom="$1"
	ts=$(date +%s)

	# 时间窗：自动路径必须检查
	_diag_window_ok || return 0

	for lv in 1 2 3 4; do
		# L4 的适用性与门槛在此判断，不满足就跳过（不算失败）
		if [ "$lv" = "4" ]; then
			l4_need=$(dc_get client_diag learn_autofix_threshold 5)
			case "$l4_need" in ''|*[!0-9]*) l4_need=5 ;; esac

			cnt=$(_diag_fail_count "$dom")
			[ "$cnt" -ge "$l4_need" ] 2>/dev/null || continue

			# 只对自动国内列表里的域名翻转（其它域名没有可翻的归属）
			dc_get_list dom_auto_domestic domain 2>/dev/null \
				| grep -qxF "$dom" || continue
		fi

		if _diag_heal_level "$lv" "$dom"; then
			ok=1
			_diag_log_fix "$ts" "L$lv" "$dom" "ok" "自动自愈（域名 $dom 连续失败）"
			_diag_mark_fix
			dnschain_log "客户机诊断：$dom 连续失败，已执行 L$lv 自愈"
			return 0
		fi
	done

	_diag_log_fix "$ts" "L3" "$dom" "fail" "四级自愈均失败"
	_diag_mark_fix
	dnschain_log "客户机诊断：$dom 连续失败，L1-L4 均失败"
	return 1
}

# ============================================================
# 自动补全：学习层（v0.24.0，ADR-0010）
# ------------------------------------------------------------
# 要解决的问题（实测 2026-10-25）：客户机实际访问通的国内站点，
# 70% 的答案 IP 判不出归属 —— 112 个实测域名里 79 个的 IP 不在
# china 集合，APNIC 官方数据对其中 110 个也查不到。
#
# 判据来自**客户机实际收发**，不是地理库：
#   客户机查过、且解析成功的域名 → 候选
#   实测「直连通、代理不通或答案不同」→ 国内
#   实测「直连不通、代理通」        → 国外
#   两条都不通                      → 不写规则，记重试
#
# 三层文件：
#   计数器 learn-counters.txt  跨轮累计「某域名被某客户机查了几次」
#   游标   learn-cursors.txt   流水表已消费到的位置（避免重复累加）
#   重试   learn-retry.txt     「都不通」的域名与已试轮数
# ============================================================

# 「已覆盖域名」集合与「父域覆盖」判据，v0.24.0 已并入 _learn_candidates 的
# 单遍 awk（见该函数的性能说明）。
#
# 原来这里是两个独立函数：
#   _learn_known()             cat 三个文件 | sort -u
#   _learn_parent_covered()    逐级 grep -qxF
# 它们的调用者只有 _learn_candidates，而那个调用方式是**每行 fork 数次**，
# 实测 647 个候选 109 秒。现在这两个函数已删除 —— 逻辑仍在（在 awk 里
# 用哈希实现，语义相同），但不再有 shell 层的逐行 fork。
#
# 「已覆盖」的三个来源（顺序无关，awk 里统一建哈希）：
#   db-domains.txt        数据库（gfw 名单等）
#   custom-domestic.txt   手写国内 + 自动国内（dc_gen_custom_lists 已合并）
#   custom-foreign.txt    手写国外 + 自动国外
#
# ⚠️ 这份集合是**防震荡的核心**：学到的域名写进 dom_auto_* 之后，
#    下一轮 dc_gen_custom_lists 会把它合并进 custom-*.txt，
#    于是它算「已覆盖」→ 不再是候选 → 不会每轮重复实测。
#    少了这一步，同一个域名会被反复实测并反复改写 UCI。

# 按游标把流水表增量累加进计数器
#
# 流水格式（DIAG_FLOW_LOG）：<epoch>|<客户机>|<域名>|<上游>|<状态>|<段>|<答案>
# 计数器格式：            <域名>|<客户机>|<次数>|<首次>|<最近>
#
# 只统计「解析成功」的状态（ok / nodata）：
#   · servfail / noreply 是失败，学它会把坏域名写成规则
#   · nxdomain 说明域名不存在，学了没意义
#
# 游标按**客户机**分别记（<客户机>|<epoch>）：不同客户机的流水交错
# 写入，用单一游标会漏掉「较晚写入但 epoch 较小」的记录。
#
# ⚠️ 必须用 awk 单遍扫描，不能逐行 shell 循环：
#    流水一轮上千行，逐行 fork 会拖垮 N2930（与 _diag_parse 同一教训）。
_learn_accumulate() {
	local tmp ctmp

	[ -f "$DIAG_FLOW_LOG" ] || return 0
	[ -f "$DIAG_LEARN_CURSOR" ] || : > "$DIAG_LEARN_CURSOR"
	[ -f "$DIAG_LEARN_COUNTER" ] || : > "$DIAG_LEARN_COUNTER"

	# ── 新计数器 ────────────────────────────────────────────
	tmp=$(mktemp) || return 1
	awk -F'|' -v counter="$DIAG_LEARN_COUNTER" -v cursor="$DIAG_LEARN_CURSOR" '
		BEGIN {
			while ((getline line < counter) > 0) {
				split(line, f, "|")
				if (f[1] == "" || f[2] == "") continue
				k = f[1] "|" f[2]
				cn[k] = f[3] + 0
				cf[k] = f[4] + 0
				cl[k] = f[5] + 0
				keys[k] = 1
			}
			close(counter)
			while ((getline line < cursor) > 0) {
				split(line, f, "|")
				if (f[1] == "") continue
				cur[f[1]] = f[2] + 0
			}
			close(cursor)
		}
		{
			ep = $1 + 0
			ip = $2
			dom = $3
			st = $5
			if (dom == "" || ip == "") next
			if (st != "ok" && st != "nodata") next
			if (ep <= cur[ip]) next
			k = dom "|" ip
			cn[k]++
			if (!(k in cf) || cf[k] == 0) cf[k] = ep
			if (ep > cl[k]) cl[k] = ep
			keys[k] = 1
		}
		END {
			for (k in keys) {
				split(k, p, "|")
				printf "%s|%s|%d|%d|%d\n", p[1], p[2], cn[k], cf[k], cl[k]
			}
		}' "$DIAG_FLOW_LOG" 2>/dev/null | sort -t'|' -k1,1 -k2,2 > "$tmp"

	# 空结果也要落盘：否则「所有记录都被游标过滤」时旧文件会一直留着，
	# 而它里面可能含有已被 learn_clear 清掉的域名。
	mv -f "$tmp" "$DIAG_LEARN_COUNTER"

	# ── 游标 ────────────────────────────────────────────────
	#
	# 取「旧游标」与「流水里该客户机的最大 epoch」的较大者。
	# 只升不降 —— 流水被修剪后最大 epoch 会变小，若据此回退游标，
	# 下一轮会把已经计过的记录再计一遍，次数虚高。
	ctmp=$(mktemp) || return 1
	{
		[ -f "$DIAG_LEARN_CURSOR" ] && cat "$DIAG_LEARN_CURSOR"
		awk -F'|' '$1 != "" && $2 != "" {
				if ($1 + 0 > m[$2]) m[$2] = $1 + 0
			}
			END { for (i in m) printf "%s|%d\n", i, m[i] }' "$DIAG_FLOW_LOG" 2>/dev/null
	} | awk -F'|' '$1 != "" && $2 != "" {
			if ($2 + 0 > best[$1]) best[$1] = $2 + 0
		}
		END { for (i in best) printf "%s|%d\n", i, best[i] }' \
		| sort > "$ctmp"
	mv -f "$ctmp" "$DIAG_LEARN_CURSOR"

	chmod 644 "$DIAG_LEARN_COUNTER" "$DIAG_LEARN_CURSOR" 2>/dev/null
	return 0
}

# 修剪计数器：按 learn_retain_days 丢弃过旧记录
_learn_trim_counter() {
	local days cutoff now tmp
	[ -f "$DIAG_LEARN_COUNTER" ] || return 0

	days=$(dc_get client_diag learn_retain_days 30)
	case "$days" in ''|*[!0-9]*) days=30 ;; esac
	[ "$days" -lt 1 ] 2>/dev/null && days=1

	now=$(date +%s)
	cutoff=$((now - days * 86400))

	tmp=$(mktemp) || return 1
	awk -F'|' -v c="$cutoff" '($5 + 0) >= c' "$DIAG_LEARN_COUNTER" > "$tmp" 2>/dev/null \
		&& mv -f "$tmp" "$DIAG_LEARN_COUNTER"
	chmod 644 "$DIAG_LEARN_COUNTER" 2>/dev/null
	return 0
}

# 筛出候选域名（写到 stdout，每行一个）
#
# 五道过滤，每道都对应一种实测过的坏情况：
#   ① 次数 ≥ learn_threshold     —— 单次访问可能是误点，累计才算「常用」
#   ② 不在已覆盖集合             —— 已学过/手写/数据库里有的不再学
#   ③ 不以 `_` 开头              —— `_dns.resolver.arpa` 这类服务记录不是站点
#   ④ 父域未被覆盖               —— www.example.com 学过就不学 a.www.example.com
#   ⑤ 不在重试队列的「已放弃」   —— 连续 3 轮都不通的域名不再实测
#
# ⚠️ 必须单遍 awk，不能逐行 shell 循环（v0.24.0 实测，这是最大的一处性能坑）。
#
#   原实现是 `awk ... | sort | while read dom; do ... done`，循环体里
#   每条域名要 fork 出 3~4 个进程（grep -qxF、_learn_parent_covered
#   内部又循环 grep、awk 查重试队列）。实测 647 个候选耗时 **109 秒**，
#   而这只是学习一轮的**准备阶段** —— 真正的实测还没开始。
#
#   改成一个 awk 进程里做完五道过滤：读三个「已覆盖」文件建哈希，
#   读重试队列建哈希，再扫计数器。实测同样的 647 条降到约 60ms。
#
#   注意 awk 里做「父域逐级检查」：对每个候选反复去掉最左标签，
#   每级查一次哈希。域名最多 10 级，即每条约 10 次哈希查找 —— 零 fork。
_learn_candidates() {
	local threshold

	[ -f "$DIAG_LEARN_COUNTER" ] || return 0

	threshold=$(dc_get client_diag learn_threshold 3)
	case "$threshold" in ''|*[!0-9]*) threshold=3 ;; esac
	[ "$threshold" -lt 1 ] 2>/dev/null && threshold=1

	# 每台客户机分别累计：同一域名在 3 台机器上各查 1 次
	# 与在 1 台机器上查 3 次，是两种不同强度的证据。
	# 取**最大值**而不是总和 —— 总和会让「很多人偶尔查一次」
	# 的公共域名轻易达标，而那些域名多半已在数据库里。
	awk -F'|' -v t="$threshold" \
		-v db="$DNSCHAIN_DB_DOMAINS" \
		-v cd="$DNSCHAIN_CUSTOM_DOM" \
		-v cf="$DNSCHAIN_CUSTOM_FOR" \
		-v retry="$DIAG_LEARN_RETRY" \
		-v giveup_max="$_LEARN_GIVEUP_MAX" '
		# 读「已覆盖域名」三个来源
		function load_known(path,    line, k) {
			while ((getline line < path) > 0) {
				gsub(/^[ \t]+|[ \t]+$/, "", line)
				if (line == "" || line ~ /^#/) continue
				known[line] = 1
			}
			close(path)
		}

		# 读重试队列：域名 → 已试轮数
		function load_retry(path,    line, f) {
			while ((getline line < path) > 0) {
				split(line, f, "|")
				if (f[1] == "") continue
				giveup[f[1]] = f[2] + 0
			}
			close(path)
		}

		BEGIN {
			load_known(db)
			load_known(cd)
			load_known(cf)
			load_retry(retry)
		}

		{
			dom = $1
			n = $3 + 0
			if (dom == "" || n < t) next
			if (n > best[dom]) best[dom] = n
		}

		END {
			for (dom in best) {
				# ③ 服务记录前缀
				if (dom ~ /^_/ || dom ~ /\._/) continue

				# ② 已覆盖
				if (dom in known) continue

				# ④ 父域已覆盖：逐级去掉最左标签
				d = dom
				covered = 0
				while (match(d, /\./)) {
					d = substr(d, RSTART + 1)
					if (d in known) { covered = 1; break }
				}
				if (covered) continue

				# ⑤ 已放弃
				if ((dom in giveup) && giveup[dom] >= giveup_max) continue

				print dom
			}
		}' "$DIAG_LEARN_COUNTER" 2>/dev/null | sort
}

# 链路实测判定
#
# 输出：domestic | foreign | both-bad | both-ok-same | invalid
#
# 判定表（清单原文，ADR-0010 §2）：
#   直连通 + (代理不通 或 两条链答案不同) → domestic
#   直连不通 + 代理通                     → foreign
#   两条都不通                            → both-bad
#   两条都通且答案相同                    → both-ok-same（不需要规则）
#   两条都 NXDOMAIN                       → invalid
#
# ⚠️ 「答案不同 → domestic」这条的正确性有前提，必须写清楚（ADR-0010 §8）：
#
#   对**合法的国内 CDN 域名**（如 www.taobao.com），两条链返回不同 IP
#   是正常的（不同 CDN 节点），判 domestic 正确。
#
#   对**未入 gfw 名单但被污染**的域名，直连侧拿到的是污染答案，
#   此时判 domestic 是错的 —— 它该走代理。但这类域名在本功能里
#   **本来就该由 L4 纠错**：客户机会因为答案不可用而查询失败，
#   累计到 learn_autofix_threshold 后 _learn_flip 会把它翻成国外。
#   所以这里的误判不是永久性的，但有最长一个 learn_interval 的窗口。
#
#   不做「TCP 实测」来区分这两种情况：那需要每域名 2 次 nc 探测
#   （实测每个 3 秒超时），首轮 75 个候选就是 7.5 分钟，
#   而 DNS 级探测已足够筛掉「根本不通」的情形。
_learn_judge() {
	local d tmo retries r_dom r_for a_dom a_for dom_up for_up

	d="$1"
	tmo=$(dc_get client_diag learn_timeout 3)
	retries=$(dc_get client_diag learn_retries 3)

	r_dom=$(dc_probe_chain "$d" domestic "$tmo" "$retries")
	r_for=$(dc_probe_chain "$d" foreign "$tmo" "$retries")

	# NX 说明域名不存在（可能是日志里的历史记录），不学
	if [ "$r_dom" = "NX" ] && [ "$r_for" = "NX" ]; then
		echo "invalid"
		return 0
	fi

	dom_up=0
	for_up=0
	case "$r_dom" in OK|EMPTY) dom_up=1 ;; esac
	case "$r_for" in OK|EMPTY) for_up=1 ;; esac

	if [ "$dom_up" = "1" ] && [ "$for_up" = "1" ]; then
		a_dom=$(dc_dns_first_addr "$d" "127.0.0.1:$(dc_get main entry_port 5353)" a "$tmo")
		a_for=$(dc_dns_first_addr "$d" "127.0.0.1:$(dc_get main foreign_port 5336)" a "$tmo")
		if [ -n "$a_dom" ] && [ -n "$a_for" ] && [ "$a_dom" != "$a_for" ]; then
			echo "domestic"
		else
			echo "both-ok-same"
		fi
		return 0
	fi

	if [ "$dom_up" = "1" ]; then
		echo "domestic"
		return 0
	fi
	if [ "$for_up" = "1" ]; then
		echo "foreign"
		return 0
	fi
	echo "both-bad"
	return 0
}

# 写一条自动归属（互斥：写入前先删另一侧）
#
# ⚠️ del_list 另一侧是必须的（清单明确要求，也是实测教训）：
#    v0.22.0 删掉自动改道，正是因为「同一域名在两处都有规则时
#    dnsmasq 把两条 server= 当候选而非覆盖」。写 UCI 时若不删
#    另一侧，会制造出完全相同的冲突。
_learn_write() {
	local d side

	d="$1"
	side="$2"

	case "$side" in
		domestic)
			uci -q del_list "dnschain.dom_auto_foreign.domain=$d" 2>/dev/null
			uci -q add_list "dnschain.dom_auto_domestic.domain=$d" 2>/dev/null || return 1
			;;
		foreign)
			uci -q del_list "dnschain.dom_auto_domestic.domain=$d" 2>/dev/null
			uci -q add_list "dnschain.dom_auto_foreign.domain=$d" 2>/dev/null || return 1
			;;
		*) return 1 ;;
	esac

	# 手写列表里已有的不重复写（手写优先，自动让位）
	local hand
	hand=$(dc_get_list "dom_${side}" domain 2>/dev/null)
	printf '%s\n' "$hand" | grep -qxF "$d" && return 0

	uci -q commit dnschain 2>/dev/null || return 1
	return 0
}

# 记一条学习审计
#
# 格式：<epoch>|<域名>|<归属>|<来源>|<判定依据>
# 来源：manual = 用户点「立即学习」；auto = daemon 定时
_learn_log() {
	local ts d side src why
	ts="$1"; d="$2"; side="$3"; src="$4"; why="$5"
	printf '%s|%s|%s|%s|%s\n' "$ts" "$d" "$side" "$src" "$why" >> "$DIAG_LEARN_AUDIT"

	local max_n tmp
	max_n=$(dc_get client_diag retain_max 500)
	tmp=$(mktemp) || return 0
	tail -n "$max_n" "$DIAG_LEARN_AUDIT" > "$tmp" 2>/dev/null \
		&& mv -f "$tmp" "$DIAG_LEARN_AUDIT"
	chmod 644 "$DIAG_LEARN_AUDIT" 2>/dev/null
	return 0
}

# 记一条「都不通」的重试记录（轮数 +1）
_learn_retry_bump() {
	local d tmp now n
	d="$1"
	now=$(date +%s)

	n=0
	if [ -f "$DIAG_LEARN_RETRY" ]; then
		n=$(awk -F'|' -v x="$d" '$1 == x { print $2 + 0 }' "$DIAG_LEARN_RETRY" 2>/dev/null)
		case "$n" in ''|*[!0-9]*) n=0 ;; esac
	fi
	n=$((n + 1))

	tmp=$(mktemp) || return 0
	{
		[ -f "$DIAG_LEARN_RETRY" ] && awk -F'|' -v x="$d" '$1 != x' "$DIAG_LEARN_RETRY"
		printf '%s|%d|%d\n' "$d" "$n" "$now"
	} > "$tmp" && mv -f "$tmp" "$DIAG_LEARN_RETRY"
	chmod 644 "$DIAG_LEARN_RETRY" 2>/dev/null
	return 0
}

# 从重试队列里删掉某域名（学到之后）
_learn_retry_drop() {
	local d tmp
	d="$1"
	[ -f "$DIAG_LEARN_RETRY" ] || return 0
	tmp=$(mktemp) || return 0
	awk -F'|' -v x="$d" '$1 != x' "$DIAG_LEARN_RETRY" > "$tmp" 2>/dev/null \
		&& mv -f "$tmp" "$DIAG_LEARN_RETRY"
	return 0
}

# L4：实测后翻转归属
#
# 规则（清单原文，与 L1-L3 的「服务动作」性质不同）：
#   直连实测不通 + 代理实测通 → 从 dom_auto_domestic 删、写 dom_auto_foreign
#   其他（both-bad / 直连通） → 不写，只记审计
#
# 为什么只做「国内 → 国外」这一个方向：
#   反方向（国外 → 国内）是「学新域名」，由 cmd_learn 负责；
#   L4 处理的是「已经学成国内、但实测发现其实该走代理」的纠错。
#   两个方向都做会让 L4 与 cmd_learn 互相覆盖，来回翻转。
#
# ⚠️ 时间窗独立（learn_autofix_interval，默认 3600 秒）：
#    与 L1-L3 的 autofix_interval 分开计 —— L4 会改 UCI 并触发
#    分流重建，代价远高于清缓存，不能与 L1-L3 共用一个频率限制。
_learn_flip() {
	local d win last now tmo retries r_dom r_for ts

	d="$1"
	[ -n "$d" ] || return 1

	win=$(dc_get client_diag learn_autofix_interval 3600)
	case "$win" in ''|*[!0-9]*) win=3600 ;; esac
	last=$(cat "$DIAG_LEARN_L4" 2>/dev/null)
	case "$last" in ''|*[!0-9]*) last=0 ;; esac
	now=$(date +%s)
	[ $((now - last)) -ge "$win" ] || return 0

	tmo=$(dc_get client_diag learn_timeout 3)
	retries=$(dc_get client_diag learn_retries 3)

	r_dom=$(dc_probe_chain "$d" domestic "$tmo" "$retries")
	r_for=$(dc_probe_chain "$d" foreign "$tmo" "$retries")

	# 只处理「直连不通 + 代理通」
	case "$r_dom" in
		OK|EMPTY) 
			ts=$(date +%s)
			_learn_log "$ts" "$d" "-" "L4" "直连仍可达（${r_dom}），不翻转"
			return 0
			;;
	esac
	case "$r_for" in
		OK|EMPTY) ;;
		*)
			ts=$(date +%s)
			_learn_log "$ts" "$d" "-" "L4" "代理也不通（${r_for}），不翻转"
			return 0
			;;
	esac

	# 从自动国内列表删除，写进自动国外列表
	uci -q del_list "dnschain.dom_auto_domestic.domain=$d" 2>/dev/null
	uci -q del_list "dnschain.dom_auto_foreign.domain=$d" 2>/dev/null
	uci -q add_list "dnschain.dom_auto_foreign.domain=$d" 2>/dev/null || return 1
	uci -q commit dnschain 2>/dev/null

	date +%s > "$DIAG_LEARN_L4"

	ts=$(date +%s)
	_learn_log "$ts" "$d" "foreign" "L4" "直连 ${r_dom} 不通、代理 ${r_for} 通 → 翻转为国外"
	dnschain_log "自动补全 L4：$d 直连不通、代理通，归属已翻转为国外"
	return 0
}

# ------------------------------------------------------------
# learn：学习一轮
#
# 用法：learn [--dry-run] [--source manual|auto]
#
# 输出 KEY=VALUE（与 dnschain-selftest 一致），供页面与 Lua 解析：
#   CANDIDATES / LEARNED_DOMESTIC / LEARNED_FOREIGN / SKIPPED_BOTH_BAD
#   SKIPPED_BELOW_THRESHOLD / SKIPPED_COVERED / CIDR_V4 / CIDR_V6
#   HOOKED / DRY_RUN
#
# ⚠️ --dry-run 必须**完全不落盘**：不写 UCI、不写 learn-cidr.txt、
#    不动 nft。它只跑判定并报告「如果真跑会怎样」。
#    这是清单明确要求的「演练」语义，也是用户敢在页面上点的前提。
# ------------------------------------------------------------
cmd_learn() {
	local dry src batch max_dom budget t_start
	local n_cand n_dom n_for n_bad n_below n_covered n_invalid
	local dom verdict cnt i

	dry=0
	src="manual"
	while [ $# -gt 0 ]; do
		case "$1" in
			--dry-run) dry=1 ;;
			--source)  shift; src="${1:-manual}" ;;
			*) ;;
		esac
		shift
	done

	# 总开关（手动触发也要看它：用户关掉学习后按钮应无效）
	#
	# 但 --dry-run 不受限：演练不改任何东西，用户想先看看会学到什么
	# 是合理的，不该被开关挡住。
	if [ "$dry" != "1" ] && [ "$(dc_get client_diag learn_enabled 1)" != "1" ]; then
		printf 'ERROR=学习功能已关闭（learn_enabled=0）\n'
		return 1
	fi

	mkdir -p "$DNSCHAIN_STATE_DIR" 2>/dev/null
	mkdir -p "$DNSCHAIN_RUN_DIR" 2>/dev/null

	# ── 互斥（v0.24.0 实测必须）───────────────────────────────
	#
	# 实测：页面按钮超时（502）后用户重点，出现 6 个 learn 并发，
	# 每个都在做 DNS 探测。锁的存在把「并发叠加」变成「第二个直接退出」。
	#
	# 死锁清理：锁目录超过 10 分钟视为残留（一轮学习的最坏耗时约
	# 92 候选 × 24 秒 ≈ 37 分钟，但那已超过 _LEARN_BUDGET_SEC 预算，
	# 正常路径不会跑那么久；10 分钟足以区分「在跑」与「残留」）。
	if ! mkdir "$DIAG_LEARN_LOCK" 2>/dev/null; then
		local age
		age=$(( $(date +%s) - $(date -r "$DIAG_LEARN_LOCK" +%s 2>/dev/null || echo 0) ))
		if [ "$age" -gt 600 ]; then
			rmdir "$DIAG_LEARN_LOCK" 2>/dev/null
			mkdir "$DIAG_LEARN_LOCK" 2>/dev/null || {
				printf 'ERROR=学习锁被占用，稍后重试\n'
				return 1
			}
		else
			printf 'ERROR=已有一轮学习在跑（%s 秒前开始），请等它结束\n' "$age"
			return 1
		fi
	fi
	trap 'rmdir "$DIAG_LEARN_LOCK" 2>/dev/null' EXIT INT TERM

	# 运行状态：页面据此显示「进行中 / 已完成」
	printf 'RUNNING=1\nSTART=%s\nDRY=%s\n' "$(date +%s)" "$dry" > "$DIAG_LEARN_RUN"

	# 进度文件：页面轮询它显示「正在实测 12/92」
	#
	# ⚠️ 必须有（v0.24.0 实测踩过）：原来只在**全部结束时**才输出一次，
	#    于是页面在整个 8 分钟里只能显示「进行中」，日志文件 0 字节。
	#    用户无法区分「在跑」与「卡死」，只能反复点击 —— 这又反过来
	#    制造并发。进度要逐条落盘。
	printf 'TOTAL=0\nDONE=0\nCURRENT=\n' > "$DIAG_LEARN_PROGRESS"

	# 先把派生物刷新到最新：候选判定依赖 custom-*.txt 与 db-domains.txt
	dc_gen_db_domains >/dev/null 2>&1
	dc_gen_custom_lists >/dev/null 2>&1

	_learn_accumulate
	_learn_trim_counter

	n_cand=0
	n_dom=0
	n_for=0
	n_bad=0
	n_below=0
	n_covered=0
	n_invalid=0

	# 「低于阈值」与「已覆盖」的计数只能靠对比得出：
	# _learn_candidates 已经把两类都过滤掉了，故这里单独算。
	#
	# ⚠️ 必须单遍 awk（v0.24.0 实测）：原来是 `for dom in $all` 循环，
	#    每条域名 fork 两次 awk + 一次 grep，647 条就是约 1900 个进程。
	#    这是 _learn_candidates 之外的第二处同类瓶颈。
	local thr
	thr=$(dc_get client_diag learn_threshold 3)
	case "$thr" in ''|*[!0-9]*) thr=3 ;; esac

	if [ -f "$DIAG_LEARN_COUNTER" ]; then
		set -- $(awk -F'|' -v t="$thr" \
			-v db="$DNSCHAIN_DB_DOMAINS" \
			-v cd="$DNSCHAIN_CUSTOM_DOM" \
			-v cf="$DNSCHAIN_CUSTOM_FOR" '
			function load(path,    line) {
				while ((getline line < path) > 0) {
					gsub(/^[ \t]+|[ \t]+$/, "", line)
					if (line == "" || line ~ /^#/) continue
					known[line] = 1
				}
				close(path)
			}
			BEGIN { load(db); load(cd); load(cf) }
			{
				d = $1; n = $3 + 0
				if (d == "") next
				if (n > best[d]) best[d] = n
			}
			END {
				below = 0; covered = 0
				for (d in best) {
					if (best[d] < t) { below++; continue }
					if (d in known) { covered++; continue }
				}
				print below + 0, covered + 0
			}' "$DIAG_LEARN_COUNTER" 2>/dev/null)
		n_below="${1:-0}"
		n_covered="${2:-0}"
	fi

	batch=$(dc_get client_diag learn_batch 0)
	case "$batch" in ''|*[!0-9]*) batch=0 ;; esac

	max_dom=$(dc_get client_diag learn_max_domains 0)
	case "$max_dom" in ''|*[!0-9]*) max_dom=0 ;; esac

	dc_clock_ms
	t_start=$DC_CLOCK_MS

	# 候选逐个判定
	_learn_candidates > /tmp/.learn-cand.$$ 2>/dev/null
	n_cand=$(wc -l < /tmp/.learn-cand.$$ 2>/dev/null || echo 0)

	# 进度：总条数 + 当前正在实测的域名，逐条更新
	printf 'TOTAL=%s\nDONE=0\nCURRENT=\n' "$n_cand" > "$DIAG_LEARN_PROGRESS"
	n_done=0

	while read -r dom; do
		[ -n "$dom" ] || continue

		# 单轮上限（learn_batch，0 = 不限）
		if [ "$batch" -gt 0 ] 2>/dev/null && \
		   [ $((n_dom + n_for + n_bad)) -ge "$batch" ]; then
			break
		fi

		# 域名总量上限（learn_max_domains，0 = 不限）
		#
		# 判据是「现有自动条目 + 本轮已学」，不是计数器里的域名数 ——
		# 后者会把学不进去的域名也算进去，导致上限提前触发。
		if [ "$max_dom" -gt 0 ] 2>/dev/null; then
			local cur_auto
			cur_auto=$(dc_get_list dom_auto_domestic domain 2>/dev/null | wc -l)
			cur_auto=$((cur_auto + $(dc_get_list dom_auto_foreign domain 2>/dev/null | wc -l)))
			[ $((cur_auto + n_dom + n_for)) -ge "$max_dom" ] && break
		fi

		# 时间预算：超了留到下一轮（避免拖住 daemon 的日志消费）
		dc_clock_ms
		[ $((DC_CLOCK_MS - t_start)) -ge $((_LEARN_BUDGET_SEC * 1000)) ] && break

		# 进度：把「正在测谁」写出去，页面才能显示 12/92
		printf 'TOTAL=%s\nDONE=%s\nCURRENT=%s\n' \
			"$n_cand" "$n_done" "$dom" > "$DIAG_LEARN_PROGRESS"

		verdict=$(_learn_judge "$dom")
		n_done=$((n_done + 1))

		case "$verdict" in
			domestic)
				if [ "$dry" = "1" ]; then
					n_dom=$((n_dom + 1))
				else
					if _learn_write "$dom" domestic; then
						n_dom=$((n_dom + 1))
						_learn_retry_drop "$dom"
						_learn_log "$(date +%s)" "$dom" "domestic" "$src" \
							"直连可达、代理不可达或答案不同"
					fi
				fi
				;;
			foreign)
				if [ "$dry" = "1" ]; then
					n_for=$((n_for + 1))
				else
					if _learn_write "$dom" foreign; then
						n_for=$((n_for + 1))
						_learn_retry_drop "$dom"
						_learn_log "$(date +%s)" "$dom" "foreign" "$src" \
							"直连不可达、代理可达"
					fi
				fi
				;;
			both-bad)
				n_bad=$((n_bad + 1))
				[ "$dry" = "1" ] || _learn_retry_bump "$dom"
				;;
			invalid)
				n_invalid=$((n_invalid + 1))
				[ "$dry" = "1" ] || _learn_retry_bump "$dom"
				;;
			*)
				# both-ok-same：两条链都对且答案一致，不需要规则。
				# 不计入 any skipped 计数（它不是跳过，是「不需要」）。
				;;
		esac
	done < /tmp/.learn-cand.$$
	rm -f /tmp/.learn-cand.$$

	# ── IP 层：从已学国内域名派生 CIDR 并灌入集合 ──────────────
	#
	# 只在**真的学过**之后重建：dry-run 不碰，本轮一条没学到也不碰
	# （否则每轮都重新解析所有已学域名，白花几分钟）。
	#
	# ⚠️ 三步顺序不能换（v0.24.0 实测踩过）：
	#   ① dc_learn_hook        建集合 + 插挂钩
	#   ② dc_learn_derive_cidr 解析域名写 learn-cidr.txt
	#   ③ dc_learn_apply_cidr  把文件灌进集合
	#   原来写成 ②③①，首次运行时集合还不存在，apply_cidr 在
	#   `dc_learn_set_exists 4 || return 0` 处直接返回 ——
	#   结果是「TABLE=1 / HOOKED=1 / V4_COUNT=0 / CIDR_V4=53」：
	#   文件有 53 条、集合是空的、页面显示一切正常。
	#   这个组合只在**首次**学习时出现，第二轮起集合已存在就自愈了，
	#   故很容易被漏掉。
	if [ "$dry" != "1" ] && [ $((n_dom + n_for)) -gt 0 ]; then
		dc_learn_hook >/dev/null 2>&1
		dc_learn_derive_cidr >/dev/null 2>&1
		dc_learn_apply_cidr >/dev/null 2>&1
	fi

	# 学过之后必须重建分流片段，否则新规则要等下次收敛才生效
	if [ "$dry" != "1" ] && [ $((n_dom + n_for)) -gt 0 ]; then
		dc_gen_custom_lists >/dev/null 2>&1
		dc_gen_dnsmasq_split >/dev/null 2>&1
	fi

	printf 'CANDIDATES=%s\n' "$n_cand"
	printf 'LEARNED_DOMESTIC=%s\n' "$n_dom"
	printf 'LEARNED_FOREIGN=%s\n' "$n_for"
	printf 'SKIPPED_BOTH_BAD=%s\n' "$n_bad"
	printf 'SKIPPED_BELOW_THRESHOLD=%s\n' "$n_below"
	printf 'SKIPPED_COVERED=%s\n' "$n_covered"
	printf 'CIDR_V4=%s\n' "$(dc_count_lines '^4 ' "$DNSCHAIN_LEARN_CIDR")"
	printf 'CIDR_V6=%s\n' "$(dc_count_lines '^6 ' "$DNSCHAIN_LEARN_CIDR")"
	printf 'HOOKED=%s\n' "$(dc_learn_status | sed -n 's/^HOOKED=//p')"
	printf 'DRY_RUN=%s\n' "$dry"

	# 运行状态收尾：页面轮询它判断「跑完了没有」
	printf 'RUNNING=0\nSTART=0\nDRY=%s\nEND=%s\n' "$dry" "$(date +%s)" \
		> "$DIAG_LEARN_RUN"
	# 进度收尾：DONE 归位到总数，CURRENT 清空（页面据此显示 100%）
	printf 'TOTAL=%s\nDONE=%s\nCURRENT=\n' "$n_cand" "$n_done" \
		> "$DIAG_LEARN_PROGRESS"
	return 0
}

# learn-start：后台启动一轮学习，立即返回
#
# 为什么需要它（v0.24.0 实测踩过）：
#   一轮学习实测 68~152 秒，而 LuCI 按钮走 CGI，超时后浏览器报
#   **502 Bad Gateway**，可进程还在跑 —— 用户以为失败又点一次，
#   实测出现 6 个并发 learn 进程，把路由器与上游一起打满。
#
#   故按钮不再直接跑学习，而是调本子命令：fork 到后台后立刻返回，
#   页面显示「进行中」，用户再点「立即刷新」看结果。
#
# 用法：learn-start [--dry-run]
cmd_learn_start() {
	local dry_flag lock_busy age

	dry_flag=""
	[ "$1" = "--dry-run" ] && dry_flag="--dry-run"

	mkdir -p "$DNSCHAIN_STATE_DIR" 2>/dev/null

	# 先探锁：已有实例在跑就直接告诉用户，不再 fork
	if [ -d "$DIAG_LEARN_LOCK" ]; then
		age=$(( $(date +%s) - $(date -r "$DIAG_LEARN_LOCK" +%s 2>/dev/null || echo 0) ))
		if [ "$age" -le 600 ]; then
			printf 'BUSY=1\nAGE=%s\n' "$age"
			return 0
		fi
		rmdir "$DIAG_LEARN_LOCK" 2>/dev/null
	fi

	# 后台执行，输出落到 learn-run.log 供页面读
	#
	# ⚠️ 必须 setsid + 三重重定向（v0.24.0 实测踩过）：
	#   1. LuCI 的 sys.exec 走 `sh -c`，它退出时会给**同进程组**发信号；
	#      普通 `( ... ) &` 起的子进程仍在同一进程组 → 被连带杀掉，
	#      日志文件 0 字节，而锁目录还在 → 页面永远显示「进行中」。
	#   2. stdin/stdout/stderr 都必须重定向，否则子进程继承 CGI 的
	#      管道，管道关闭后子进程写 stdout 会 SIGPIPE 退出。
	#   setsid 让子进程进入独立会话，脱离 CGI 的进程组与终端。
	#
	# BusyBox 的 setsid 不一定可用，故带回落：没有 setsid 时用
	# nohup + 完整重定向，仍然脱离终端（只是不换进程组）。
	#
	# ⚠️ 不能在 `setsid ... &` 之后用 `$!` 取 PID（v0.24.0 实测踩过）：
	#    BusyBox ash 在这种「外部命令 + 重定向 + &」的组合下 $! 为空，
	#    于是 printf 只输出 `STARTED=1\nPID=`，而 Lua 侧判 STARTED
	#    为 "1" 之前先被空 PID 干扰 —— 实测页面显示「✗ 启动失败：」，
	#    但学习确实已经在跑（状态行正确显示「进行中」）。
	#    故不再输出 PID：这个值页面上没人用，输出一个可能为空的值
	#    只会制造「看起来失败」的假象。
	if command -v setsid >/dev/null 2>&1; then
		setsid /usr/bin/dnschain-client-diag learn --source manual $dry_flag \
			> "${DNSCHAIN_STATE_DIR}/learn-run.log" 2>&1 \
			< /dev/null &
	else
		nohup /usr/bin/dnschain-client-diag learn --source manual $dry_flag \
			> "${DNSCHAIN_STATE_DIR}/learn-run.log" 2>&1 \
			< /dev/null &
	fi

	# 等 1 秒再确认：进程若立刻退出（例如总开关关闭），
	# 用户应当当场看到原因，而不是等一轮周期后发现什么都没发生。
	sleep 1
	if [ -d "$DIAG_LEARN_LOCK" ]; then
		printf 'STARTED=1\n'
		return 0
	fi

	# 锁没建起来 = 进程已退出。把日志里的 ERROR 带出来。
	if [ -s "${DNSCHAIN_STATE_DIR}/learn-run.log" ]; then
		printf 'STARTED=0\n'
		printf 'REASON=%s\n' "$(grep -m1 'ERROR=' "${DNSCHAIN_STATE_DIR}/learn-run.log" 2>/dev/null)"
		return 0
	fi

	printf 'STARTED=0\nREASON=进程启动后立即退出（无输出）\n'
	return 0
}

# learn-run-state：学习是否在进行中（页面轮询用）
cmd_learn_run_state() {
	local running start dry end last

	running=0
	if [ -d "$DIAG_LEARN_LOCK" ]; then
		running=1
	fi

	start=0; dry=0; end=0
	if [ -f "$DIAG_LEARN_RUN" ]; then
		start=$(sed -n 's/^START=//p' "$DIAG_LEARN_RUN" 2>/dev/null | head -1)
		dry=$(sed -n 's/^DRY=//p' "$DIAG_LEARN_RUN" 2>/dev/null | head -1)
		end=$(sed -n 's/^END=//p' "$DIAG_LEARN_RUN" 2>/dev/null | head -1)
	fi
	case "$start" in ''|*[!0-9]*) start=0 ;; esac
	case "$dry" in ''|*[!0-9]*) dry=0 ;; esac
	case "$end" in ''|*[!0-9]*) end=0 ;; esac

	printf 'RUNNING=%s\n' "$running"
	printf 'START=%s\n' "$start"
	printf 'DRY=%s\n' "$dry"
	printf 'END=%s\n' "$end"

	# 上一轮结果：优先读日志里的 KEY=VALUE；日志缺失时回落进度文件。
	#
	# 两条路径必须都能给出「学到几条」：
	#   · 页面按钮 → learn-start → 日志有完整输出
	#   · 命令行直接跑 learn → 日志不存在，但进度文件有 TOTAL/DONE
	# 原来只读日志，命令行跑完后页面显示「候选 0，学到直连 0」，
	# 与实际刚学的 60 条矛盾 —— 用户会以为功能没生效。
	local last n_cand n_done
	last=""
	if [ -f "${DNSCHAIN_STATE_DIR}/learn-run.log" ]; then
		last=$(tail -n 20 "${DNSCHAIN_STATE_DIR}/learn-run.log" 2>/dev/null \
			| grep -E '^(CANDIDATES|LEARNED_DOMESTIC|LEARNED_FOREIGN|SKIPPED_BOTH_BAD|ERROR)=' \
			| tr '\n' ' ')
	fi

	n_cand=0
	n_done=0
	if [ -f "$DIAG_LEARN_PROGRESS" ]; then
		n_cand=$(sed -n 's/^TOTAL=//p' "$DIAG_LEARN_PROGRESS" 2>/dev/null | head -1)
		n_done=$(sed -n 's/^DONE=//p' "$DIAG_LEARN_PROGRESS" 2>/dev/null | head -1)
	fi
	case "$n_cand" in ''|*[!0-9]*) n_cand=0 ;; esac
	case "$n_done" in ''|*[!0-9]*) n_done=0 ;; esac

	# 日志缺失但有进度 → 用「候选 N / 已判定 M」表达，不假装是 0
	if [ -z "$last" ] && [ "$n_cand" -gt 0 ]; then
		last="CANDIDATES=${n_cand} DONE=${n_done}"
	fi
	printf 'LAST=%s\n' "$last"

	# 进度：TOTAL / DONE / CURRENT
	if [ -f "$DIAG_LEARN_PROGRESS" ]; then
		printf '%s\n' "$(sed -n 's/^TOTAL=/PROGRESS_TOTAL=/p' "$DIAG_LEARN_PROGRESS" 2>/dev/null | head -1)"
		printf '%s\n' "$(sed -n 's/^DONE=/PROGRESS_DONE=/p' "$DIAG_LEARN_PROGRESS" 2>/dev/null | head -1)"
		printf '%s\n' "$(sed -n 's/^CURRENT=/PROGRESS_CURRENT=/p' "$DIAG_LEARN_PROGRESS" 2>/dev/null | head -1)"
	else
		printf 'PROGRESS_TOTAL=0\nPROGRESS_DONE=0\nPROGRESS_CURRENT=\n'
	fi
	return 0
}

# learn-status：学习层状态（KEY=VALUE，直接透传 dc_learn_status）
cmd_learn_status() {
	dc_learn_status
	printf 'ENABLED=%s\n' "$(dc_get client_diag learn_enabled 1)"
	printf 'INTERVAL=%s\n' "$(dc_get client_diag learn_interval 1800)"
	printf 'THRESHOLD=%s\n' "$(dc_get client_diag learn_threshold 5)"
	printf 'BATCH=%s\n' "$(dc_get client_diag learn_batch 60)"
	printf 'RETAIN_DAYS=%s\n' "$(dc_get client_diag learn_retain_days 30)"
	printf 'TIMEOUT=%s\n' "$(dc_get client_diag learn_timeout 3)"
	printf 'RETRIES=%s\n' "$(dc_get client_diag learn_retries 3)"
	printf 'MAX_DOMAINS=%s\n' "$(dc_get client_diag learn_max_domains 0)"
	printf 'MAX_CIDR=%s\n' "$(dc_get client_diag learn_max_cidr 0)"
	printf 'AUTOFIX_THRESHOLD=%s\n' "$(dc_get client_diag learn_autofix_threshold 5)"
	printf 'AUTOFIX_INTERVAL=%s\n' "$(dc_get client_diag learn_autofix_interval 3600)"
	printf 'AUTO_DOMESTIC=%s\n' "$(dc_get_list dom_auto_domestic domain 2>/dev/null | wc -l)"
	printf 'AUTO_FOREIGN=%s\n' "$(dc_get_list dom_auto_foreign domain 2>/dev/null | wc -l)"
	# ⚠️ 不能写 `wc -l < "$file" 2>/dev/null`：输入重定向由 **shell** 处理，
	#    文件不存在时错误发生在命令执行之前，`2>/dev/null` 挂不到它上面 ——
	#    实测报 "can't open /var/run/dnschain/learn-retry.txt: no such file"
	#    并污染 KEY=VALUE 输出。必须先判文件存在。
	local rp=0
	[ -f "$DIAG_LEARN_RETRY" ] && rp=$(wc -l < "$DIAG_LEARN_RETRY" 2>/dev/null)
	case "$rp" in ''|*[!0-9]*) rp=0 ;; esac
	printf 'RETRY_PENDING=%s\n' "$rp"
	return 0
}

# learn-clear：清空学习层
#
#   learn-clear counter  只清计数器 + 游标（保留已学规则，重新开始计数）
#   learn-clear rules    清 dom_auto_* + learn-cidr.txt + 集合 + 计数器 + 游标
#   learn-clear all      同 rules（页面用这个）
cmd_learn_clear() {
	local what
	what="${1:-all}"

	case "$what" in
		counter|rules|all) ;;
		*) echo "ERROR=参数必须是 counter / rules / all"; return 1 ;;
	esac

	# 计数器与游标：两种模式都清
	rm -f "$DIAG_LEARN_COUNTER" "$DIAG_LEARN_CURSOR" "$DIAG_LEARN_RETRY" 2>/dev/null

	if [ "$what" = "counter" ]; then
		echo "OK=计数器与游标已清空（已学规则保留）"
		return 0
	fi

	dc_learn_clear rules || { echo "ERROR=清空已学规则失败"; return 1; }
	echo "OK=已清空全部学习结果（规则 + IP 段 + 计数器）"
	return 0
}

# ------------------------------------------------------------
# scan：扫一轮
# ------------------------------------------------------------
cmd_scan() {
	local ts line ip dom up st cnt need healed

	# 互斥：daemon 与手动触发不能并发（同 dc_health_cycle 的教训）
	if ! mkdir "$DIAG_LOCK" 2>/dev/null; then
		# 死锁自动清理：锁目录超过 5 分钟视为残留
		if [ -d "$DIAG_LOCK" ]; then
			local age
			age=$(( $(date +%s) - $(date -r "$DIAG_LOCK" +%s 2>/dev/null || echo 0) ))
			if [ "$age" -gt 300 ]; then
				rmdir "$DIAG_LOCK" 2>/dev/null
				mkdir "$DIAG_LOCK" 2>/dev/null || return 0
			else
				return 0
			fi
		else
			return 0
		fi
	fi

	trap 'rmdir "$DIAG_LOCK" 2>/dev/null' EXIT INT TERM

	[ "$(dc_get client_diag enabled 1)" = "1" ] || return 0

	ts=$(date +%s)
	mkdir -p "$DNSCHAIN_STATE_DIR" 2>/dev/null

	# 只扫上次扫描之后的日志（避免重复记录）
	#
	# ⚠️ logread 没有「since」参数，用时间戳比对。
	#    取最近 2000 行足够覆盖一轮（实测一轮查询量级）。
	logread 2>/dev/null | tail -n 2000 | _diag_parse > /tmp/.diag-parse.$$ 2>/dev/null

	# 同一域名只要本轮有**任意一次成功**，就不记失败
	#
	# ⚠️ 这条是必须的，实测踩过：api.deepseek.com 在日志里有 4 个查询 ID，
	#    其中 ID 250633 完整成功（返回 4 个 A 记录），但另一个 ID 因
	#    **日志滑动窗口截断**只有 forwarded 没有 reply。若按「每条查询
	#    独立判定」，那个截断的 ID 会把域名记成 noreply 失败 ——
	#    而实际上该域名解析完全正常。
	#
	#    判据应该是「这个域名这一轮到底通不通」，不是「每个查询 ID 通不通」。
	awk -F'|' '$4 == "ok" { print $2 }' /tmp/.diag-parse.$$ | sort -u > /tmp/.diag-ok.$$

	# 逐条判定，达阈值的域名触发自愈（每个域名一轮只触发一次）
	: > /tmp/.diag-healed.$$
	while IFS='|' read -r ip dom up st ans; do
		[ -n "$ip" ] || continue
		[ -n "$dom" ] || continue
		_diag_is_fail "$st" || continue

		# 本轮该域名有成功记录 → 不记失败
		grep -qxF "$dom" /tmp/.diag-ok.$$ 2>/dev/null && continue

		_diag_record_fail "$ts" "$ip" "$dom" "$up" "$st"

		# 阈值判定
		cnt=$(_diag_fail_count "$dom")
		need=$(dc_get client_diag fail_threshold 3)
		if [ "$cnt" -ge "$need" ]; then
			# 同一轮内同一域名只自愈一次
			grep -qxF "$dom" /tmp/.diag-healed.$$ 2>/dev/null && continue
			echo "$dom" >> /tmp/.diag-healed.$$
			if [ "$(dc_get client_diag autofix_enabled 1)" = "1" ]; then
				_diag_autofix "$dom"
			fi
		fi
	done < /tmp/.diag-parse.$$

	rm -f /tmp/.diag-parse.$$ /tmp/.diag-healed.$$ /tmp/.diag-ok.$$
	_diag_trim
	echo "$ts" > "$DIAG_LAST_SCAN"
	return 0
}

# ------------------------------------------------------------
# list：客户机列表（TSV）
#
# 输出：<IP>|<主机名>|<失败数>|<最近失败时刻>|<最近域名>
# 按失败数降序（有问题的排前面）
# ------------------------------------------------------------
cmd_list() {
	local win now cutoff
	win=$(dc_get client_diag retain_sec 3600)
	now=$(date +%s)
	cutoff=$((now - win))

	# ⚠️ 不能因「失败表不存在」就整体返回 —— 流水表可能有大量成功查询。
	#    实测踩过：只判 DIAG_FAIL_LOG 时，没有任何失败记录的客户机
	#    在列表里完全不出现，用户以为「这台设备没上网」。
	[ -f "$DIAG_FAIL_LOG" ] || [ -f "$DIAG_FLOW_LOG" ] || return 0

	# 失败统计（来自失败表）
	local ftmp
	ftmp=$(mktemp) || return 1
	awk -F'|' -v c="$cutoff" '
		$1 >= c {
			n[$2]++
			if ($1 > last[$2]) { last[$2] = $1; dom[$2] = $3 }
		}
		END { for (ip in n) printf "%s\t%d\t%d\t%s\n", ip, n[ip], last[ip], dom[ip] }
	' "$DIAG_FAIL_LOG" > "$ftmp" 2>/dev/null

	# 总查询数（来自流水表）—— 用户要看「这台设备一共查了多少」
	local qtmp
	qtmp=$(mktemp) || { rm -f "$ftmp"; return 1; }
	local fwin
	fwin=$(dc_get client_diag flow_retain_sec 600)
	local fcutoff
	fcutoff=$((now - fwin))
	[ -f "$DIAG_FLOW_LOG" ] && awk -F'|' -v c="$fcutoff" '$1 >= c { q[$2]++ } END { for (ip in q) print ip "\t" q[ip] }' "$DIAG_FLOW_LOG" > "$qtmp" 2>/dev/null

	# 合并：以流水里的客户机为主体（有查询就列出），失败数可能为 0
	{
		cut -f1 "$qtmp" 2>/dev/null
		cut -f1 "$ftmp" 2>/dev/null
	} | sort -u | while read -r ip; do
		[ -n "$ip" ] || continue
		local fc lc dc qc
		fc=$(awk -F'	' -v i="$ip" '$1 == i { print $2 }' "$ftmp" 2>/dev/null)
		lc=$(awk -F'	' -v i="$ip" '$1 == i { print $3 }' "$ftmp" 2>/dev/null)
		dc=$(awk -F'	' -v i="$ip" '$1 == i { print $4 }' "$ftmp" 2>/dev/null)
		qc=$(awk -F'	' -v i="$ip" '$1 == i { print $2 }' "$qtmp" 2>/dev/null)
		[ -n "$fc" ] || fc=0
		[ -n "$lc" ] || lc=0
		[ -n "$qc" ] || qc=0
		local host
		host=$(awk -v i="$ip" '$3 == i { print $4; exit }' /tmp/dhcp.leases 2>/dev/null)
		[ -n "$host" ] || host="*"
		printf '%s|%s|%s|%s|%s|%s\n' "$ip" "$host" "$fc" "$lc" "${dc:--}" "$qc"
	done | sort -t'|' -k3,3rn

	rm -f "$ftmp" "$qtmp"
}

# ------------------------------------------------------------
# detail：某客户机的失败时间线（TSV）
#
# 输出：<epoch>|<域名>|<上游>|<状态>|<段>|<建议动作>
# ------------------------------------------------------------
cmd_detail() {
	local ip win now cutoff
	ip="$1"
	[ -n "$ip" ] || return 1

	win=$(dc_get client_diag retain_sec 3600)
	now=$(date +%s)
	cutoff=$((now - win))

	[ -f "$DIAG_FAIL_LOG" ] || return 0

	awk -F'|' -v i="$ip" -v c="$cutoff" \
		'$2 == i && $1 >= c { print $1 "|" $3 "|" $4 "|" $5 "|" $6 }' "$DIAG_FAIL_LOG" \
		| sort -t'|' -k1,1rn | while IFS='|' read -r ts dom up st seg; do
			# 建议动作：段 2/3 都是上游问题，建议重试或改走另一条链
			local hint
			case "$seg" in
				2) hint="upstream-no-reply" ;;
				3) hint="upstream-fail" ;;
				*) hint="unknown" ;;
			esac
			printf '%s|%s|%s|%s|%s|%s\n' "$ts" "$dom" "$up" "$st" "$seg" "$hint"
		done
}

# ------------------------------------------------------------
# flow：某客户机的**完整查询链路**（含成功）
#
# 输出：<epoch>|<域名>|<上游>|<状态>|<段>|<答案>
#
# 这是用户要的「客户机发起的查询完整链路」—— 与 detail 的区别：
#   detail  只有失败，用于排障
#   flow    全部查询，用于「这台设备刚才在干什么」
# ------------------------------------------------------------
cmd_flow() {
	local ip limit win now cutoff
	ip="$1"
	limit="$2"

	# ⚠️ 兼容两种调用形态：
	#   flow <IP> <N>   —— 指定客户机
	#   flow <N>        —— 只给条数（Lua 侧 IP 为空时就是这个形态）
	# 不兼容时 `flow 200` 会把 200 当成 IP，结果零输出 ——
	# 实测踩过：页面「实时查询链路」一直空白，而脚本手动跑正常。
	case "$ip" in
		''|*[!0-9]*) ;;          # 非纯数字 → 当 IP 用
		*)
			# 纯数字：它是条数，不是 IP
			if [ -n "$ip" ]; then
				limit="$ip"
				ip=""
			fi
			;;
	esac

	win=$(dc_get client_diag flow_retain_sec 600)
	now=$(date +%s)
	cutoff=$((now - win))
	case "$limit" in ''|*[!0-9]*) limit=200 ;; esac

	[ -f "$DIAG_FLOW_LOG" ] || return 0

	# 按 IP 过滤（空 IP = 全部客户机）
	# 输出带客户机 IP：<epoch>|<客户机>|<域名>|<上游>|<状态>|<段>|<答案>
	#
	# ⚠️ 不能用 `sort -t'|' -k1,1rn` 排序 —— 实测 BusyBox 的 sort
	#    对 `-t` + `-k1,1rn` 组合**忽略 -r**，输出是升序：
	#      printf "3|a\n1|b\n2|c\n" | sort -t'|' -k1,1rn
	#      → 1|b  2|c  3|a        （要降序，却给了升序）
	#    而纯 `sort -rn`（不带 -t/-k）才正常。
	#
	#    后果：页面「实时查询链路」永远显示**最旧的 200 条**，
	#    用户看到的时间戳停在几分钟前，以为自动刷新失效。
	#
	#    改用 awk 在内存里排序（每轮最多几千行，N2930 无压力）。
	if [ -n "$ip" ]; then
		awk -F'|' -v i="$ip" -v c="$cutoff" -v lim="$limit" '
			$2 == i && $1 >= c { n++; line[n] = $1 "|" $2 "|" $3 "|" $4 "|" $5 "|" $6 "|" $7; key[n] = $1 + 0 }
			END {
				# 插入排序（n 通常 < 2000，足够快）
				for (a = 2; a <= n; a++) {
					l = line[a]; k = key[a]; b = a - 1
					while (b >= 1 && key[b] < k) { line[b+1] = line[b]; key[b+1] = key[b]; b-- }
					line[b+1] = l; key[b+1] = k
				}
				m = (n < lim) ? n : lim
				for (a = 1; a <= m; a++) print line[a]
			}' "$DIAG_FLOW_LOG"
	else
		awk -F'|' -v c="$cutoff" -v lim="$limit" '
			$1 >= c { n++; line[n] = $1 "|" $2 "|" $3 "|" $4 "|" $5 "|" $6 "|" $7; key[n] = $1 + 0 }
			END {
				for (a = 2; a <= n; a++) {
					l = line[a]; k = key[a]; b = a - 1
					while (b >= 1 && key[b] < k) { line[b+1] = line[b]; key[b+1] = key[b]; b-- }
					line[b+1] = l; key[b+1] = k
				}
				m = (n < lim) ? n : lim
				for (a = 1; a <= m; a++) print line[a]
			}' "$DIAG_FLOW_LOG"
	fi
}

# ------------------------------------------------------------
# probe：主动探测「DNS 通了但 TCP 不通」的域名（第 ④ 段）
#
# 这是 ADR-0009 二期才计划的能力，但用户实测遇到了具体案例：
#   cc.sefan.pw        DNS 正常 → 主域名能开
#   cdn.sofan.one:65533  DNS 正常 → TCP 被墙 → 页面白屏
#
# 光看 DNS 日志永远发现不了这类问题：所有查询都返回 ok。
# 必须**主动连一次**目标 IP 的端口才能区分「通」和「被墙」。
#
# 输出：<域名>|<IP>|<端口>|<状态>|<耗时ms>
#   状态：ok / timeout / refused / dnsfail
# ------------------------------------------------------------
cmd_probe() {
	local dom port tmo ips ip st t0 t1 ms
	dom="$1"
	port="${2:-443}"
	tmo="${3:-3}"

	case "$port" in ''|*[!0-9]*) port=443 ;; esac
	case "$tmo" in ''|*[!0-9]*) tmo=3 ;; esac

	[ -n "$dom" ] || return 1

	# 解析（经本机 dnsmasq，走真实分流路径）
	ips=$(nslookup "$dom" 127.0.0.1 2>/dev/null | \
		awk '/^Address: / { print $2 }' | grep -v '^127\.' | head -4)

	if [ -z "$ips" ]; then
		printf '%s|-|%s|dnsfail|0\n' "$dom" "$port"
		return 1
	fi

	# 逐个 IP 试连（任一通即算通）
	#
	# ⚠️ 探测方式经过实测筛选，三种「看起来能用」的都不行：
	#
	#   nc -z -w N <ip> <port>   本机 BusyBox nc 只支持 `nc [IPADDR PORT]`，
	#                            没有 -z/-w，传了参数直接报 Usage 并返回 1
	#                            → 所有域名都被误判成 timeout（实测踩过：
	#                            cc.sefan.pw 明明 200，却报 timeout）
	#   /dev/tcp/<ip>/<port>     ash 未编译该特性，重定向失败 rc=1
	#   wget --spider            需要 Host/SNI，裸 IP 探测失败 rc=4
	#
	#   唯一可靠：`nc <ip> <port> </dev/null` 裸连，外面套 `timeout`。
	#   rc=0 说明 TCP 握手成功（不看应用层）。
	for ip in $ips; do
		t0=$(date +%s)
		if timeout "$tmo" sh -c "nc $ip $port </dev/null >/dev/null 2>&1"; then
			st="ok"
		else
			# 区分不了 refused 与 timeout（BusyBox nc 不返回细因），
			# 但对诊断够用：两者都意味着「这个 CDN 用不了」。
			st="timeout"
		fi
		t1=$(date +%s)
		ms=$(( (t1 - t0) * 1000 ))

		printf '%s|%s|%s|%s|%s\n' "$dom" "$ip" "$port" "$st" "$ms"

		# 一个通就够了
		[ "$st" = "ok" ] && return 0
	done

	return 1
}

# ------------------------------------------------------------
# cdncheck：扫描某个客户机最近访问过的域名，找出「DNS 通但 TCP 不通」的
#
# 输出：<域名>|<IP>|<端口>|<状态>
#
# 用法：cdncheck [IP] [条数]
#   不带 IP = 扫全部客户机最近访问的域名
# ------------------------------------------------------------
cmd_cdncheck() {
	local ip limit win now cutoff doms
	ip="$1"
	limit="${2:-30}"

	case "$limit" in ''|*[!0-9]*) limit=30 ;; esac
	[ "$limit" -gt 100 ] 2>/dev/null && limit=100

	win=$(dc_get client_diag flow_retain_sec 600)
	now=$(date +%s)
	cutoff=$((now - win))

	[ -f "$DIAG_FLOW_LOG" ] || return 0

	# 取最近访问过的、**解析成功**的域名（ok 或 nodata 都说明 DNS 层通了）
	# 去重后取前 N 个
	if [ -n "$ip" ]; then
		doms=$(awk -F'|' -v i="$ip" -v c="$cutoff" \
			'$2 == i && $1 >= c && ($5 == "ok" || $5 == "nodata") { print $3 }' \
			"$DIAG_FLOW_LOG" | awk '!seen[$0]++' | head -n "$limit")
	else
		doms=$(awk -F'|' -v c="$cutoff" \
			'$1 >= c && ($5 == "ok" || $5 == "nodata") { print $3 }' \
			"$DIAG_FLOW_LOG" | awk '!seen[$0]++' | head -n "$limit")
	fi

	[ -n "$doms" ] || return 0

	# 逐个探测（限速：每个 2 秒超时，最多 30 个 → 最坏 60 秒）
	local d
	for d in $doms; do
		cmd_probe "$d" 443 2
	done
}

# ------------------------------------------------------------
# hosts：在线主机（第一级）
#
# 输出：<IP>|<主机名>|<MAC>|<查询数>|<失败数>|<最近活动>|<最近域名>
#
# 与 list 的区别：hosts 以**当前在线**为准（来自 ARP 邻居表 +
# DHCP 租约），而不是「保留期内有记录」。用户要的是「当前在线主机」。
# ------------------------------------------------------------
cmd_hosts() {
	local win now cutoff qtmp ftmp atmp
	win=$(dc_get client_diag flow_retain_sec 600)
	now=$(date +%s)
	cutoff=$((now - win))

	qtmp=$(mktemp); ftmp=$(mktemp); atmp=$(mktemp)

	# 查询数（流水表）
	[ -f "$DIAG_FLOW_LOG" ] && awk -F'|' -v c="$cutoff" \
		'$1 >= c { q[$2]++; if ($1 > last[$2]) { last[$2] = $1; dom[$2] = $3 } }
		 END { for (ip in q) printf "%s\t%d\t%d\t%s\n", ip, q[ip], last[ip], dom[ip] }' \
		"$DIAG_FLOW_LOG" > "$qtmp" 2>/dev/null

	# 失败数（失败表）
	[ -f "$DIAG_FAIL_LOG" ] && awk -F'|' -v c="$cutoff" \
		'$1 >= c { f[$2]++ } END { for (ip in f) printf "%s\t%d\n", ip, f[ip] }' \
		"$DIAG_FAIL_LOG" > "$ftmp" 2>/dev/null

	# 在线主机：ARP 邻居表里 REACHABLE/STALE/DELAY 的 IPv4
	ip neigh show 2>/dev/null | awk '
		/lladdr/ && $1 ~ /^[0-9]+\./ {
			mac = ""
			for (i = 1; i <= NF; i++) if ($i == "lladdr") mac = $(i + 1)
			st = $NF
			if (st == "REACHABLE" || st == "STALE" || st == "DELAY" || st == "PROBE")
				printf "%s\t%s\n", $1, mac
		}' > "$atmp" 2>/dev/null

	# 合并：以「在线」为主体，附上查询/失败统计
	# 同时把「有查询记录但当前 ARP 不在」的主机也列出（标 offline）
	{
		cut -f1 "$atmp" 2>/dev/null
		cut -f1 "$qtmp" 2>/dev/null
	} | sort -u | while read -r ip; do
		[ -n "$ip" ] || continue

		local mac online qn fn lt dom host
		mac=$(awk -F'	' -v i="$ip" '$1 == i { print $2; exit }' "$atmp" 2>/dev/null)
		online=1
		[ -n "$mac" ] || { online=0; mac=""; }

		qn=$(awk -F'	' -v i="$ip" '$1 == i { print $2; exit }' "$qtmp" 2>/dev/null)
		fn=$(awk -F'	' -v i="$ip" '$1 == i { print $2; exit }' "$ftmp" 2>/dev/null)
		lt=$(awk -F'	' -v i="$ip" '$1 == i { print $3; exit }' "$qtmp" 2>/dev/null)
		dom=$(awk -F'	' -v i="$ip" '$1 == i { print $4; exit }' "$qtmp" 2>/dev/null)
		[ -n "$qn" ] || qn=0
		[ -n "$fn" ] || fn=0
		[ -n "$lt" ] || lt=0

		# ⚠️ 只列在线主机 —— 用户明确要求「表中排除掉离线设备」。
		#
		#    判据是 ARP 邻居表里有 lladdr（REACHABLE/STALE/DELAY/PROBE）。
		#    只有历史查询记录、当前 ARP 里没有的，视为已离线，直接跳过。
		#
		#    为什么不用「最近活动时间」判定：DHCP 租约长（12h），
		#    设备关掉后查询记录还会留很久，按时间判会把关机设备列成在线。
		[ "$online" = "1" ] || continue

		# 主机名：先查 DHCP 租约，再查 ARP 反解
		host=$(awk -v i="$ip" '$3 == i { print $4; exit }' /tmp/dhcp.leases 2>/dev/null)
		[ -n "$host" ] && [ "$host" != "*" ] || host=""

		printf '%s|%s|%s|%s|%s|%s|%s|%s\n' \
			"$ip" "$host" "$mac" "$qn" "$fn" "$lt" "${dom:--}" "$online"
	done | sort -t'|' -k5,5rn -k4,4rn

	rm -f "$qtmp" "$ftmp" "$atmp"
}

# ------------------------------------------------------------
# trace：单个域名的完整链路（第二级「打开主域名后跳转到哪里」）
#
# 输出：<字段>|<值> 形式，供页面逐项展示
#
# 把一条查询的完整过程摊开：
#   客户机 → dnsmasq → 上游实例 → 答案 → 归属判定 → 最终去向
# ------------------------------------------------------------
cmd_trace() {
	local ip dom win now cutoff
	ip="$1"
	dom="$2"
	[ -n "$dom" ] || { echo "ERROR=缺少域名"; return 1; }

	win=$(dc_get client_diag flow_retain_sec 600)
	now=$(date +%s)
	cutoff=$((now - win))

	[ -f "$DIAG_FLOW_LOG" ] || { echo "ERROR=没有查询流水"; return 1; }

	# 该域名在保留期内的所有记录（按 IP 过滤可选）
	local rows
	if [ -n "$ip" ]; then
		rows=$(awk -F'|' -v i="$ip" -v d="$dom" -v c="$cutoff" \
			'$2 == i && $3 == d && $1 >= c' "$DIAG_FLOW_LOG")
	else
		rows=$(awk -F'|' -v d="$dom" -v c="$cutoff" '$3 == d && $1 >= c' "$DIAG_FLOW_LOG")
	fi

	[ -n "$rows" ] || { echo "ERROR=保留期内没有该域名的查询记录"; return 1; }

	# 汇总：次数、成功/失败、上游、首末时间
	printf '%s\n' "$rows" | awk -F'|' '
		{
			n++
			if ($1 < first || first == 0) first = $1
			if ($1 > last) last = $1
			st[$5]++
			if ($4 != "") up[$4]++
			if ($5 == "ok") { ok++; ans = $7 }
		}
		END {
			printf "COUNT|%d\n", n
			printf "FIRST|%d\n", first
			printf "LAST|%d\n", last
			printf "OK|%d\n", ok + 0
			printf "ANSWER|%s\n", ans
			for (u in up) printf "UPSTREAM|%s|%d\n", u, up[u]
			for (s in st) printf "STATE|%s|%d\n", s, st[s]
		}'

	# 归属判定（复用现有 explain）
	local cls pref
	cls=$(/usr/bin/dnschain-selftest explain "$dom" 2>/dev/null | sed -n 's/^CLASS=//p')
	pref=$(/usr/bin/dnschain-selftest explain "$dom" 2>/dev/null | sed -n 's/^PREFERRED=//p')
	[ -n "$cls" ] && printf 'CLASS|%s\n' "$cls"
	[ -n "$pref" ] && printf 'PREFERRED|%s\n' "$pref"
}

# ------------------------------------------------------------
# search：按域名/关键词搜索（用户要求「搜索框功能」）
#
# 输出：<epoch>|<客户机>|<域名>|<上游>|<状态>|<段>|<答案>
# 参数：<关键词> [IP] [条数]
# ------------------------------------------------------------
cmd_search() {
	local kw ip limit win now cutoff
	kw="$1"
	ip="$2"
	limit="$3"
	[ -n "$kw" ] || return 0

	win=$(dc_get client_diag flow_retain_sec 600)
	now=$(date +%s)
	cutoff=$((now - win))
	case "$limit" in ''|*[!0-9]*) limit=200 ;; esac

	[ -f "$DIAG_FLOW_LOG" ] || return 0

	# 关键词匹配域名（不区分大小写），可选按 IP 收窄
	awk -F'|' -v k="$kw" -v i="$ip" -v c="$cutoff" -v lim="$limit" '
		{
			if ($1 < c) next
			if (i != "" && $2 != i) next
			# 不区分大小写子串匹配
			if (index(tolower($3), tolower(k)) == 0) next
			n++
			line[n] = $1 "|" $2 "|" $3 "|" $4 "|" $5 "|" $6 "|" $7
			key[n] = $1 + 0
		}
		END {
			for (a = 2; a <= n; a++) {
				l = line[a]; kk = key[a]; b = a - 1
				while (b >= 1 && key[b] < kk) { line[b+1] = line[b]; key[b+1] = key[b]; b-- }
				line[b+1] = l; key[b+1] = kk
			}
			m = (n < lim) ? n : lim
			for (a = 1; a <= m; a++) print line[a]
		}' "$DIAG_FLOW_LOG"
}

# ------------------------------------------------------------
# autofix-log / undo
# ------------------------------------------------------------
cmd_autofix_log() {
	[ -f "$DIAG_FIX_LOG" ] || return 0
	tail -n 100 "$DIAG_FIX_LOG"
}

cmd_undo() {
	local id
	id="$1"
	[ -n "$id" ] || return 1

	# 只允许撤销 L4（改归属）—— L1-L3 是幂等的服务动作，无需撤销
	local lv
	lv=$(awk -F'|' -v i="$id" '$1 == i { print $3; exit }' "$DIAG_FIX_LOG" 2>/dev/null)
	[ -n "$lv" ] || { echo "ERROR=记录不存在"; return 1; }
	[ "$lv" = "L4" ] || { echo "ERROR=L1-L3 是幂等服务动作，无需撤销"; return 1; }

	# L4 的撤销：从自动列表移除该域名
	local dom
	dom=$(awk -F'|' -v i="$id" '$1 == i { print $4; exit }' "$DIAG_FIX_LOG" 2>/dev/null)
	[ -n "$dom" ] || { echo "ERROR=记录里没有域名"; return 1; }

	uci -q del_list "dnschain.dom_auto_foreign.domain=$dom" 2>/dev/null
	uci -q del_list "dnschain.dom_auto_domestic.domain=$dom" 2>/dev/null
	uci -q commit dnschain 2>/dev/null

	# 审计里标为已撤销
	local tmp
	tmp=$(mktemp) || return 1
	awk -F'|' -v i="$id" 'BEGIN{OFS="|"} $1 == i { $5 = "undone" } { print }' "$DIAG_FIX_LOG" > "$tmp" \
		&& mv -f "$tmp" "$DIAG_FIX_LOG"

	echo "OK=已撤销 $dom 的自动归属调整"
}

# ------------------------------------------------------------
# heal：手动触发指定级别
#
# 手动路径**不受时间窗限制** —— 用户明知可以断网才会点。
# ------------------------------------------------------------
cmd_heal() {
	local lv ts dom
	lv="$1"
	dom="$2"
	case "$lv" in
		1|2|3) ;;
		4) [ -n "$dom" ] || { echo "ERROR=L4 需要域名参数"; return 1; } ;;
		*) echo "ERROR=级别必须是 1/2/3/4"; return 1 ;;
	esac

	ts=$(date +%s)
	if _diag_heal_level "$lv" "$dom"; then
		_diag_log_fix "$ts" "L$lv" "${dom:--}" "ok" "手动触发"
		echo "OK=已执行 L$lv 自愈"
		return 0
	else
		_diag_log_fix "$ts" "L$lv" "${dom:--}" "fail" "手动触发失败"
		echo "ERROR=L$lv 自愈失败"
		return 1
	fi
}

cmd_status() {
	local last n
	last=$(cat "$DIAG_LAST_SCAN" 2>/dev/null)
	case "$last" in ''|*[!0-9]*) last=0 ;; esac
	n=0
	[ -f "$DIAG_FAIL_LOG" ] && n=$(wc -l < "$DIAG_FAIL_LOG" 2>/dev/null || echo 0)
	printf 'ENABLED=%s\n' "$(dc_get client_diag enabled 1)"
	printf 'AUTOFIX=%s\n' "$(dc_get client_diag autofix_enabled 1)"
	printf 'LAST_SCAN=%s\n' "$last"
	printf 'FAIL_COUNT=%s\n' "$n"
	printf 'RETAIN_SEC=%s\n' "$(dc_get client_diag retain_sec 3600)"
	printf 'RETAIN_MAX=%s\n' "$(dc_get client_diag retain_max 500)"
}

# ------------------------------------------------------------
# daemon：常驻循环
# ------------------------------------------------------------
cmd_daemon() {
	local interval
	interval=$(dc_get client_diag interval 60)
	[ "$interval" -gt 0 ] 2>/dev/null || interval=60

	dnschain_log "客户机诊断守护启动（持续跟随日志，每 ${interval} 秒汇总一次）"

	# ── 为什么必须持续跟随，而不是每轮 tail 快照 ────────────────
	#
	# 实测教训：`logread | tail -n 2000` 每轮取到的是**不同片段**，
	# 而一条查询会跨 20+ 行（CNAME 链 + nftset 行）。当窗口边界切在
	# 查询中间时，就出现「有 forwarded 无 reply」的假象：
	#
	#   www.apple.com  一条查询 20+ 行，其中 10 条是真实 A 记录，
	#                  窗口切在中间 → 判成 noreply 失败
	#   api.deepseek.com  同理，4 条真实 A 记录落在窗口外
	#
	# 后果：每轮都把正常域名记成故障，还对 copilot.tencent.com
	# 误执行了 L1 自愈；记录数 7→38→78 持续膨胀。
	#
	# 正确做法：daemon 用 `logread -f` **持续读流**，每个查询的完整
	# 生命周期都在流里，不存在窗口边界问题。轮次只用于定期 flush
	# 与修剪，不再重新取快照。
	if ! mkdir "$DIAG_LOCK" 2>/dev/null; then
		dnschain_log "客户机诊断：已有实例在跑，本实例退出"
		return 0
	fi
	trap 'rmdir "$DIAG_LOCK" 2>/dev/null' EXIT INT TERM

	# 流式处理：每输出一条判定结果就立即落盘，不等整轮
	#
	# 这条管道里的 while 每读一行就处理，不会缓冲到最后 ——
	# 若改用 `logread -f | awk > file` 再读文件，会因缓冲看不到实时结果。
	local ts

	# ⚠️ 三节管道（logread | awk | while）在后台/procd 下会被缓冲，
	#    实测 daemon 跑 15 秒一条都没落盘，而手动 `sh -c` 同样的管道
	#    却正常 —— 差别在 stdout 是不是 tty。
	#
	#    改成两段：先由 awk 直接写文件（awk 的 stdout 是文件，无缓冲），
	#    再由 shell 用 tail -f 消费。这样每行都立即可见。
	local pipe="$DNSCHAIN_STATE_DIR/.diag-pipe"
	: > "$pipe"

	# 后台跑解析，输出重定向到文件
	( logread -f 2>/dev/null | _diag_stream >> "$pipe" ) &
	local parser_pid=$!

	# 消费端：tail -f 跟踪该文件
	tail -f "$pipe" 2>/dev/null | while IFS='|' read -r ip dom up st ans; do
		[ -n "$ip" ] || continue
		[ -n "$dom" ] || continue

		ts=$(date +%s)

		# ① 流水：**每条查询都记**，不分成功失败。
		#    用户要「客户机发起的查询完整链路」，成功查询同样要看得到。
		_diag_record_flow "$ts" "$ip" "$dom" "$up" "$st" "$ans"

		# ② 失败表：只有真失败才进，供自愈阈值判定用。
		if _diag_is_fail "$st"; then
			_diag_record_fail "$ts" "$ip" "$dom" "$up" "$st"

			# 阈值判定 + 自愈
			cnt=$(_diag_fail_count "$dom")
			need=$(dc_get client_diag fail_threshold 3)
			if [ "$cnt" -ge "$need" ]; then
				if [ "$(dc_get client_diag autofix_enabled 1)" = "1" ]; then
					_diag_autofix "$dom"
				fi
			fi
		fi

		# 每 20 条修剪一次（避免频繁 fork）
		REC_N=$(( ${REC_N:-0} + 1 ))
		if [ $((REC_N % 20)) -eq 0 ]; then
			_diag_trim
			_diag_trim_flow
			echo "$ts" > "$DIAG_LAST_SCAN"

			# ③ 学习定时器（v0.24.0）
			#
			# 为什么挂在「每 20 条」而不是另起一个循环：
			#   本守护是单线程 + 管道消费模型，另起 `while sleep` 循环
			#   会与管道消费争抢，而 `sleep` 期间日志会积压。
			#   挂在已有的节流点上，既不需要额外进程，也不会因为
			#   空闲（没有查询）而永远不触发 —— 有空闲就意味着
			#   没有新日志，那时也不该学习。
			#
			# 判据：距上次学习超过 learn_interval 秒。
			# 用文件记上次时刻而不是内存变量：daemon 重启后
			# 不该立刻又学一轮（那会在每次重连时重复实测）。
			if [ "$(dc_get client_diag learn_enabled 1)" = "1" ]; then
				local linterval llast
				linterval=$(dc_get client_diag learn_interval 1800)
				case "$linterval" in ''|*[!0-9]*) linterval=1800 ;; esac
				llast=$(cat "$DNSCHAIN_STATE_DIR/learn-last-run" 2>/dev/null)
				case "$llast" in ''|*[!0-9]*) llast=0 ;; esac
				if [ "$linterval" -gt 0 ] 2>/dev/null && \
				   [ $((ts - llast)) -ge "$linterval" ]; then
					echo "$ts" > "$DNSCHAIN_STATE_DIR/learn-last-run"
					cmd_learn --source auto >/dev/null 2>&1
				fi
			fi
		fi
	done

	kill "$parser_pid" 2>/dev/null
	rm -f "$pipe"
}

main() {
	case "$1" in
		scan)         shift; cmd_scan "$@" ;;
		daemon)       shift; cmd_daemon "$@" ;;
		list)         shift; cmd_list "$@" ;;
		detail)       shift; cmd_detail "$@" ;;
		flow)         shift; cmd_flow "$@" ;;
		hosts)        shift; cmd_hosts "$@" ;;
		probe)        shift; cmd_probe "$@" ;;
		cdncheck)     shift; cmd_cdncheck "$@" ;;
		trace)        shift; cmd_trace "$@" ;;
		search)       shift; cmd_search "$@" ;;
		autofix-log)  shift; cmd_autofix_log "$@" ;;
		undo)         shift; cmd_undo "$@" ;;
		heal)         shift; cmd_heal "$@" ;;
		status)       shift; cmd_status "$@" ;;
		learn)        shift; cmd_learn "$@" ;;
		learn-start)  shift; cmd_learn_start "$@" ;;
		learn-state)  shift; cmd_learn_run_state "$@" ;;
		learn-status) shift; cmd_learn_status "$@" ;;
		learn-clear)  shift; cmd_learn_clear "$@" ;;
		*)
			cat <<'USAGE'
用法：dnschain-client-diag <子命令>

  scan             扫一轮日志，更新失败记录，必要时自愈
  daemon           常驻循环（procd 托管）
  list             客户机列表（TSV）
  detail <IP>      某客户机的失败时间线（TSV）
  flow [IP] [N]    某客户机的完整查询链路（含成功，默认最近 200 条）
  hosts            当前在线主机（第一级）
  probe <域名> [端口] [超时]  探测 DNS 通了但 TCP 通不通（第④段）
  cdncheck [IP] [N]  扫描最近访问的域名，找出 TCP 不通的
  trace <IP> <域名> 单域名的完整链路
  search <关键词> [IP] [N]  按域名搜索
  autofix-log      自愈审计记录（TSV）
  undo <id>        撤销一条自动归属调整
  heal <1|2|3|4> [域名]  手动触发自愈（不受时间窗限制；L4 需域名）
  status           运行状态
  learn [--dry-run] [--source manual|auto]  学习一轮（自动补全，阻塞）
  learn-start [--dry-run]  后台启动一轮学习，立即返回（页面按钮用这个）
  learn-state      学习是否进行中 + 上一轮结果（KEY=VALUE）
  learn-status     学习层状态（KEY=VALUE）
  learn-clear counter|rules|all  清空计数器 / 已学规则 / 全部
USAGE
			return 1
			;;
	esac
}

main "$@"
