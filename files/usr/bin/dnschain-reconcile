#!/bin/sh
# ============================================================
# dnschain-reconcile — 收敛器
# ------------------------------------------------------------
# 设计依据：docs/adr/0003-dns-chain-framework.md §9
#
# 两个职责：
#   1. 重放不变量集：把 SSR-Plus / dnsmasq / dnsproxy 的若干键归一，
#      使「用户改了 LuCI 页面」不会把链路改坏。
#   2. 名单单向导入：SSR-Plus 的 gfw 名单变化时重新生成框架的域名文件。
#
# 硬约束：
#   - 只写白名单键，其余一律不动
#   - 不改 global_server 的节点选择（为 nil 时只告警）
#   - 不改 run_mode / dports / lan_ac_mode
#   - 不删、不重写 SSR-Plus 生成的任何文件
#   - 不重启 SSR-Plus
#   - POSIX sh（dash）兼容
# ============================================================

. /usr/share/dnschain/dnschain.sh

# ------------------------------------------------------------
# 单个 UCI 键的「期望值 → 实际值」归一
# 用法: reconcile_key <uci path> <期望值> <说明>
# ------------------------------------------------------------
reconcile_key() {
	local path expect desc cur

	path="$1"
	expect="$2"
	desc="$3"

	cur=$(uci -q get "$path" 2>/dev/null)

	if [ "$cur" = "$expect" ]; then
		return 0
	fi

	uci -q set "${path}=${expect}" || {
		dnschain_log "ERROR: 写入 ${path}=${expect} 失败（原值 '${cur}'）"
		return 1
	}
	dnschain_log "归一: ${path} '${cur}' -> '${expect}'  （${desc}）"
	return 0
}

# ------------------------------------------------------------
# 重放不变量集（ADR §9.2）
# ------------------------------------------------------------
reconcile_invariants() {
	local enforce profile ssr_mode rc entry servers cnt ports
	rc=0

	# section 名是 compat（类型才是 ssr），见 dnschain.sh 里 dc_ssr_mode_for_profile 的说明
	enforce=$(dc_get compat enforce 1)
	profile=$(dc_get main profile primary)

	# ---- SSR-Plus ----
	if [ "$enforce" = "1" ]; then
		ssr_mode=$(dc_ssr_mode_for_profile)

		# pdnsd_enable：必须是 0（SSR 不启 DNS 后端）。
		# v0.10.0 起框架自己也不再用 :5335，但仍要求 0 —— 避免 SSR-Plus
		# 自己起 mosdns/dns2tcp 抢占 :53 之外的 DNS 端口，制造第二个解析器。
		if [ -n "$ssr_mode" ]; then
			reconcile_key "shadowsocksr.@global[0].pdnsd_enable" "$ssr_mode" \
				"SSR 不提供 DNS，解析全部交给框架" || rc=1
		fi

		# enable_switch 必须为 0：否则 ssr-switch 周期性 restart 造成 DNS 空窗
		reconcile_key "shadowsocksr.@global[0].enable_switch" "0" \
			"避免 ssr-switch 周期性 restart" || rc=1

		# ipv6_support 必须为 1（v0.10.0 新增硬约束）
		#
		# 为什么：国外节点只有 IPv4，若不开 IPv6 流量代理，国外域名拿到
		# 真实 AAAA 后客户端会优先走 IPv6 直连 → 被 RST。
		# 开启后 SSR-Plus 会：
		#   1. 装上 ss_spec6_* 代理链（10 条）+ fwmark 策略路由
		#   2. get_filter_aaaa() 返回 0（不再抑制 AAAA）
		#   3. 把 dnsmasq 的 filter_aaaa 设为 0
		# 实测：curl -6 google → 302、youtube → 200、baidu → 200（国内直连）
		if [ "$(dc_get compat require_ipv6 1)" = "1" ]; then
			reconcile_key "shadowsocksr.@global[0].ipv6_support" "1" \
				"国外 IPv6 也要走代理，否则客户端优先 IPv6 直连被 RST" || rc=1
		fi

		# filter_aaaa 必须为 0（v0.10.0 反转了 v0.9.x 的期望值）
		#
		# v0.9.x 曾是 1（抑制国外 AAAA），因为当时国外 IPv6 直连。
		# v0.10.0 起 ipv6_support=1，国外 IPv6 走代理，不再需要抑制 ——
		# 抑制反而让国外站点失去双栈能力。
		# 注意：ipv6_support=1 时 SSR-Plus 自己会把 dnsmasq.filter_aaaa 设为 0，
		# 但 shadowsocksr 的 filter_aaaa 键仍需显式设 0，否则用户关掉
		# ipv6_support 时会回落到抑制状态。
		reconcile_key "shadowsocksr.@global[0].filter_aaaa" "0" \
			"国外 IPv6 经代理，无需抑制 AAAA" || rc=1

		# router_proxy 必须为 1：否则路由器自身的 DoH 出向不进代理
		# → dnsproxy 查国外 DoH 会直连被墙 → 国外域名全超时
		#
		# ⚠️ 完整键名是 shadowsocksr.@access_control[0].router_proxy。
		# v0.10.0~v0.11.0 曾误写成 "access_control.@global[0].router_proxy"
		# （缺包名、section 名也错），导致每次「一键归一」都报：
		#   dnschain: ERROR: 写入 access_control.@global[0].router_proxy=1 失败（原值 ''）
		# 该键实际已为 1，所以功能没坏，只是收敛器每次都误报失败。
		# 实测确认（2026-10-22）：
		#   uci -q get shadowsocksr.@access_control[0].router_proxy → 1
		#   uci show shadowsocksr | grep -c access_control       → 5 个 section
		reconcile_key "shadowsocksr.@access_control[0].router_proxy" "1" \
			"路由器自身出向走代理" || rc=1
	fi

	# ---- global_server：只告警，绝不擅自改节点 ----
	if [ "$(uci -q get shadowsocksr.@global[0].global_server 2>/dev/null)" = "nil" ]; then
		dnschain_log "WARN: global_server 为 nil —— SSR-Plus 不会装任何规则，客户机 DNS 会全部超时"
		dnschain_log "WARN: 请在 SSR-Plus 页面重新选择一个节点（框架不代为选择）"
	fi

	# ---- dnsmasq ----
	reconcile_key "dhcp.@dnsmasq[0].noresolv" "1" \
		"不走运营商 DNS" || rc=1
	reconcile_key "dhcp.@dnsmasq[0].dnsforwardmax" "1024" \
		"抬高并发转发槽" || rc=1

	# 唯一默认上游必须恰好一条 127.0.0.1#5353
	entry=$(dc_get main entry_port 5353)
	servers=$(uci -q get dhcp.@dnsmasq[0].server 2>/dev/null | tr ' ' '\n' | grep -v '^$')
	cnt=$(printf '%s\n' "$servers" | awk 'NF { c++ } END { print c + 0 }')

	if [ "$cnt" != "1" ] || [ "$servers" != "127.0.0.1#${entry}" ]; then
		# 只在框架启用时重建
		if [ "$(dc_get main enabled 1)" = "1" ]; then
			uci -q delete dhcp.@dnsmasq[0].server
			uci -q add_list "dhcp.@dnsmasq[0].server=127.0.0.1#${entry}" || rc=1
			dnschain_log "归一: dhcp.@dnsmasq[0].server -> 127.0.0.1#${entry}（唯一上游）"
		fi
	fi

	# ---- dnsproxy：LAN 拦截开关由框架接管 ----
	reconcile_key "dnsproxy.global.lan_dns_intercept" "1" \
		"LAN DNS 强制拦截" || rc=1

	# ---- 缓存条目数：把页面配置的 cache.size 同步给 dnsmasq ----
	#
	# 为什么要在收敛器里做（v0.14.3）：uci-defaults 只在首刷时跑一次，
	# 用户在页面改「条目数」后若不刷机就永远不生效。收敛器每次开机
	# 与配置变更都会跑，是让页面值真正落地的正确位置。
	local want_cs cur_cs
	want_cs=$(dc_get cache size 8192)
	case "$want_cs" in
		''|*[!0-9]*) want_cs=8192 ;;
	esac
	[ "$want_cs" -lt 128 ] && want_cs=128
	[ "$want_cs" -gt 65536 ] && want_cs=65536
	cur_cs=$(uci -q get dhcp.@dnsmasq[0].cachesize 2>/dev/null)
	if [ "$cur_cs" != "$want_cs" ]; then
		uci -q set "dhcp.@dnsmasq[0].cachesize=$want_cs" || rc=1
		uci -q commit dhcp
		dnschain_log "归一: dhcp.cachesize '${cur_cs}' -> '${want_cs}'（页面 cache.size）"
	fi

	# ---- 分流片段 nftset 归零自愈（v0.14.3 移到这里）----
	#
	# 实测故障：在 SSR-Plus 页面点「保存并应用」后，ssrplus 重建规则，
	# `ss_spec` 表短暂消失。若 dnschain 恰在此窗口跑 apply/reconcile，
	# 会生成 **23714 条 server= 但 0 条 nftset=** 的片段 ——
	# 国外域名能解析，可解析出的 IP 不进 blacklist →
	# **流量不走代理 → 国外链路整条断掉**，且日志干净。
	#
	# 为什么放在 invariants 而不是 reconcile_lists：
	#   reconcile_lists 在名单指纹未变时直接 return，
	#   而 nftset 归零与名单无关 —— 放那里等于永不检查。
	local nft_now
	nft_now=$(dc_count_lines '^nftset=' "$DNSCHAIN_DNSMASQ_CONF_DIR/dnschain-split.conf")
	if [ "$nft_now" -eq 0 ] 2>/dev/null && dc_ss_spec_present; then
		dnschain_log "WARN: 分流片段 nftset 行数为 0（ss_spec 已存在），重建一次"
		dc_gen_dnsmasq_split >/dev/null 2>&1
		nft_now=$(dc_count_lines '^nftset=' "$DNSCHAIN_DNSMASQ_CONF_DIR/dnschain-split.conf")
		if [ "$nft_now" -gt 0 ] 2>/dev/null; then
			dnschain_log "已修复：nftset 行数 ${nft_now}"
			# 片段变了，dnsmasq 必须重启才生效（由 main 统一处理）
			DNSCHAIN_SPLIT_CHANGED=1
		else
			dnschain_log "ERROR: 重建后 nftset 仍为 0，请检查 ss_spec 的 blacklist/china 集合"
			rc=1
		fi
	fi

	# ---- 缓存层唯一：dnsproxy 不能带 --cache ----
	if grep -q '^--cache' "$DNSCHAIN_RUN_DIR/dnsproxy.args" 2>/dev/null; then
		dnschain_log "ERROR: dnsproxy.args 里出现 --cache，违反「缓存只在 dnsmasq 一层」（ADR §10.5）"
		rc=1
	fi

	# ---- 端口表只校验，不改 ----
	ports=$(dc_output_ports)
	if [ -n "$ports" ]; then
		case " $ports " in
			*" 53 "*)  dnschain_log "ERROR: ss_spec_output 端口集含 53 —— 会触发 v2ray socket 堆积（AGENTS §4.3）"; rc=1 ;;
		esac
		case " $ports " in
			*" 853 "*) ;;
			*) dnschain_log "ERROR: ss_spec_output 端口集不含 853 —— 路由器自身 DoT 不会进代理，国外域名会超时"; rc=1 ;;
		esac
	fi

	uci -q commit shadowsocksr
	uci -q commit dhcp
	uci -q commit dnsproxy

	# ---- dnsmasq 日志（v0.14.8）----
	#
	# 上游 `99-default-settings` 每次构建把 `/etc/dnsmasq.conf` 写成
	# `log-facility=/dev/null`，而生成的配置又 `conf-file=` 引用它 →
	# **dnsmasq 日志全部丢弃**（实测 logqueries=1 但 logread 里恒为 0）。
	#
	# 不能用 UCI `dhcp.@dnsmasq[0].logfacility` 修：init.d/dnsmasq 的
	# `append_parm logfacility` 会再写一条，与 conf-file 里的重复 →
	# `illegal repeated keyword` → dnsmasq **起不来**（实测复现两次）。
	# 也不能用 `/dev/log`（ujail 未挂载该 socket）。
	# 实测可用的是 `syslog`。
	#
	# uci-defaults 只在刷机后跑一次，这里每次收敛都校正，防被覆盖。
	if [ -f /etc/dnsmasq.conf ]; then
		if ! grep -q '^log-facility=syslog$' /etc/dnsmasq.conf 2>/dev/null; then
			sed -i '/^log-facility=/d' /etc/dnsmasq.conf 2>/dev/null
			echo 'log-facility=syslog' >> /etc/dnsmasq.conf
			dnschain_log "已修正 /etc/dnsmasq.conf 的 log-facility=/dev/null（日志原本全丢）"
			# 只有真正改过才需要重启，避免每次收敛都断一下
			DNSCHAIN_LOG_CHANGED=1
		fi
	fi

	return $rc
}

# ------------------------------------------------------------
# 名单单向导入（ADR §9.3）
#
# 触发条件：源文件 md5 变化，且 auto_import=1
# 重导只重建文件、不重启 dnsproxy，除非行数变化超过 restart_threshold
# ------------------------------------------------------------
reconcile_lists() {
	local cur fp_old fp_new old_lines new_lines threshold delta pct

	[ "$(dc_get lists auto_import 1)" = "1" ] || return 0

	fp_new=$(dc_lists_fingerprint)
	[ -n "$fp_new" ] || return 0

	fp_old=$(cat "$DNSCHAIN_STATE_DIR/lists.fingerprint" 2>/dev/null)

	# 指纹未变：什么都不做
	[ "$fp_new" = "$fp_old" ] && return 0

	dnschain_log "名单源已变化，重新导入..."

	old_lines=$(echo "$fp_old" | awk '{print $2}')
	new_lines=$(echo "$fp_new" | awk '{print $2}')

	# 重建域名文件
	#
	# v0.13.0 起要重建**三个**派生物，缺一个就会出现「页面与生效不一致」：
	#   1. db-domains.txt     归属判定的输入（数据库域名集合）
	#   2. dnschain-split.conf 静态分流片段（需要 restart 才生效）
	#   3. watch.servers      观测域名的动态上游（SIGHUP 即生效）
	#
	# 注意顺序：db-domains 必须先更新，否则 split 会按旧集合生成。
	dc_gen_db_domains >/dev/null 2>&1
	dc_gen_upstream_file >/dev/null || {
		dnschain_log "ERROR: 重新导入失败"
		return 1
	}

	# 分流片段：名单变了就重建
	#
	# ⚠️ nftset 归零的**自愈**不在这里做（v0.14.3 修）。
	#    本函数在「名单指纹未变」时会直接 return 0，
	#    而 nftset 归零与名单是否变化无关（那是 SSR-Plus 重建窗口造成的）。
	#    放在这里等于「名单不变就永不检查」—— 实测确认自愈从不触发。
	#    自愈已移到 reconcile_invariants（每次收敛都跑）。
	dc_gen_dnsmasq_split >/dev/null 2>&1 || \
		dnschain_log "WARN: 重建 dnschain-split.conf 失败"

	dc_gen_watch_servers >/dev/null 2>&1

	# 行数变化是否超过阈值
	threshold=$(dc_get lists restart_threshold 1)
	delta=0
	pct=0
	if [ -n "$old_lines" ] && [ "$old_lines" -gt 0 ] 2>/dev/null; then
		delta=$(( new_lines - old_lines ))
		[ "$delta" -lt 0 ] && delta=$(( -delta ))
		pct=$(( delta * 100 / old_lines ))
	fi

	if [ "$pct" -ge "$threshold" ] 2>/dev/null; then
		dnschain_log "名单行数变化 ${pct}% >= ${threshold}%，重启 dnsproxy 使新文件生效"
		# 重启 dnsproxy 实例（约 1 秒解析中断，ADR R-1）
		/etc/init.d/dnschain reload >/dev/null 2>&1 || \
			dnschain_log "WARN: reload dnschain 失败，新名单未生效"
	else
		dnschain_log "名单行数变化 ${pct}% < ${threshold}%，只重建文件（dnsproxy 下次重启时生效）"
	fi

	echo "$fp_new" > "$DNSCHAIN_STATE_DIR/lists.fingerprint"
	return 0
}

# ------------------------------------------------------------
# 拦截总开关：按 intercept 的值决定是否下发 DHCP DNS
# 注意：改动 dhcp-option 需要 dnsmasq restart 才生效（reload 不重读配置）
# ------------------------------------------------------------
reconcile_intercept() {
	local intercept dns_list changed

	intercept=$(dc_get main intercept 1)

	if [ "$intercept" = "1" ]; then
		# 拦截开启：DHCP 下发路由器自身地址（由 dnsmasq 默认行为提供），
		# 故清掉自定义 dhcp-option 6
		# ⚠️ 必须按**项**匹配，不能按行首（v0.14.3 修 M6）。
		#    `uci get` 把 list 拼成一行空格分隔，`grep '^6,'` 只匹配行首。
		#    若 DHCP option 里 DNS 不是第一项（例如先有 `3,192.168.3.1`
		#    再有 `6,...`），这段永远不会删掉旧的明文 DNS 下发，
		#    客户机继续拿到外部 DNS，绕过整个框架 —— 而页面显示「拦截已开启」。
		if uci -q get dhcp.@dnsmasq[0].dhcp_option 2>/dev/null \
			| tr ' ' '\n' | grep -q '^6,'; then
			uci -q delete dhcp.@dnsmasq[0].dhcp_option
			changed=1
		fi
	else
		# 拦截关闭：按页面配置下发明文 DNS
		if [ "$(dc_get dhcp_dns enabled 1)" = "1" ]; then
			dns_list=$(dc_get_list dhcp_dns server | tr '\n' ',' | sed 's/,$//')
			if [ -n "$dns_list" ]; then
				uci -q delete dhcp.@dnsmasq[0].dhcp_option
				uci -q add_list "dhcp.@dnsmasq[0].dhcp_option=6,${dns_list}"
				changed=1
			fi
		fi
	fi

	if [ "$changed" = "1" ]; then
		# ⚠️ 失败必须置非 0（v0.14.3 修 M9）。
		#    原实现无条件 return 0，而 main 也不取它的 rc →
		#    commit/restart 失败时收敛器仍以 0 退出，
		#    页面「一键归一」永远报成功（违反 AGENTS 红线 3「禁止静默失败」）。
		uci -q commit dhcp || {
			dnschain_log "ERROR: 提交 dhcp 配置失败"
			return 1
		}
		dnschain_log "拦截开关变化，重启 dnsmasq 使 DHCP 下发值生效（约 3 秒中断）"
		/etc/init.d/dnsmasq restart >/dev/null 2>&1 || {
			dnschain_log "ERROR: 重启 dnsmasq 失败，DHCP 下发值未生效"
			return 1
		}
	fi
	return 0
}

# ------------------------------------------------------------
# 入口
# ------------------------------------------------------------
main() {
	local rc

	mkdir -p "$DNSCHAIN_STATE_DIR" 2>/dev/null

	reconcile_invariants
	rc=$?

	reconcile_lists
	[ $? -ne 0 ] && rc=1

	reconcile_intercept
	[ $? -ne 0 ] && rc=1

	# 分流片段被自愈重建过 → dnsmasq 必须重启才生效
	# （静态片段通过 conf-dir 加载，SIGHUP 不重读，AGENTS §4.4）
	if [ -n "$DNSCHAIN_SPLIT_CHANGED" ]; then
		DNSCHAIN_SPLIT_CHANGED=""
		dnschain_log "分流片段已重建，重启 dnsmasq 使其生效"
		/etc/init.d/dnsmasq restart >/dev/null 2>&1 || rc=1
	fi

	# 日志配置刚被自愈改过 → 同样必须重启才生效
	if [ -n "$DNSCHAIN_LOG_CHANGED" ]; then
		DNSCHAIN_LOG_CHANGED=""
		dnschain_log "dnsmasq 日志配置已修正，重启使其生效"
		/etc/init.d/dnsmasq restart >/dev/null 2>&1 || rc=1
	fi

	# 缓存条目数是 dnsmasq 的**启动参数**，改了必须重启才生效
	# （reload 只清缓存、不重读配置）。这里比对「UCI 值」与
	# 「进程实际生效值」，不一致才重启一次 —— 避免每轮都重启。
	local want_cs eff_cs
	want_cs=$(dc_get cache size 8192)
	case "$want_cs" in ''|*[!0-9]*) want_cs=8192 ;; esac
	eff_cs=$(sed -n 's/^cache-size=\([0-9]*\)$/\1/p' /var/etc/dnsmasq.conf.* 2>/dev/null | head -1)
	if [ -n "$eff_cs" ] && [ "$want_cs" != "$eff_cs" ]; then
		dnschain_log "缓存条目数待生效（配置 ${want_cs} / 实际 ${eff_cs}），重启 dnsmasq"
		/etc/init.d/dnsmasq restart >/dev/null 2>&1 || rc=1
	fi

	if [ "$rc" -ne 0 ]; then
		dnschain_log "收敛完成，但有错误（见上方日志）"
		return 1
	fi

	return 0
}

main "$@"
