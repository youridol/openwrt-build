#!/bin/sh
# ============================================================
# dnschain-selftest — 全链路自检
# ------------------------------------------------------------
# 设计依据：docs/adr/0003-dns-chain-framework.md §11（16 项）
#           docs/adr/0006-domain-routing-and-reroute.md（17~20 项，v0.13.0）
#
# 输出：每行 "<序号> <PASS|FAIL|SKIP> <项目名> — <证据/原因>"
# 退出码：全 PASS 或 SKIP 时为 0；任一 FAIL 为 1
#
# 调用方：
#   - 页面「一键自检」
#   - init.d/dnschain 启动后
#   - 定时任务（selftest.interval，默认 300s）
#   - CI 契约校验
#
# 测试纪律（AGENTS §5.1、§6.2）：
#   - 必须区分 OK / EMPTY / NX / TIMEOUT / FAIL 五种结果
#   - 国外 AAAA 的预期是 EMPTY（rcode=0 ancount=0），不是 TIMEOUT
#   - 必须用客户机真实地址测，不能只测 127.0.0.1
#   - 测延迟不能用 date +%s%N（BusyBox 不支持，会静默返回秒级）
# ============================================================

. /usr/share/dnschain/dnschain.sh

PASS_CNT=0
FAIL_CNT=0
SKIP_CNT=0

# 机器可读输出
emit() {
	local no status name detail
	no="$1"; status="$2"; name="$3"; detail="$4"

	printf '%s %s %s — %s\n' "$no" "$status" "$name" "$detail"

	case "$status" in
		PASS) PASS_CNT=$((PASS_CNT + 1)) ;;
		FAIL) FAIL_CNT=$((FAIL_CNT + 1)) ;;
		SKIP) SKIP_CNT=$((SKIP_CNT + 1)) ;;
	esac
}

# ------------------------------------------------------------
# DNS 查询结果分类：OK / EMPTY / NX / TIMEOUT / FAIL
# 用法: dns_class <域名> <服务器[:端口]> [qtype]
#
# 判据（AGENTS §5.1）：
#   OK      rcode=0 且 ancount>0
#   EMPTY   rcode=0 且 ancount=0   ← filter_aaaa 的预期形态，不是故障
#   NX      rcode=3
#   TIMEOUT 完全无响应              ← 故障
#   FAIL    rcode=2 等              ← 上游故障
# ------------------------------------------------------------
dns_class() {
	# 委托给 dnschain.sh 里的 dc_dns_class（v0.14.1）
	#
	# 这里曾重复实现了一份分类逻辑，且那份没有硬超时：
	# BusyBox 的 nslookup 没有 -timeout 参数，上游挂死时会按
	# 自己的默认重试节奏一直等（实测单次 5 秒以上）。
	# 自检有 4 处 DNS 查询 -> 页面打开要十几秒，
	# 用户感知就是「切换页面响应时间太长」。
	#
	# dnschain.sh 的 dc_dns_class 用 dc_run_timeout 做硬超时
	# （完成标记文件 + 紧密轮询），是正确实现。直接委托，
	# 避免同一套判据写两遍、迟早漂移。
	#
	# 超时秒数可用 DC_SELFTEST_DNS_TIMEOUT 覆盖，默认 3。
	dc_dns_class "$1" "$2" "${3:-a}" "${DC_SELFTEST_DNS_TIMEOUT:-3}"
}

dns_first_addr() {
	# 同样委托（理由见 dns_class）
	dc_dns_first_addr "$1" "$2" "${3:-a}" "${DC_SELFTEST_DNS_TIMEOUT:-3}"
}

# 污染 IP 判定：GFW 注入的典型值
is_polluted() {
	case "$1" in
		2001::1|2001:0:0:0:0:0:0:1) return 0 ;;
		31.13.*|157.240.*|104.244.*) return 0 ;;
		*) return 1 ;;
	esac
}

# ------------------------------------------------------------
# 客户机路径地址：取 LAN 地址，而不是 127.0.0.1
# ------------------------------------------------------------
lan_addr() {
	local ip
	ip=$(uci -q get network.lan.ipaddr)
	[ -n "$ip" ] && { echo "$ip"; return 0; }
	echo "127.0.0.1"
}

# ------------------------------------------------------------
# 逐项检查
# ------------------------------------------------------------
check_all() {
	local entry lan cn_up foreign_up owner pid
	local cls addr tables chains fw4_ok
	local dnsmasq_cache dp_args

	entry=$(dc_get main entry_port 5353)
	lan=$(lan_addr)

	# 1. 客户机 DNS 路径可达（LAN 地址上 :53 能应答）
	#
	# v0.10.0 修正了判据。早先检查 `nft chain inet fw4 dns_intercept_lan`，
	# 但实测该链**从来不存在**，而客户机 DNS 完全正常 —— 因为 dnsmasq
	# 直接监听在 LAN 地址的 :53 上（netstat 可见 192.168.3.254:53），
	# 客户机无需经过 nft 劫持就能问到。
	#
	# 真正该验的是「LAN 地址上的 :53 能否解析」：
	# 这既覆盖「dnsmasq 在监听」，也覆盖「上游链路通」。
	local lan_cls
	lan_cls=$(dns_class "www.baidu.com" "$lan")
	if [ "$lan_cls" = "OK" ] || [ "$lan_cls" = "EMPTY" ]; then
		emit 1 PASS "客户机 DNS 路径可达" "${lan}:53 应答 ${lan_cls}"
	else
		emit 1 FAIL "客户机 DNS 路径可达" "${lan}:53 应答 ${lan_cls}"
	fi

	# 2. dnsmasq 分流：框架自己的片段必须只指向 foreign_port
	#
	# v0.10.0 修正了判据范围。
	# 早先扫描整个 SSR conf-dir，会把 SSR-Plus 生成的
	# `server=/域名/127.0.0.1#5335`（17804 条）算成「未预期端口」→ 永久误报。
	#
	# 但那是**SSR-Plus 自己的文件**，框架按 AGENTS §4.0 不删不重写。
	# 实测它并不造成故障：dnsmasq 对同一域名的多条 server= 会全部作为候选，
	# 而 :5335 无监听时 dnsmasq 会自动重试其它候选（实测 10/10 成功）。
	#
	# 该验的是「框架生成的片段本身正确」——即 dnschain-split.conf 里
	# 所有 server= 都指向 foreign_port，且没有残留指向 :5335 的旧规则。
	local split_file bad_ports ports_found fport
	fport=$(dc_get main foreign_port 5336)
	split_file="$DNSCHAIN_DNSMASQ_CONF_DIR/dnschain-split.conf"

	if [ ! -r "$split_file" ]; then
		emit 2 FAIL "框架分流规则正确" "缺少 ${split_file}"
	else
		# 性能要点（v0.11.1）：该文件实测 1.5MB / 17813 行。
		# 原实现用 `grep -hoE ... | sed | sort -u | tr` 收集全部端口再去重，
		# 要扫完全文件 + 起 3 个进程（170ms）。
		# 但判定只需要知道「有没有不等于 fport 的行」→ 反选 + head -1 短路，
		# 正常情况下扫到第一行就能确认（实测 170ms → 40ms）。
		local first_bad
		first_bad=$(grep -vE "^server=/[^/]+/127\.0\.0\.1#${fport}\$" "$split_file" 2>/dev/null \
			| grep -E '^server=' | head -1)

		if [ -z "$first_bad" ]; then
			emit 2 PASS "框架分流规则正确" "dnschain-split.conf 全部指向 :${fport}"
		else
			local bad_ports
			bad_ports=$(grep -hoE '^server=/[^/]+/127\.0\.0\.1#[0-9]+' "$split_file" 2>/dev/null \
				| sed 's/.*#//' | sort -u | tr '\n' ' ')
			emit 2 FAIL "框架分流规则正确" "出现未预期端口: ${bad_ports}（应为 ${fport}），例如 ${first_bad}"
		fi
	fi

	# 3. dnsmasq 唯一默认上游恰好一条
	local srv_cnt
	srv_cnt=$(grep -c "^server=127.0.0.1#${entry}\$" /var/etc/dnsmasq.conf.* 2>/dev/null | head -1)
	[ -z "$srv_cnt" ] && srv_cnt=0
	if [ "$srv_cnt" = "1" ]; then
		emit 3 PASS "dnsmasq 唯一默认上游" "server=127.0.0.1#${entry} 恰好 1 条"
	else
		emit 3 FAIL "dnsmasq 唯一默认上游" "server=127.0.0.1#${entry} 出现 ${srv_cnt} 条（应为 1）"
	fi

	# 4. dnsproxy 在监听（127.0.0.1 与 ::1）
	if dc_port_listening "$entry" udp; then
		local v4 v6
		v4=$(dns_class "www.baidu.com" "127.0.0.1:${entry}")
		v6=$(dns_class "www.baidu.com" "[::1]:${entry}")
		if [ "$v4" = "OK" ] || [ "$v4" = "EMPTY" ]; then
			emit 4 PASS "dnsproxy 在监听" "127.0.0.1:${entry} 应答 ${v4}"
		else
			emit 4 FAIL "dnsproxy 在监听" "127.0.0.1:${entry} 应答 ${v4}"
		fi
	else
		emit 4 FAIL "dnsproxy 在监听" ":${entry} 无监听"
	fi

	# 5. dnsproxy 参数与配置一致，且不含 --cache
	pid=$(dc_port_owner "$entry" udp)
	if [ -n "$pid" ] && [ -r "/proc/${pid}/cmdline" ]; then
		dp_args=$(tr '\0' '\n' < "/proc/${pid}/cmdline")
		if echo "$dp_args" | grep -q '^--cache'; then
			emit 5 FAIL "dnsproxy 参数一致" "出现 --cache，违反「缓存只在 dnsmasq 一层」"
		elif echo "$dp_args" | grep -q '^--fallback'; then
			emit 5 FAIL "dnsproxy 参数一致" "出现 --fallback，会回落明文/污染上游"
		elif echo "$dp_args" | grep -q '^--ipv6-disabled'; then
			emit 5 FAIL "dnsproxy 参数一致" "出现 --ipv6-disabled，会连国内 AAAA 一起砍"
		else
			emit 5 PASS "dnsproxy 参数一致" "无 --cache、无 --fallback、无 --ipv6-disabled"
		fi
	else
		emit 5 SKIP "dnsproxy 参数一致" "取不到 dnsproxy 的 pid"
	fi

	# 6. chinadns-ng 必须**不在**运行（v0.10.0 起由 dnsproxy 承担国外解析）
	#
	# 这一项从「过滤器必须在监听」反转成「过滤器必须不存在」。
	# 原因：chinadns-ng 的 -t 不支持 DoH，而落地节点到 853 全部不通，
	# 它只会把国外域名降级成「用国内 DNS 查」→ 污染答案。
	local fl_pid
	fl_pid=$(dc_port_owner 5335 udp)
	if [ -z "$fl_pid" ]; then
		emit 6 PASS "无 chinadns-ng 残留" ":5335 无监听（v0.10.0 已移除该组件）"
	else
		emit 6 FAIL "无 chinadns-ng 残留" ":5335 被 PID ${fl_pid} 占用，会污染国外解析"
	fi

	# 7. 端口所有权无冲突（SSR 模式必须为 0/7）
	#
	# 注意：这里**不检查 shadowsocksr.filter_aaaa**。
	# 该项是「用户偏好」，而实际生效的是 dhcp.@dnsmasq[0].filter_aaaa ——
	# SSR-Plus 的 set_ipv6_dns_filter 在 ipv6_support=1 时会把它设 0。
	# 实测：shadowsocksr.filter_aaaa=1 但 dnsmasq.filter_aaaa=0，
	#       AAAA 解析完全正常（taobao 2 条、google 8 条）。
	# 早先版本把 shadowsocksr.filter_aaaa 当判据，产生误报。
	local ssr_mode ipv6_on dnsmasq_aaaa
	ssr_mode=$(uci -q get shadowsocksr.@global[0].pdnsd_enable 2>/dev/null)
	ipv6_on=$(uci -q get shadowsocksr.@global[0].ipv6_support 2>/dev/null)
	dnsmasq_aaaa=$(uci -q get dhcp.@dnsmasq[0].filter_aaaa 2>/dev/null)
	if [ "$ssr_mode" != "0" ] && [ "$ssr_mode" != "7" ]; then
		emit 7 FAIL "端口所有权无冲突" "pdnsd_enable=${ssr_mode}（应为 0 或 7）"
	elif [ "$ipv6_on" != "1" ]; then
		emit 7 FAIL "端口所有权无冲突" "ipv6_support=${ipv6_on}（应为 1，否则国外 AAAA 无意义）"
	elif [ "$dnsmasq_aaaa" != "0" ]; then
		emit 7 FAIL "端口所有权无冲突" "dnsmasq.filter_aaaa=${dnsmasq_aaaa}（应为 0，否则 AAAA 被砍）"
	else
		emit 7 PASS "端口所有权无冲突" "pdnsd_enable=${ssr_mode}、ipv6_support=1、dnsmasq.filter_aaaa=0"
	fi

	# 8. 国内 A 正确（客户机路径）
	addr=$(dns_first_addr "www.baidu.com" "$lan")
	if [ -n "$addr" ] && ! is_polluted "$addr"; then
		emit 8 PASS "国内 A 正确" "${lan} 查 www.baidu.com -> ${addr}"
	else
		emit 8 FAIL "国内 A 正确" "${lan} 查 www.baidu.com -> ${addr:-无结果}"
	fi

	# 9. 国内 AAAA 保留
	cls=$(dns_class "www.taobao.com" "$lan" aaaa)
	if [ "$cls" = "OK" ]; then
		addr=$(dns_first_addr "www.taobao.com" "$lan" aaaa)
		emit 9 PASS "国内 AAAA 保留" "www.taobao.com -> ${addr}"
	else
		emit 9 FAIL "国内 AAAA 保留" "www.taobao.com AAAA 结果 ${cls}（应为 OK）"
	fi

	# 10. 国外 A 正确（非污染）
	addr=$(dns_first_addr "www.google.com" "$lan")
	if [ -n "$addr" ] && ! is_polluted "$addr"; then
		emit 10 PASS "国外 A 正确" "www.google.com -> ${addr}"
	elif [ -z "$addr" ]; then
		emit 10 FAIL "国外 A 正确" "www.google.com 无结果（dnsproxy 或代理可能未运行）"
	else
		emit 10 FAIL "国外 A 正确" "www.google.com -> ${addr}（污染值，检查国外上游是否为 DoH）"
	fi

	# 11. 国外 AAAA **保留**（v0.10.0 起不再抑制）
	#
	# 语义反转：v0.9.x 期望 EMPTY（抑制），v0.10.0 期望 OK（保留）。
	# 因为 SSR-Plus 的 IPv6 流量代理会把国外 IPv6 也送进 :1234，
	# 没有「IPv6 直连被 RST」的问题，抑制反而损失双栈能力。
	cls=$(dns_class "www.google.com" "$lan" aaaa)
	case "$cls" in
		OK) emit 11 PASS "国外 AAAA 保留" "返回真实 AAAA（IPv6 经代理出站）" ;;
		EMPTY) emit 11 FAIL "国外 AAAA 保留" "被抑制了（应为 OK）——检查 ipv6_support 与 chinadns-ng 是否残留" ;;
		TIMEOUT) emit 11 FAIL "国外 AAAA 保留" "TIMEOUT —— 会卡住客户端" ;;
		*) emit 11 FAIL "国外 AAAA 保留" "结果 ${cls}" ;;
	esac

	# 12. 国外 DoH 出站（v0.10.0：不再是 DoT）
	local est
	est=$(netstat -antp 2>/dev/null \
		| grep -E ':443' \
		| grep -cE 'dns\.google|cloudflare-dns|142\.25[0-9]\.|104\.16\.|1\.1\.1\.1|8\.8\.8\.8' 2>/dev/null || echo 0)
	if [ "$est" -gt 0 ] 2>/dev/null; then
		emit 12 PASS "国外 DoH 出站" "${est} 条到 DoH 上游的 ESTABLISHED"
	else
		emit 12 SKIP "国外 DoH 出站" "当前无活跃连接（空闲时正常，可忽略）"
	fi

	# 13. 代理与分流在位
	tables=$(nft list tables 2>/dev/null | grep -c ss_spec)
	local port1234 gs
	port1234=$(dc_port_listening 1234 tcp && echo yes || echo no)
	gs=$(uci -q get shadowsocksr.@global[0].global_server 2>/dev/null)
	if [ "$tables" = "2" ] && [ "$port1234" = "yes" ] && [ "$gs" != "nil" ] && [ -n "$gs" ]; then
		emit 13 PASS "代理与分流在位" "ss_spec 表 2 个、:1234 在监听、global_server=${gs}"
	else
		emit 13 FAIL "代理与分流在位" "ss_spec=${tables}、:1234=${port1234}、global_server=${gs:-空}"
	fi

	# 14. fw4 规则可加载
	#
	# 性能要点（v0.11.1）：`fw4 check` 实测 620ms —— 它要重新渲染整个
	# ruleset 模板（34 条 chain）再交给 nft -c 校验，占 selftest 总耗时 45%。
	#
	# 但它的结论只在「fw4 相关输入变了」时才会变：/etc/nftables.d/ 下的
	# 片段、/etc/config/firewall、以及 fw4 模板本身。这些文件的 mtime
	# 不变时，重复校验必然得到同一结果。
	#
	# 故按 mtime 指纹缓存结果（默认 300 秒）：
	#   - 输入没变 → 直接复用上次结论（0ms）
	#   - 输入变了 → 重新 fw4 check
	#   - 环境变量 DNSCHAIN_FW4_NO_CACHE=1 → 强制重算（排障用）
	#
	# 缓存放 /tmp（重启即清），不污染持久化配置。
	local fw4_cache="$DNSCHAIN_RUN_DIR/fw4-check.cache"
	local fw4_stamp_now fw4_stamp_old fw4_result_old

	# 指纹：所有可能影响 ruleset 的输入文件的 mtime 之和
	fw4_stamp_now=$(
		{
			ls -l /etc/config/firewall 2>/dev/null
			ls -l /etc/nftables.d/*.nft 2>/dev/null
			ls -l /usr/share/firewall4/templates/*.uc 2>/dev/null
			ls -l /usr/share/nftables.d/ruleset-post/*.nft 2>/dev/null
		} | awk '{printf "%s:%s:%s\n", $5, $6, $7}' | md5sum | cut -d' ' -f1
	)

	if [ -f "$fw4_cache" ]; then
		fw4_stamp_old=$(sed -n '1p' "$fw4_cache" 2>/dev/null)
		fw4_result_old=$(sed -n '2p' "$fw4_cache" 2>/dev/null)
	fi

	if [ "${DNSCHAIN_FW4_NO_CACHE:-0}" != "1" ] \
		&& [ -n "$fw4_stamp_old" ] && [ "$fw4_stamp_old" = "$fw4_stamp_now" ] \
		&& [ -n "$fw4_result_old" ]; then
		if [ "$fw4_result_old" = "ok" ]; then
			emit 14 PASS "fw4 规则可加载" "fw4 check 通过（复用缓存，输入未变）"
		else
			emit 14 FAIL "fw4 规则可加载" "fw4 check 失败（复用缓存）"
		fi
	else
		if fw4 check >/dev/null 2>&1; then
			printf '%s\nok\n' "$fw4_stamp_now" > "$fw4_cache" 2>/dev/null
			emit 14 PASS "fw4 规则可加载" "fw4 check 通过"
		else
			printf '%s\nfail\n' "$fw4_stamp_now" > "$fw4_cache" 2>/dev/null
			emit 14 FAIL "fw4 规则可加载" "fw4 check 失败"
		fi
	fi

	# 15. 无明文旁路
	#
	# 判据：conf-dir 内不得有指向**明文公共 DNS**的 server=。
	# 允许的是 127.0.0.1#<端口>（本地加密链路）。
	#
	# 注意：不能简单 grep 出所有 IP 形式再排除 #5353 —— 那样会把
	# 127.0.0.1#5336（国外实例）也误判成明文旁路（实测虚报 35627 条）。
	# 正确做法：只统计「非 127.0.0.1 的 IP」。
	#
	# 性能要点（v0.11.1）：原实现用 `grep ... | grep -v ... | wc -l`
	# 扫描全部 conf-dir（实测 2.1MB / 35630 行 server=），耗时 240ms。
	#
	# 两处优化（实测 300ms → 10ms，30 倍）：
	#   1. **加 `^` 锚定**。原正则 `server=/[^/]+/...` 没有锚定，
	#      grep 要对每一行尝试所有起始位置，回溯代价高；
	#      `^server=/[^/]+/...` 只试行首，实测 300ms → 10ms。
	#   2. 判定只需「有没有」，不需要精确条数 → `head -1` 短路。
	#      失败时才回退去数总数（那种情况本来就该慢一点给人看清）。
	local plain_hit=""
	plain_hit=$(grep -rhE '^server=/[^/]+/([0-9]{1,3}\.){3}[0-9]{1,3}(#[0-9]+)?$' \
		"$DNSCHAIN_DNSMASQ_CONF_DIR" 2>/dev/null \
		| grep -vE '^server=/[^/]+/127\.0\.0\.1' | head -1)

	if [ -z "$plain_hit" ]; then
		emit 15 PASS "无明文旁路" "conf-dir 内无非 127.0.0.1 的 server="
	else
		local plain
		plain=$(grep -rhE '^server=/[^/]+/([0-9]{1,3}\.){3}[0-9]{1,3}(#[0-9]+)?$' \
			"$DNSCHAIN_DNSMASQ_CONF_DIR" 2>/dev/null \
			| grep -vE '^server=/[^/]+/127\.0\.0\.1' | wc -l)
		emit 15 FAIL "无明文旁路" "${plain} 条指向外部明文 IP 的 server=，例如 ${plain_hit}"
	fi

	# 16. 缓存层唯一
	dnsmasq_cache=$(grep -oE '^cache-size=[0-9]+' /var/etc/dnsmasq.conf.* 2>/dev/null | head -1 | cut -d= -f2)
	dp_args=$(dc_args_to_cmdline "$DNSCHAIN_RUN_DIR/dnsproxy.args" 2>/dev/null)

	local cache_bad
	cache_bad=""
	case "$dp_args" in *--cache*) cache_bad="${cache_bad}dnsproxy "; esac

	if [ -z "$cache_bad" ] && [ -n "$dnsmasq_cache" ] && [ "$dnsmasq_cache" -gt 0 ] 2>/dev/null; then
		emit 16 PASS "缓存层唯一" "dnsmasq cache-size=${dnsmasq_cache}，dnsproxy 无 --cache"
	else
		emit 16 FAIL "缓存层唯一" "越界缓存: ${cache_bad:-无}；dnsmasq cache-size=${dnsmasq_cache:-未设置}"
	fi

	# --------------------------------------------------------
	# v0.13.0：域名归属 / 自定义列表 / 自动改道
	# --------------------------------------------------------

	# 17. 自定义列表格式合法
	#
	# 为什么自检要查这个：页面保存时会校验，但用户可以直接 uci set，
	# 也可以从备份恢复。非法条目会生成一条永远匹配不到的 server=，
	# 而链路上看不出任何异常 —— 这类静默失效必须能被自检发现。
	local chk bad_n
	chk=$(/usr/bin/dnschain-health check 2>&1)
	bad_n=$(echo "$chk" | sed -n 's/^FAIL bad=\([0-9]*\)$/\1/p')
	if [ -z "$bad_n" ]; then
		local n_dom n_for
		n_dom=$(dc_custom_count domestic)
		n_for=$(dc_custom_count foreign)
		emit 17 PASS "自定义域名列表合法" "国内 ${n_dom} 条、国外 ${n_for} 条，格式全部通过"
	else
		local first_bad
		first_bad=$(echo "$chk" | grep '^BAD ' | head -1)
		emit 17 FAIL "自定义域名列表合法" "${bad_n} 条非法，例如 ${first_bad}"
	fi

	# 18. 静态分流片段里不出现观测域名
	#
	# 这是本设计最容易破的约束：同一个域名若同时出现在
	# dnschain-split.conf（静态）与 watch.servers（动态）里，
	# dnsmasq 会把两条 server= 当作**候选**（不是后者覆盖前者），
	# 改道就退化成「随机走一条」，而且两条链都能解析时完全看不出问题。
	local dup_n watch_file split_file2 d_w
	watch_file="$DNSCHAIN_WATCH_SERVERS"
	split_file2="$DNSCHAIN_DNSMASQ_CONF_DIR/dnschain-split.conf"
	dup_n=0
	if [ -r "$watch_file" ] && [ -r "$split_file2" ]; then
		for d_w in $(dc_watch_list); do
			[ -n "$d_w" ] || continue
			if grep -qE "^server=/$(echo "$d_w" | sed 's|\.|\\.|g')/" "$split_file2" 2>/dev/null; then
				dup_n=$((dup_n + 1))
			fi
		done
	fi
	if [ "$dup_n" -eq 0 ]; then
		emit 18 PASS "观测域名不与静态片段重复" "watch.servers 与 dnschain-split.conf 无交集"
	else
		emit 18 FAIL "观测域名不与静态片段重复" "${dup_n} 个观测域名同时出现在静态片段里，改道会变成随机走一条"
	fi

	# 19. 改道通道（servers-file）已就绪
	#
	# 只设了 UCI 不等于生效：要同时满足三件事。
	#
	# ⚠️ 判据不能只看进程 argv 里有没有 `--servers-file`（v0.13.0 实测修正）：
	#   OpenWrt 的 init.d/dnsmasq 是 `append_parm "$cfg" "serversfile"
	#   "--servers-file"`，它把这个选项写进**生成的配置文件**
	#   （/var/etc/dnsmasq.conf.*），而不是放在命令行上。
	#   实测 dnsmasq 的 cmdline 只有：
	#     /usr/sbin/dnsmasq -C /var/etc/dnsmasq.conf.cfg01411c -k -x ...
	#   而 `servers-file=` 出现在该配置文件的第 21 行。
	#   按 argv 判定会**永远 FAIL**，而通道其实是好的。
	#
	# 三条判据：
	#   a) UCI 配了路径
	#   b) 文件存在且 dnsmasq 能读到（ujail 挂载 + 权限）
	#   c) 生效的 dnsmasq 配置文件里真有 servers-file 指向它
	local sf_uci sf_conf sf_ok
	sf_uci=$(uci -q get dhcp.@dnsmasq[0].serversfile 2>/dev/null)
	if [ -z "$sf_uci" ]; then
		emit 19 FAIL "改道通道已就绪" "dhcp.@dnsmasq[0].serversfile 未设置，改道无法生效"
	elif [ ! -r "$sf_uci" ]; then
		emit 19 FAIL "改道通道已就绪" "serversfile=${sf_uci} 但文件不存在"
	else
		sf_ok=0
		# c) 生效的配置文件里有没有指向它的 servers-file
		for sf_conf in /var/etc/dnsmasq.conf.*; do
			[ -r "$sf_conf" ] || continue
			if grep -q "^servers-file=${sf_uci}$" "$sf_conf" 2>/dev/null; then
				sf_ok=1
				break
			fi
		done

		# b2) ujail 是否允许 dnsmasq 读这个目录
		#
		# dnsmasq 由 ujail 降权到 uid 453 运行，只能看到 init 脚本里
		# `procd_add_jail_mount` 声明过的路径。servers-file 指向白名单
		# 之外的目录时**既不报错也不生效** —— 这是最隐蔽的一种失效。
		local dpid jail_ok jail_dir
		dpid=$(dc_dnsmasq_pid)
		jail_ok=0
		jail_dir=$(dirname "$sf_uci")
		if [ -n "$dpid" ]; then
			local ppid
			ppid=$(awk '/^PPid:/ { print $2 }' "/proc/${dpid}/status" 2>/dev/null)
			if [ -n "$ppid" ] && [ -r "/proc/${ppid}/cmdline" ]; then
				# ujail 的挂载参数形如 `-r <path>` / `-w <path>`，
				# 而 init.d/dnsmasq 里写的是 `procd_add_jail_mount_rw
				# /var/run/dnsmasq/ $leasefile` —— **带尾斜杠**。
				# 故比较时两侧都去掉尾斜杠再比，否则永远匹配不上
				# （实测：dirname 给出 /var/run/dnsmasq，而白名单里是
				#  /var/run/dnsmasq/，直接 grep -qxF 会漏）。
				local jd
				while IFS= read -r jd; do
					jd=$(echo "$jd" | sed 's:/*$::')
					[ "$jd" = "$jail_dir" ] && { jail_ok=1; break; }
				done <<EOF
$(tr '\0' '\n' < "/proc/${ppid}/cmdline" 2>/dev/null)
EOF
			else
				# 没有 ujail 包装（或读不到父进程）时视为不受限
				jail_ok=1
			fi
		fi

		if [ "$sf_ok" = "1" ] && [ "$jail_ok" = "1" ]; then
			emit 19 PASS "改道通道已就绪" \
				"servers-file=${sf_uci}（已进 dnsmasq 配置，且在 ujail 白名单内）"
		elif [ "$sf_ok" != "1" ]; then
			emit 19 FAIL "改道通道已就绪" \
				"UCI 配了 ${sf_uci}，但生效的 dnsmasq 配置里没有 servers-file（需重启 dnsmasq）"
		else
			emit 19 FAIL "改道通道已就绪" \
				"servers-file=${sf_uci} 所在目录 ${jail_dir} 不在 ujail 白名单内（dnsmasq 读不到，改道会静默失效）"
		fi
	fi

	# 20. 健康状态自洽：已改道的域名必须有原因记录
	#
	# 状态文件是「页面显示」与「实际生效」的接合处。若 active 与 pref
	# 不同却没有 switch:/fallback: 记录，说明有人手工改过状态文件，
	# 或写入被打断 —— 两种情况都该被看见。
	local st_bad st_total st_line st_d st_pref st_act st_res
	st_bad=0
	st_total=0
	while read -r st_line; do
		[ -n "$st_line" ] || continue
		st_total=$((st_total + 1))
		st_d=$(echo "$st_line" | awk -F'|' '{print $1}')
		st_pref=$(echo "$st_line" | awk -F'|' '{print $2}')
		st_act=$(echo "$st_line" | awk -F'|' '{print $3}')
		st_res=$(echo "$st_line" | awk -F'|' '{print $7}')
		if [ "$st_act" != "$st_pref" ]; then
			case "$st_res" in
				switch:*|fallback:*|recover-wait:*) : ;;
				*) st_bad=$((st_bad + 1)) ;;
			esac
		fi
	done <<-EOF
		$(dc_health_state_dump)
	EOF

	if [ "$st_total" -eq 0 ]; then
		emit 20 SKIP "改道状态自洽" "还没有探测数据（等一轮 interval 或从页面手动触发）"
	elif [ "$st_bad" -eq 0 ]; then
		emit 20 PASS "改道状态自洽" "${st_total} 条状态，改道项均有原因记录"
	else
		emit 20 FAIL "改道状态自洽" "${st_bad} 条状态显示已改道但无原因记录"
	fi
}

# ------------------------------------------------------------
# 入口
# ------------------------------------------------------------
main() {
	local verbose use_cache cache_file cache_ttl now age
	verbose=0
	[ "$1" = "-v" ] && verbose=1

	# ---- 结果缓存（v0.14.1）--------------------------------------
	#
	# 为什么加：自检 20 项里有 4 处真实 DNS 查询，实测 3.5 秒。
	# 而页面的「当前状态」结论与「自检」tab 都要读它 ——
	# 每刷新一次页面就跑一遍完整自检，用户感知就是「切换页面很慢」。
	#
	# 语义取舍：自检是**诊断快照**，不是实时监控。60 秒内的结果
	# 完全够用（链路故障的判定阈值本身是 2 轮 x 60 秒）。
	# 页面上的「立即重新自检」按钮传 -f 强制刷新。
	#
	# 失效指纹含关键状态（端口占用、ss_spec、框架开关），
	# 任一变化即重跑 —— 避免「改了配置但缓存还是旧的」。
	cache_file="/var/run/dnschain/selftest.cache"
	cache_ttl=60
	use_cache=1
	case "$1" in
		-f|--force) use_cache=0 ;;
	esac

	if [ "$use_cache" = "1" ] && [ -r "$cache_file" ]; then
		# ⚠️ BusyBox 没有 stat 命令（实测 ash: stat: not found），
		#    旧写法 `age=$(stat -c %Y ...)` 恒为空 → 缓存永不命中。
		#    改用 `date -r <file> +%s`（BusyBox 的 date 支持 -r）。
		now=$(date +%s 2>/dev/null || echo 0)
		age=$(date -r "$cache_file" +%s 2>/dev/null || echo 0)
		if [ "$now" -gt 0 ] && [ "$age" -gt 0 ] && [ $((now - age)) -lt "$cache_ttl" ]; then
			local fp_now fp_cached
			fp_now=$(selftest_fingerprint)
			fp_cached=$(sed -n '1s/^#FP=//p' "$cache_file" 2>/dev/null)
			if [ "$fp_now" = "$fp_cached" ]; then
				sed -n '2,$p' "$cache_file"
				return 0
			fi
		fi
	fi

	# 捕获一次输出：既打 stdout，也用于写缓存（不重复跑 check_all）
	#
	# ⚠️ check_all 只输出 20 个检查项，**不含 SUMMARY 行** ——
	#    SUMMARY 原本是 main 在这里单独 printf 的。
	#    改成捕获变量后若不补回，SUMMARY 会彻底消失，
	#    而验收脚本/页面都靠 `grep '^SUMMARY'` 判定结果
	#    （实测踩过：验收脚本报「自检有失败: 」（空值））。
	_DC_BODY=$(check_all 2>&1)

	# ⚠️ PASS_CNT / FAIL_CNT 是 check_all 内部的计数变量，
	#    它跑在 $( ) 子 shell 里 → 父 shell 读到的是 0。
	#    必须从捕获的输出里重新统计（每个检查项一行 "N PASS|FAIL|SKIP"）。
	#
	#    这段必须在**打印之前**完成，否则 SUMMARY 会印出全 0
	#    （实测踩过：SUMMARY PASS=0 FAIL=0，验收脚本判不出结果）。
	local _fail_n _pass_n _skip_n
	_fail_n=$(printf '%s\n' "$_DC_BODY" | grep -cE '^[0-9]+ FAIL')
	_pass_n=$(printf '%s\n' "$_DC_BODY" | grep -cE '^[0-9]+ PASS')
	_skip_n=$(printf '%s\n' "$_DC_BODY" | grep -cE '^[0-9]+ SKIP')
	[ -n "$_fail_n" ] || _fail_n=0
	[ -n "$_pass_n" ] || _pass_n=0
	[ -n "$_skip_n" ] || _skip_n=0
	_DC_SUM="SUMMARY PASS=${_pass_n} FAIL=${_fail_n} SKIP=${_skip_n}"

	printf '%s\n' "$_DC_BODY"
	echo ""
	printf '%s\n' "$_DC_SUM"

	# 落盘（供缓存）：检查项 + SUMMARY + 结论
	{
		printf '%s\n' "$_DC_BODY"
		printf '%s\n' "$_DC_SUM"
		:
	} > /tmp/.dc-selftest.out 2>/dev/null

	if [ "$_fail_n" -gt 0 ] 2>/dev/null; then
		local concl
		concl=""
		[ "$(dns_class www.baidu.com "$(lan_addr)")" = "OK" ] || concl="${concl}国内解析异常 "
		[ -z "$(dc_port_owner "$(dc_get main entry_port 5353)" udp)" ] \
			&& concl="${concl}dnsproxy 未监听（客户机全部无法解析） "
		if [ -n "$concl" ]; then
			echo "CONCLUSION: ${concl}"
			printf 'CONCLUSION: %s\n' "$concl" >> /tmp/.dc-selftest.out 2>/dev/null
		fi
		_dc_write_cache "$cache_file"
		return 1
	fi

	echo "CONCLUSION: 链路正常"
	printf 'CONCLUSION: %s\n' "链路正常" >> /tmp/.dc-selftest.out 2>/dev/null
	_dc_write_cache "$cache_file"
	return 0
}

# ---- 缓存写入 ----------------------------------------------------
#
# 用「先写 .new 再原子 mv」，避免并发读到半个文件。
#
# 注意：这里把 check_all 的输出重新捕获一次不现实（已经打到 stdout），
# 故改由 main 在开始时把 stdout 重定向到临时文件（见 _dc_cache_capture）。
_dc_write_cache() {
	local cf
	cf="$1"
	[ -n "$cf" ] || return 0
	[ -f /tmp/.dc-selftest.out ] || return 0
	{
		printf '#FP=%s\n' "$(selftest_fingerprint)"
		cat /tmp/.dc-selftest.out
		:
	} > "${cf}.new" 2>/dev/null
	if [ -f "${cf}.new" ]; then
		mv -f "${cf}.new" "$cf" 2>/dev/null
	fi
	rm -f /tmp/.dc-selftest.out 2>/dev/null
}

# 缓存失效指纹：把「会影响结论的关键状态」压成一个短串。
# 只放廉价可得的量（不触发网络查询），否则算指纹本身就慢了。
selftest_fingerprint() {
	local e f
	e=$(dc_get main entry_port 5353)
	f=$(dc_get main foreign_port 5336)

	# ⚠️ 指纹必须覆盖「会影响结论」的每一项（v0.14.2 补全）。
	#
	#   原先只含端口/进程/ss_spec/开关。实测漏了三类，症状都是
	#   「改完配置看自检，60 秒内还是旧结论」，用户以为改动没生效：
	#
	#     · filter_aaaa / ipv6_support → 影响第 7/8/11 项
	#     · gfw_list.conf 行数         → 影响第 2/12 项
	#     · 上游 server 列表            → 影响第 10 项（污染值判定）
	#
	#   代价：每次多 3 个 uci get + 1 次 wc -l（约 15ms），
	#   相对于缓存省下的 3.5 秒可以忽略。
	local aaaa v6 n_gfw up
	aaaa=$(uci -q get dhcp.@dnsmasq[0].filter_aaaa 2>/dev/null)
	v6=$(uci -q get shadowsocksr.@global[0].ipv6_support 2>/dev/null)
	n_gfw=$(wc -l < /etc/ssrplus/gfw_list.conf 2>/dev/null || echo 0)
	# 上游列表只取「两条链的条数 + 各自首项」——
	# 完整串太长，而条数/首项变化已能覆盖「换了一组上游」这类改动。
	#
	# ⚠️ UCI section 名是 cn / foreign，**不是** upstream（v0.14.2 实测）：
	#    配置文件里是 `config upstream 'cn'` 与 `config upstream 'foreign'`，
	#    即类型是 upstream、名字是 cn/foreign。写成 `dc_get_list upstream server`
	#    会返回空（把它当 section 名查），指纹里那段就恒为 "0/"，
	#    等于上游变化完全检测不到。
	up="$(dc_get_list cn server 2>/dev/null | wc -l)/$(dc_get_list cn server 2>/dev/null | head -1)/$(dc_get_list foreign server 2>/dev/null | wc -l)/$(dc_get_list foreign server 2>/dev/null | head -1)"

	printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s' \
		"$e" "$f" \
		"$(dc_port_owner "$e" udp)" \
		"$(dc_port_owner "$f" udp)" \
		"$(dc_port_listening 1234 tcp && echo 1 || echo 0)" \
		"$(dc_ss_spec_present && echo 1 || echo 0)" \
		"$(dc_get main enabled 1)" \
		"$aaaa" "$v6" "$n_gfw/$up"
}

main "$@"
