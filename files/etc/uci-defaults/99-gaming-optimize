#!/bin/sh
# ============================================================
# 99-gaming-optimize — OpenWrt FPS 游戏网络优化 (first-boot UCI defaults)
# ============================================================
# IPv4/IPv6 双栈 FPS 优化版本 (CS2/Steam 适配)
# - IPv4: NAT + fullcone + flow_offload + AliDNS DoH
# - IPv6: DHCPv6-PD (/56 前缀委派) + DHCPv6/SLAAC 混合 + 无 NAT
# - conntrack: sysctl UDP 超时 30s, max 131072 (见 sysctl.conf)
# ============================================================

. /lib/functions.sh

log() { echo "[gaming-optimize] $*"; }

log "Applying gaming network optimization (dual-stack)..."

# ─────────────────────────────────────────────
# 1. 防火墙优化
# ─────────────────────────────────────────────

uci set firewall.@defaults[0].flow_offloading='1'
uci set firewall.@defaults[0].flow_offloading_hw='0'
uci set firewall.@defaults[0].fullcone='1'
uci set firewall.@defaults[0].drop_invalid='1'
uci set firewall.@zone[0].mtu_fix='1'

# turboacc 的 tcpcca 必须与 sysctl.conf 的 bbr 一致。
#
# 【2026-10-09 刷机实测】内核从 6.12.107 升到 6.18.55 后，出现**两个**覆盖者：
#
# 覆盖者 1 —— turboacc 包自带的 uci-defaults（/rom/etc/uci-defaults/turboacc）：
#   它的执行顺序在本脚本**之后**（uci-defaults 按文件名排序，'9' < 't'），
#   且其逻辑是 `cat > /etc/config/turboacc` **整体重写**该配置文件，
#   把 tcpcca 写回 'cubic'。因此单靠下面第 34 行的 uci set 会被它抹掉。
#   对策：先设 turboacc.global.set='1' —— 该脚本首行有守卫
#   `[ "$(uci -q get "turboacc.global.set")" -eq "1" ] && exit 0`，
#   使其直接退出、不再重写配置。这是利用上游自身的幂等开关，无需改上游包。
#
# 覆盖者 2 —— /etc/init.d/firewall（START=19）新增的 apply_tcpcca_section()：
#   它读 firewall.@defaults[0].tcpcca（默认 'cubic'）并 sysctl -w 覆盖，
#   在 fw4 restart/reload/start 时都会跑。故须同时设该 UCI 键。
#
# 作用域仅限路由器自身发起的 TCP（dnsproxy 的 DoH、代理隧道、opkg），
# 不影响转发的客户端流量。
uci set turboacc.global.set='1'
uci set turboacc.config.tcpcca='bbr'
uci set firewall.@defaults[0].tcpcca='bbr'
uci -q set turboacc.config.fastpath='flow_offloading'
uci -q set turboacc.config.fastpath_fo_hw='0'
uci -q set turboacc.config.fullcone='1'

# 与第 2 节删除 network.wan6 配套：从 wan zone 的网络列表移除 wan6，
# 否则 fw3 会引用一个不存在的接口。del_list 对不存在的项是 no-op，幂等。
uci -q del_list firewall.@zone[1].network='wan6'

# ICMPv6 Input (PMTU discovery — 游戏关键)
#
# 【2026-10-17 修复幂等性】原写法是裸 `uci add firewall rule`，每执行一次
#   uci-defaults 就多一条同名规则。实测：连续跑三次后 `firewall` 里出现
#   3 × ICMPv6-Input + 3 × ICMPv6-Forward。uci-defaults 正常只在首启执行一次，
#   但脚本可能被手工重跑（排查、迁移），重复规则会让同一条 ICMPv6 报文被
#   accept 多次、并让 `uci show firewall` 的索引漂移（按 @rule[N] 定位会错位）。
#
# 修法：先记录「该 name 是否已存在」，已存在则就地改写那条、不再新增。
#   这样脚本可任意次重跑，结果恒为「每样恰好一条」。
_fw_rule_index() {
	local want="$1" i=0
	while uci -q get "firewall.@rule[$i]" >/dev/null 2>&1; do
		if [ "$(uci -q get "firewall.@rule[$i].name")" = "$want" ]; then
			echo "@rule[$i]"
			return 0
		fi
		i=$((i + 1))
	done
	return 1
}

if _idx=$(_fw_rule_index 'ICMPv6-Input'); then
	R="firewall.$_idx"
	log "firewall: 复用已有 ICMPv6-Input（$_idx），不重复新增"
else
	uci add firewall rule >/dev/null
	R='firewall.@rule[-1]'
fi
# 注意：用 `uci set "$R.name=值"` 时**不要**在值两侧再加单引号 ——
#   uci 会把单引号当成值的一部分存进去，实测存成 `name='ICMPv6-Input'`
#   （值里含字面单引号），导致按 name 精确匹配永远失败、规则无限重复。
uci set "$R.name=ICMPv6-Input"
uci set "$R.src=wan"
uci set "$R.proto=icmp"
uci set "$R.family=ipv6"
uci -q delete "$R.icmp_type"
for t in echo-request echo-reply destination-unreachable packet-too-big \
         time-exceeded parameter-problem router-solicitation \
         neighbour-solicitation router-advertisement neighbour-advertisement; do
    uci add_list "$R.icmp_type=$t"
done
uci set "$R.limit=1000/sec"
uci set "$R.target=ACCEPT"

# ICMPv6 Forward (客户端 PMTU 发现)
if _idx=$(_fw_rule_index 'ICMPv6-Forward'); then
	R="firewall.$_idx"
	log "firewall: 复用已有 ICMPv6-Forward（$_idx），不重复新增"
else
	uci add firewall rule >/dev/null
	R='firewall.@rule[-1]'
fi
uci set "$R.name=ICMPv6-Forward"
uci set "$R.src=wan"
uci set "$R.dest=lan"
uci set "$R.proto=icmp"
uci set "$R.family=ipv6"
uci set "$R.target=ACCEPT"

log "firewall: flow_offloading fullcone drop_invalid mtu_fix icmpv6"

# ─────────────────────────────────────────────
# IPv6 TCP MSS clamping：**已移除**（2026-10-10）
# ─────────────────────────────────────────────
# 历史上这里向 /etc/firewall.user 追加 ip6tables 规则（fw3 时代），后来改为写
# /etc/nftables.d/10-mss-clamp.nft（fw4 时代）。**两个版本都已删除**，原因：
#
# 1) 功能本就冗余。上面第 25 行的 `firewall.@zone[0].mtu_fix='1'`（配合 wan zone
#    默认的 mtu_fix=1）会让 fw4 原生生成 4 条 MSS clamp 规则 ——
#    实测 `nft list table inet fw4` 中：
#       oifname "br-lan"    ... maxseg size set rt mtu  (!fw4: Zone lan egress)
#       oifname "pppoe-wan" ... maxseg size set rt mtu  (!fw4: Zone wan egress)
#       iifname "br-lan"    ... maxseg size set rt mtu  (!fw4: Zone lan ingress)
#       iifname "pppoe-wan" ... maxseg size set rt mtu  (!fw4: Zone wan ingress)
#    它们用 `rt mtu`，在 PPPoE（1492）场景下与显式 clamp 等价，且同时覆盖
#    IPv4 与 IPv6。删掉本段不损失任何功能。
# 2) fw3 路径是死代码。fw4 **不加载** /etc/firewall.user
#    （`uci show firewall` 中 firewall.user include 计数 = 0），
#    故那段 ip6tables 规则从未生效。
# 3) fw4 路径曾造成**严重故障**。要点在于 include 的语义：
#      /usr/share/firewall4/templates/ruleset.uc 第 15 行 `table inet fw4 {` 开表，
#      第 104 行 `include "/etc/nftables.d/*.nft"` —— include 在**该 table 内部**。
#    所以 /etc/nftables.d/ 下的文件只能是**裸 chain**；写成
#      `table inet mssclamp { chain ... }`
#    会形成嵌套 table → nft 语法错误。而 fw4 的加载路径是
#      `print | nft -c -f $STDIN || die "The rendered ruleset contains errors"`
#    —— 校验失败则**整个 ruleset 不加载**，input/forward/dstnat/srcnat、DNS 拦截、
#    透明代理全部规则消失，表现为国内域名大面积无法解析与联网。
#    已在路由器上复现：含该文件时 `fw4 check` 报
#      `Error: syntax error, unexpected table`
#    改为裸 chain 后恢复 `Ruleset passes nftables check.`。
#    同目录既有文件 10-dnsproxy-lan-intercept.nft 用的是正确的裸 chain 写法。
#
# 结论：既然功能冗余、fw3 路径无效、fw4 路径有风险，直接删除是最优解。
# 若日后确需显式 clamp，必须写成**裸 chain**，并在写入后调用
# `fw4 check` 自检（失败即删除该文件），切勿再写 table 声明。

# ─────────────────────────────────────────────
# 2. IPv6 双栈: DHCPv6-PD over PPPoE
# ─────────────────────────────────────────────
# PPPoE 拨号时 IPv6CP 协商链路层地址
# wan_6: dhcpv6c 从 ISP 获取全球地址 + /56 前缀委派 (DHCPv6-PD)
# LAN: 从 /56 获取 /64 子网, DHCPv6 + SLAAC 混合模式
uci set network.wan.ipv6='1'
uci set network.lan.ipv6='1'
uci set network.lan.ip6assign='64'

# LAN 固定 IP：固化为 192.168.3.254，使**全新刷机（不保留配置）**也保持可达。
# 背景：本仓库此前从未设置 network.lan.ipaddr，而 /bin/config_generate 第 165 行
#   对 lan 的默认值是硬编码的 192.168.1.1（board.json 的 network.lan 不含 ipaddr）。
#   因此旧行为是：保留配置刷机 → 沿用旧 IP；全新刷机 → 回退 192.168.1.1，
#   若客户端仍按 192.168.3.254 访问就会失联。
# 注意：ipaddr 变更属于会中断网络的操作（需 /etc/init.d/network reload 或重启）。
#   本脚本只在首次开机（uci-defaults 一次性执行）时生效，不影响已运行的路由器。
uci set network.lan.ipaddr='192.168.3.254'
uci set network.lan.netmask='255.255.255.0'
uci set network.lan.proto='static'
uci set network.lan.device='br-lan'

# wan6: OpenWrt 默认的 dhcpv6 接口（device=eth1），本固件不使用。
# 实测(2026-10-09)：它只跑一个 -P0 的 odhcp6c，不申请前缀，eth1 上无全局
# 地址、日志零输出，属纯空转；而 ISP 的 IPv6 实际经 PPPoE 由 wan_6 获取。
# 不删除会同时存在两个 dhcpv6 客户端（两个 odhcp6c 进程）。
uci delete network.wan6 2>/dev/null

# wan_6: DHCPv6 客户端 (挂载到 PPPoE wan)
uci delete network.wan_6 2>/dev/null
uci set network.wan_6='interface'
uci set network.wan_6.proto='dhcpv6'
uci set network.wan_6.device='@wan'
uci set network.wan_6.reqaddress='try'
uci set network.wan_6.reqprefix='56'
uci set network.wan_6.norelease='1'

uci delete network.globals.ula_prefix 2>/dev/null

# 确保 PPPoE 启用 IPv6CP
grep -q '+ipv6' /etc/ppp/options 2>/dev/null || echo '+ipv6' >> /etc/ppp/options

log "network: lan=192.168.3.254/24, wan_6=dhcpv6c+PD(/56), lan=/64, ip6assign"

# ─────────────────────────────────────────────
# 3. IPv6 纯 SLAAC 模式 (最快获取速度)
# ─────────────────────────────────────────────
# DHCP 分工: dnsmasq(DHCPv4) + odhcpd(RA+RDNSS)
# maindhcp=0: 关键! 设1会导致dnsmasq关闭DHCPv4
# 因为init script检测到maindhcp=1时设置DNSMASQ_DHCP_VER=0
uci set dhcp.odhcpd.maindhcp='0'

# LAN: 纯 SLAAC (无 DHCPv6 开销, 最快 ~1s 获取地址)
# RDNSS 在 RA 中直接提供 DNS, 无需 DHCPv6
# dhcpv6=disabled → M=0 O=1, 客户端 SLAAC 获取地址
# ndp=disabled → 内核处理 NDP, 减少 odhcpd 处理延迟
# ra_mtu=1492: 通告 PPPoE 链路的真实 MTU，与 IPv4 侧一致。
#   原值 1452 的推导「1492 - 40」错把 IPv6 基本头（40B）当成要从 MTU 中
#   预先扣除的封装开销——IPv6 头是报文本身的一部分，不占链路 MTU 之外。
#   预先扣 40 字节只会让每个 IPv6 包少用 40 字节载荷，多付分段/开销。
#   PMTU 发现由 ICMPv6 packet-too-big + MSS clamp 覆盖，无需预扣。
uci set dhcp.lan.ra='server'
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ndp='disabled'
uci set dhcp.lan.ra_management='0'
uci set dhcp.lan.ra_default='1'
uci set dhcp.lan.master='1'
uci set dhcp.lan.ra_mtu='1492'
uci set dhcp.lan.ra_mininterval='20'
uci set dhcp.lan.ra_maxinterval='60'

# 禁用路由器侧 DAD (无其他路由器在 LAN, 安全)
sysctl -w net.ipv6.conf.br-lan.dad_transmits=0 2>/dev/null
sysctl -w net.ipv6.conf.br-lan.accept_dad=0 2>/dev/null

log "dhcp: dnsmasq(DHCPv4) + odhcpd(SLAAC+RA), pure SLAAC, RA 20-60s"

# ─────────────────────────────────────────────
# 4. ALL_DOH: dnsproxy 加密 DNS 主链 (替代 https-dns-proxy)
#    链路: LAN → dnsmasq:53 → dnsproxy:5353 → DoH/DoT → Internet
#    dnsproxy 默认配置由 /etc/config/dnsproxy (files overlay) 提供
# ─────────────────────────────────────────────
# 彻底清理 https-dns-proxy（含升级残留），仅保留 dnsproxy 加密方案
# 直接删除配置文件（uci delete <config>.… 无法可靠删除整个 config 文件）
rm -f /etc/config/https-dns-proxy

# 兼容旧版 dnsproxy 配置迁移（ImmortalWrt 上游迁移脚本逻辑）
uci -q delete dnsproxy.global.all_servers
uci -q delete dnsproxy.global.fastest_addr

# 确保 ALL_DOH 默认开启 + 拦截所有客户端 DNS 默认 ON (LUCI「拦截所有客户端 DNS」)
uci set dnsproxy.global.enabled='1'
uci set dnsproxy.global.lan_dns_intercept='1'

log "dnsproxy: ALL_DOH (DoH upstream, lan_dns_intercept=ON)"
# v0.3.4 注：上游清单与 fallback 见 files/etc/config/dnsproxy
# （doh.pub 域名型单点 → 1.12.12.12 IP 直连；fallback 删 8.8.8.8，SSR 重建窗口不再刷 ERROR）

# ─────────────────────────────────────────────
# 4.5 SSR-Plus: 启用 MosDNS(5335) 作为国外 DNS（经代理 DoH，防污染）
#    链路: dnsproxy 对国外域名(google 等)显式分流 → 127.0.0.1:5335
#    → SSR-Plus MosDNS → 国外 DoH(经 TPROXY 代理) → 真实 IP
# ─────────────────────────────────────────────
# 【2026-10-09 刷机实测修正 — 本节曾整体失效】
#
# 症状：v0.4.x 刷机后 `tunnel_forward_mosdns` 是包默认的
#   'tcp://8.8.4.4:53,tcp://8.8.8.8:53'，`pdnsd_enable`/`filter_aaaa` 也没被本脚本
#   写入（pdnsd_enable 最终为 4 只是 LuCI 页面的遗留值）。
#
# 根因（非 LuCI 覆盖，实测推翻该假设）：
#   1. uci-defaults 按**文件名排序**执行，本脚本（'9'）先于 luci-ssr-plus（'l'）。
#   2. 此刻 /etc/config/shadowsocksr 仍由 opkg conffile 提供，实测为 **0 字节**
#      （`wc -c /rom/etc/config/shadowsocksr` = 0）。base-files 虽在
#      /lib/upgrade/keep.d 里保留整个 /etc/config/，但首次刷机时该文件尚无内容。
#   3. 空配置下 `uci set shadowsocksr.@global[0].<k>=<v>` 会**失败**，实测
#      `uci: Invalid argument` + `Entry not found`，退出码 1。
#      所以本节原来的三条 `uci set shadowsocksr.@global[0].*` 全部静默丢弃。
#   4. 之后 luci-ssr-plus 检测到空配置，执行
#      `[ -s /etc/config/shadowsocksr ] || /etc/init.d/shadowsocksr reset`，
#      用 /usr/share/shadowsocksr/shadowsocksr.config 模板铺底 —— 该模板
#      **不含** tunnel_forward_mosdns（只有旧的 tunnel_forward '8.8.4.4:53'），
#      故 LuCI 读取时回落到 client.lua 的 o.default。
#
#   对策：**不能**简单地在写前 `uci add shadowsocksr global` 抢先建段 ——
#   那会让文件提前变非空，导致紧随其后的 luci-ssr-plus 里
#     `[ -s /etc/config/shadowsocksr ] || /etc/init.d/shadowsocksr reset`
#   跳过 reset，结果是只有 global 一个段、缺 server_subscribe / access_control /
#   socks5_proxy / http_proxy / server_global / global_xray_fragment /
#   clash_client_group 共 7 个段（实测该分支下对 @server_subscribe[0] 的写入
#   直接失败，退出码 1）。
#
#   正确做法：**主动先跑一次模板铺底**，使其与 luci-ssr-plus 的行为一致，
#   然后在其之上写入本节的值。判据是「当前配置是否为空」，与 luci-ssr-plus 同源：
#   文件为空时必须铺底；非空（升级/保留配置）则保持不动。
#   幂等：铺底只在空文件时发生一次；luci-ssr-plus 稍后再判时文件已非空，
#   其 reset 自然不触发，而模板内容已与它将要生成的一致。
if [ ! -s /etc/config/shadowsocksr ]; then
	/etc/init.d/shadowsocksr reset 2>/dev/null
	log "ssr-plus: 空配置 → 已用 shadowsocksr.config 模板铺底（与 luci-ssr-plus 行为一致）"
fi

uci -q get shadowsocksr.@global[0] >/dev/null 2>&1 || uci add shadowsocksr global

# pdnsd_enable=4 = mosdns 模式（SSR-Plus init 逻辑 dns_mode=4）
# tunnel_forward_mosdns: MosDNS 的国外 DoH 上游（逗号分隔，走 SSR-Plus 代理）
# 由 3 个收敛为 2 个：去掉 dns.quad9.net。三个上游以 concurrent 竞速取最快，
# 而 quad9 从国内经代理访问的响应明显慢于 google/cloudflare，参与竞速只增加
# 方差、不增加可用性（另两个互为冗余）。保留 concurrent 以获韧性。
# 使用显式失败日志，避免同类静默丢弃再次发生（红线 3：禁止静默失败）。
uci set shadowsocksr.@global[0].pdnsd_enable='4' \
	|| log "ERROR: 写入 shadowsocksr.@global[0].pdnsd_enable 失败"
uci set shadowsocksr.@global[0].tunnel_forward_mosdns='https://dns.google/dns-query,https://cloudflare-dns.com/dns-query' \
	|| log "ERROR: 写入 shadowsocksr.@global[0].tunnel_forward_mosdns 失败"

log "ssr-plus: MosDNS(5335) enabled, foreign DoH via proxy"

# ─────────────────────────────────────────────
# 4.6 SSR-Plus: 关闭自动切换（v0.8.1）
# ─────────────────────────────────────────────
# `enable_switch='1'` 会让 `ssr-switch` 每 `switch_time` 秒（本机 667s）探测一次
# 当前节点，探测失败就调 `/etc/init.d/shadowsocksr restart`（ssr-switch 第 155 行）。
# 该 restart 是**周期性 DNS 故障源**，实测链路：
#
#   1. `start()` 先 `start_rules` + `gfw2ipset`，把 gfw_list.conf（23701 条
#      `server=/域名/127.0.0.1#5335`）拷进 dnsmasq 的 conf-dir —— 此刻分流已生效；
#   2. 约 2 秒后才轮到 `start_dns`/`start_server` 拉起 MosDNS 与 Xray；
#   3. 于是存在约 4 秒的窗口：**分流已指向 :5335，但 :5335 尚无人监听**。
#      实测时间线（0.5 秒粒度）：
#        21:39:35  gs=cfg014a8f  5335=0  1234=1  nft=0  gfw=23701   ← 危险窗口
#        21:39:37  gs=cfg014a8f  5335=1  1234=1  nft=2  gfw=23701   ← 才就绪
#      该窗口内查任何 gfw_list 里的域名都会 timeout。
#
# 更糟的是探测本身容易误判：`switch_time=3` 是 **curl 超时**，
# 而跨境节点的 TLS 握手常超过 3 秒；探测失败且全部候选节点都判失败时，
# `select_proxy` 返回 `ENABLE_SERVER=nil`，`switch_proxy` 便
# `uci set global_server=nil` —— 界面显示「已启用」，但 `load_config()` 会
# `return 1`，一条规则都不装，进入「已启用但空转」的半死状态
# （实测出现过多次：`enable=1` 而 `global_server=nil`、无 ss_spec 表）。
#
# 结论：单节点家用场景不需要自动切换，它的收益远小于周期性中断的代价。
# 关闭后 `start_switch()` 的那个 `if` 不成立，守护不再启动，重启只在
# 手动操作或开机时发生。
#
# 【若日后确实需要多节点自动切换】必须同时做到：
#   a) 把 `switch_time`（探测超时）调到 ≥ 10s，避免跨境握手误判；
#   b) 让 `switch_proxy` 在全部节点失败时**保留原 `global_server`**，
#      而不是写 nil（否则会从「代理慢」恶化成「完全无规则」）；
#   c) 修 `start()` 的顺序，使后端就绪后再装分流（见 AGENTS.md §4）。
uci set shadowsocksr.@global[0].enable_switch='0' \
	|| log "ERROR: 写入 shadowsocksr.@global[0].enable_switch 失败"

log "ssr-plus: enable_switch=0 (避免 ssr-switch 周期性 restart 造成 DNS 空窗)"

# ─────────────────────────────────────────────
# 4.7 SSR-Plus: 给 ssr-switch 打 nil 防护补丁（v0.8.2）
# ─────────────────────────────────────────────
# 关闭 enable_switch 只让守护**不再启动**，并不能约束已经在跑的守护，
# 也无法修复 `set_main_server()` 本身的缺陷。实测（监控日志）：
#
#   22:02:31 *** gs=cfg014a8f → cfg194a8f   ← 被自动切到另一个节点
#   22:04:09 *** gs=cfg194a8f → nil          ← 再切成 nil，客户机全挂
#
# 根因在 `/usr/bin/ssr-switch` 的 `set_main_server()`：
#   原实现只判空串 `[ -n "$sid" ] || return 1`，
#   而 `select_proxy()` 失败时把 `ENABLE_SERVER` 置为**字符串 `"nil"`**
#   （不是空串），于是 `set_main_server "nil"` 能顺利通过检查并
#   `uci set global_server=nil` 落盘。
#
# 后果：`load_config()` 见 `GLOBAL_SERVER=nil` 直接 `return 1`，
# 一条 nft 规则都不装、MosDNS/Xray 全不启动，但 Lua 界面 `enable=1`
# 仍显示「运行中」—— 客户机 DNS 全部 timeout，路由器自身却因走
# `/etc/resolv.conf` 的运营商 DNS 而显得正常。
#
# 打两处补丁（幂等，打前先查标记）：
#   a) `set_main_server()` 显式拒绝 `"nil"`；
#   b) `run_once()` 的 else 分支不再盲写 `CURRENT_SERVER`，
#      改成「保留原节点只重启」，避免从「代理慢」恶化成「完全无规则」。
SSR_SWITCH=/usr/bin/ssr-switch
if [ -f "$SSR_SWITCH" ] && ! grep -q '修复 v0.8.2' "$SSR_SWITCH"; then
	cp "$SSR_SWITCH" "${SSR_SWITCH}.orig"

	# (a) 在 `[ -n "$sid" ] || return 1` 之前插入 nil 拒绝
	_ln=$(grep -n '^	\[ -n "\$sid" \] || return 1$' "$SSR_SWITCH" | head -1 | cut -d: -f1)
	if [ -n "$_ln" ]; then
		{ head -n $((_ln - 1)) "$SSR_SWITCH"
		  printf '\t# [修复 v0.8.2] 拒绝把 global_server 写成 nil。\n'
		  printf '\t# nil 会让 load_config() 直接 return 1 → 界面显示已启用但一条规则都不装，\n'
		  printf '\t# 客户机全部解析超时。原代码只判空串，字符串 "nil" 能通过并落盘。\n'
		  printf '\t[ "$sid" != "nil" ] || return 1\n'
		  tail -n +"$_ln" "$SSR_SWITCH"
		} > "${SSR_SWITCH}.tmp"
		mv "${SSR_SWITCH}.tmp" "$SSR_SWITCH"
		chmod +x "$SSR_SWITCH"
		log "ssr-switch: set_main_server 已加 nil 防护"
	else
		log "ERROR: 未找到 set_main_server 的判空行，补丁 (a) 未应用"
	fi

	# (b) else 分支：全部节点失败时保留原 global_server，不写 nil
	if grep -q 'switch_proxy "\$CURRENT_SERVER"' "$SSR_SWITCH"; then
		_old='		switch_proxy "$CURRENT_SERVER"
		echolog "Try restart current server."'
		_new='		# [修复 v0.8.2] 全部候选节点探测失败时，保留原 global_server 只重启。
		# 原逻辑 switch_proxy "$CURRENT_SERVER" 在 CURRENT_SERVER=nil 时会把
		# global_server 写成 nil → 规则全撤 → 客户机全挂。
		if [ "$CURRENT_SERVER" != "nil" ] && [ -n "$CURRENT_SERVER" ]; then
			/etc/init.d/shadowsocksr restart "$CURRENT_SERVER"
		fi
		echolog "Try restart current server."'
		# 用 awk 做多行替换，避免 sed 的转义地狱
		awk -v old="$_old" -v new="$_new" "
			BEGIN { n = split(old, o, \"\n\"); m = 0; inblk = 0 }
			{
				if (!inblk && \$0 == o[1]) { buf = \$0; inblk = 1; k = 1; next }
				if (inblk) {
					k++
					buf = buf \"\n\" \$0
					if (k == n) { print new; inblk = 0 }
					next
				}
				print
			}
			END { if (inblk) print buf }
		" "$SSR_SWITCH" > "${SSR_SWITCH}.tmp" && mv "${SSR_SWITCH}.tmp" "$SSR_SWITCH"
		chmod +x "$SSR_SWITCH"
		log "ssr-switch: 全节点失败时不再写 nil"
	else
		log "ssr-switch: else 分支已是修复后的形态，跳过 (b)"
	fi

	# 语法校验：补丁写坏了必须能发现（禁止静默失败）
	if sh -n "$SSR_SWITCH"; then
		log "ssr-switch: 补丁后语法检查通过"
	else
		log "ERROR: ssr-switch 补丁后语法错误，回滚"
		cp "${SSR_SWITCH}.orig" "$SSR_SWITCH"
		chmod +x "$SSR_SWITCH"
	fi
else
	log "ssr-switch: nil 防护补丁已存在或文件缺失，跳过"
fi

# ─────────────────────────────────────────────
# 4.8 SSR-Plus: 消除 restart 期间「客户机被断两次」（v0.8.3）
# ─────────────────────────────────────────────
# `/etc/init.d/shadowsocksr` 的 `stop()`（原第 3257 行）与 `start()`
# （第 3124 行）**各自**执行一次 `/etc/init.d/dnsmasq restart`，
# 而 `restart` 由 `/etc/rc.common` 实现为 `stop + start`，于是一次 restart
# 会把 dnsmasq 重启**两次**。
#
# 实测（0.5 秒粒度记录 dnsmasq PID）：
#   修复前：22:45:18 → 22:45:21   又  22:45:32 → 22:45:35   ← 断两次
#   修复后：22:48:09 → 22:48:12                              ← 只断一次
#
# 每次 dnsmasq 不可用约 **3 秒**，期间客户机**所有**域名（含国内 baidu）
# 全部无法解析 —— 这正是用户在 LuCI 启用 SSR-Plus 后看到
# 「apple/github/google/youtube/bilibili/baidu 全部不可达」的原因。
#
# 根因是 `stop()` 先 `rm -rf dnsmasq-ssrplus.conf` 再重启 dnsmasq，
# 等于把 23928 条 `server=` 分流全撤掉；紧接着 `start()` 重建并再重启一次。
# 在 restart 场景下，`stop()` 那次重启纯属多余且有害。
#
# 修法：覆写 `restart()`，设置并导出 `SSR_IN_RESTART=1`；
# `stop()` 内那次重启改由该标志守卫，restart 时跳过。
SSR_INIT=/etc/init.d/shadowsocksr
if [ -f "$SSR_INIT" ] && ! grep -q '修复 v0.8.3' "$SSR_INIT"; then
	cp "$SSR_INIT" "${SSR_INIT}.orig"

	# (a) 覆写 restart()，插在 start() 定义之前
	_ln=$(grep -n '^start() {' "$SSR_INIT" | head -1 | cut -d: -f1)
	if [ -n "$_ln" ]; then
		{ head -n $((_ln - 1)) "$SSR_INIT"
		  printf '# [修复 v0.8.3] 覆写 rc.common 的 restart()：\n'
		  printf '# rc.common 的 restart = stop + start，而两者各重启一次 dnsmasq，\n'
		  printf '# 导致 restart 期间客户机被断两次（实测各 3 秒）。\n'
		  printf '# 这里设置 SSR_IN_RESTART=1，让 stop() 跳过它那次 dnsmasq 重启，\n'
		  printf '# 只由 start() 重启一次，客户机只断一次。\n'
		  printf 'restart() {\n'
		  printf '\tSSR_IN_RESTART=1\n'
		  printf '\texport SSR_IN_RESTART\n'
		  printf '\ttrap "" TERM\n'
		  printf '\tstop "$@"\n'
		  printf '\ttrap - TERM\n'
		  printf '\tstart "$@"\n'
		  printf '\tSSR_IN_RESTART=0\n'
		  printf '}\n'
		  printf '\n'
		  tail -n +"$_ln" "$SSR_INIT"
		} > "${SSR_INIT}.tmp"
		mv "${SSR_INIT}.tmp" "$SSR_INIT"
		chmod +x "$SSR_INIT"
		log "init.d/shadowsocksr: restart() 已覆写"
	else
		log "ERROR: 未找到 start() 定义，restart() 覆写未应用"
	fi

	# (b) stop() 内那次 dnsmasq restart 加标志守卫
	# 定位「stop() 之后的第一处 dnsmasq restart」
	_stopln=$(grep -n '^stop() {' "$SSR_INIT" | head -1 | cut -d: -f1)
	_dmln=$(awk -v s="$_stopln" 'NR > s && /etc\/init.d\/dnsmasq restart/ { print NR; exit }' "$SSR_INIT")
	if [ -n "$_dmln" ]; then
		{ head -n $((_dmln - 1)) "$SSR_INIT"
		  printf '\t\t# [修复 v0.8.3] restart 场景下跳过这次 dnsmasq 重启。\n'
		  printf '\t\t# stop 会先删掉 dnsmasq-ssrplus.conf，此时重启 dnsmasq 等于把\n'
		  printf '\t\t# 23928 条 server= 分流全撤掉，而紧接着 start 又会重建并再重启一次\n'
		  printf '\t\t# → 客户机在 restart 期间被断两次（实测各 3 秒全断）。\n'
		  printf '\t\tif [ "$SSR_IN_RESTART" = "1" ]; then\n'
		  printf '\t\t\techolog "restart: skip dnsmasq restart in stop()"\n'
		  printf '\t\telse\n'
		  printf '\t\t\t/etc/init.d/dnsmasq restart >/dev/null 2>&1\n'
		  printf '\t\tfi\n'
		  tail -n +$((_dmln + 1)) "$SSR_INIT"
		} > "${SSR_INIT}.tmp"
		mv "${SSR_INIT}.tmp" "$SSR_INIT"
		chmod +x "$SSR_INIT"
		log "init.d/shadowsocksr: stop() 的 dnsmasq 重启已加守卫"
	else
		log "ERROR: 未在 stop() 内找到 dnsmasq restart，守卫未应用"
	fi

	# 语法校验，失败回滚（禁止静默失败）
	if sh -n "$SSR_INIT"; then
		log "init.d/shadowsocksr: 补丁后语法检查通过"
	else
		log "ERROR: init.d/shadowsocksr 补丁后语法错误，回滚"
		cp "${SSR_INIT}.orig" "$SSR_INIT"
		chmod +x "$SSR_INIT"
	fi
else
	log "init.d/shadowsocksr: v0.8.3 补丁已存在或文件缺失，跳过"
fi

# ─────────────────────────────────────────────
# 4.9 SSR-Plus: 从透明代理端口列表移除 53（v0.8.4）
# ─────────────────────────────────────────────
# 这是「启用 SSR-Plus 后客户机连 baidu 都解析不了」的真正根因。
#
# `dports='2'`（常用端口）对应的端口列表原本是：
#   22,53,587,465,995,993,143,80,443,853,9418        ← 含 53
# 于是客户机的 UDP/53 会被 `ss_spec_mangle prerouting`（priority mangle，-150）
# TPROXY 到 `:1234`，交给 v2ray 的 dokodemo-door。
#
# 但客户机 DNS 本来就已经被 fw4 的 `dns_intercept_lan`
# （priority dstnat+1，-99）劫持到本机 dnsmasq 了 —— **两条路径必须只留一条**。
# 而 mangle(-150) 比 dstnat+1(-99) **更早执行**，所以 tproxy 先赢，
# dnsmasq 根本收不到包（实测 nft 计数器：prerouting 命中 48 个包，
# dns_intercept_lan 命中 0，input 链命中 0）。
#
# v2ray 会对每个被 tproxy 的 DNS 打开一个绑定 `192.168.3.254:53` 的 UDP
# socket 且**不释放**，累积后反过来抢走 dnsmasq 的 DNS 包。实测 50 秒内：
#   23:11:49  socket=1    解析=1     ← 正常
#   23:11:56  socket=4    解析=0     ← 开始堆积
#   23:12:10  socket=50   解析=0
#   23:12:24  socket=167  解析=0
#   23:12:38  socket=246  解析=0     ← 完全不可用（连 baidu 也超时）
# 这就是「启用后一两分钟开始断、过一阵又自己好」的周期来源：
# v2ray 重启后 socket 归零，随后再次堆积。
#
# 移除 53 后实测（3 分钟持续 DNS 压力，每 8 秒采样）：
#   socket 恒为 1，解析 100% 成功。
#
# 注意：仅改运行时 nft 规则**不够** —— 旧的持久化规则
# `/usr/share/nftables.d/ruleset-post/99-shadowsocksr.nft` 里仍含 53，
# fw4 重载会把它加回来。故必须同时改 init 脚本里的端口列表，
# 让 `ssr-rules -P` 重新生成的持久化文件也不含 53。
if [ -f "$SSR_INIT" ] && ! grep -q '修复 v0.8.4' "$SSR_INIT"; then
	_pl=$(grep -n 'proxyport="-m multiport --dports 22,53,' "$SSR_INIT" | head -1 | cut -d: -f1)
	if [ -n "$_pl" ]; then
		{ head -n $((_pl - 1)) "$SSR_INIT"
		  printf '\t\t\t# [修复 v0.8.4] 从透明代理端口列表移除 53。\n'
		  printf '\t\t\t# 客户机 DNS 已由 fw4 的 dns_intercept_lan 劫持到本机 dnsmasq，\n'
		  printf '\t\t\t# 不需要、也不应该再经 tproxy 送进 :1234。\n'
		  printf '\t\t\t# 保留 53 时 v2ray 会为每个被 tproxy 的 DNS 打开一个 UDP socket 且\n'
		  printf '\t\t\t# 不释放，实测 50 秒内从 1 个涨到 246 个并全部绑定 192.168.3.254:53，\n'
		  printf '\t\t\t# 抢走 dnsmasq 的 DNS 包 → 客户机连 baidu 都无法解析。\n'
		  printf '\t\t\tproxyport="-m multiport --dports 22,587,465,995,993,143,80,443,853,9418"\n'
		  tail -n +$((_pl + 1)) "$SSR_INIT"
		} > "${SSR_INIT}.tmp"
		mv "${SSR_INIT}.tmp" "$SSR_INIT"
		chmod +x "$SSR_INIT"
		log "init.d/shadowsocksr: 已从 tproxy 端口列表移除 53"
	else
		log "init.d/shadowsocksr: 未找到含 53 的 proxyport 行（可能已修）"
	fi

	# 清掉含 53 的旧持久化规则，让 ssr-rules -P 重建
	_oldnft=/usr/share/nftables.d/ruleset-post/99-shadowsocksr.nft
	if [ -f "$_oldnft" ] && grep -q '22, 53,' "$_oldnft"; then
		rm -f "$_oldnft"
		log "已删除含 53 的旧持久化 nft 规则，等待 ssr-rules -P 重建"
	fi

	if sh -n "$SSR_INIT"; then
		log "init.d/shadowsocksr: v0.8.4 补丁后语法检查通过"
	else
		log "ERROR: init.d/shadowsocksr v0.8.4 补丁后语法错误，回滚"
		cp "${SSR_INIT}.orig" "$SSR_INIT"
		chmod +x "$SSR_INIT"
	fi
else
	log "init.d/shadowsocksr: v0.8.4 补丁已存在或文件缺失，跳过"
fi

# ─────────────────────────────────────────────
# 4.10 SSR-Plus: 修复并发 restart 导致「无法安装透明代理规则」（v0.8.6）
# ─────────────────────────────────────────────
# 症状：SSR-Plus 运行一段时间后偶发启动中止，日志只有一行
#   `ERROR: 无法安装透明代理规则，启动中止。`
# 且 `ssr-rules` 自己一条失败日志都没有（既无 `NFTables setup failed!`
# 也无 `NFT forced rebuild failed!`）—— 说明它是**被杀死的**，不是跑失败的。
#
# 复现（本机 2026-10-20 实测，5/5 稳定复现）：
#   并发两个 `/etc/init.d/shadowsocksr restart`，必定出现该 ERROR；
#   串行连跑 5 次，增量恒为 0。
#
# 根因有两个，叠加生效：
#
#   根因 1 —— 互斥锁形同虚设。
#     `set_lock()` 是 `flock -xn 1000`（`-n` 非阻塞）且**忽略返回值**，
#     拿不到锁也照样往下走；`unset_lock()` 又 `rm -rf "$LOCK_FILE"`
#     把**被锁的那个 inode 删掉**，下一个进程重新创建同名文件、
#     锁到另一个 inode。实测：A 持锁时删文件后，B 立即也能拿到锁。
#     于是 `start()` 与 `stop()` 真正并发执行。
#
#   根因 2 —— `stop()` 按 cmdline 杀 ssr-rules。
#     `ps_list | grep ssr-rules | xargs kill -9` 会杀掉**并发实例**
#     正在执行的 `/usr/bin/ssr-rules`。而 `start_rules()` 是
#     `flush_r && ipset_r && fw_rule && ...` 的 && 链，中途被 SIGKILL
#     必然返回非 0 → 打出「无法安装透明代理规则」。
#     实测插桩：`step=flush_r ok` 之后就没有任何 step 日志，
#     且 `kill -9` 目标列表里出现了正在跑的那个 pid。
#
# 为什么「运行一段时间后」才出现：开机是串行的，只有周期性触发器
# （`ssr-monitor` 的 30s 巡检、`99-ssrplus-pppoe` 的 ifup+10s、
# 订阅自动更新）撞在一起时才会并发。本机 `network.wan.proto=pppoe`，
# 每次重拨都会触发一次 restart，与 monitor 巡检重叠即中招。
#
# 修法（三处，均幂等）：
#   a) `set_lock()` 改为有界等待（最多 60s），超时明确报错退出；
#   b) `unset_lock()` 只释放锁、不删文件；`unlock()` 不再以文件存在性判断；
#   c) `stop()` 不再按 cmdline kill ssr-rules —— 自动更新守护进程
#      已由前面的 `ssr-rules -K` 按 pid 文件正确停止。
if [ -f "$SSR_INIT" ] && ! grep -q '修复 v0.8.6' "$SSR_INIT"; then
	cp "$SSR_INIT" "${SSR_INIT}.orig-v086"
	_tmpd086=$(mktemp -d /tmp/ssr086.XXXXXX) || _tmpd086=/tmp

	cat >"$_tmpd086/set_lock" <<'EOS'
set_lock() {
	# [修复 v0.8.6] 原实现 `flock -xn 1000` 是非阻塞且**忽略返回值**，
	# 拿不到锁也照样往下执行 —— 互斥完全失效。改为有界等待，
	# 超时则明确失败（禁止静默继续，见 AGENTS.md 红线 3）。
	local _i=0
	exec 1000>"$LOCK_FILE"
	while ! flock -xn 1000; do
		_i=$((_i + 1))
		if [ "$_i" -ge 60 ]; then
			echolog "ERROR: 等待 SSR-Plus 锁超时（60s），放弃本次操作。"
			exec 1000>&-
			_exit 1
		fi
		sleep 1
	done
}
EOS

	cat >"$_tmpd086/unset_lock" <<'EOS'
unset_lock() {
	# [修复 v0.8.6] 原实现 `rm -rf "$LOCK_FILE"` 会删掉**被锁的那个 inode**，
	# 下一个进程重新创建同名文件、锁到另一个 inode，
	# 于是两个实例各自持有「自己的锁」同时进入。
	# 实测：A 持锁时删文件后，B 立即也能拿到锁。
	# 正确做法是只释放，文件常驻（内容无意义）。
	flock -u 1000 2>/dev/null
	exec 1000>&-
}
EOS

	cat >"$_tmpd086/unlock" <<'EOS'
unlock() {
	# [修复 v0.8.6] 原实现用 `[ -f "$LOCK_FILE" ]` 判断别的实例是否在跑，
	# 而 unset_lock 会删除该文件 —— 「文件不存在」既表示空闲、也表示锁被删掉，
	# 无法区分。现在锁由 flock 持有、文件常驻，真正的等待由 set_lock 完成。
	return 0
}
EOS

	# 按函数名整块替换：从 `name() {` 到其后第一个裸 `}`
	for _fn in set_lock unset_lock unlock; do
		awk -v name="$_fn" -v body="$_tmpd086/$_fn" '
			$0 == name "() {" && !done {
				while ((getline line < body) > 0) print line
				close(body)
				skip = 1; done = 1; next
			}
			skip && $0 == "}" { skip = 0; next }
			skip { next }
			{ print }
		' "$SSR_INIT" >"${SSR_INIT}.tmp" && mv "${SSR_INIT}.tmp" "$SSR_INIT"
	done

	# (c) 去掉按 cmdline kill ssr-rules 的那行
	awk '
	/grep ssr-rules \| awk/ {
		print "\t\t# [修复 v0.8.6] 不再按 cmdline 匹配 kill ssr-rules。"
		print "\t\t# 原写法 `ps_list | grep ssr-rules | xargs kill -9` 会杀掉**并发实例**"
		print "\t\t# 正在执行的 /usr/bin/ssr-rules，使其在 flush_r && ipset_r && fw_rule"
		print "\t\t# 链中被 SIGKILL，start_rules() 返回非 0 → 打「无法安装透明代理规则」。"
		print "\t\t# 自动更新守护进程已由上面的 `ssr-rules -K` 按 pid 文件停止。"
		print "\t\trm -f /var/run/ssr-rules-daemon.pid"
		next
	}
	{ print }
	' "$SSR_INIT" >"${SSR_INIT}.tmp" && mv "${SSR_INIT}.tmp" "$SSR_INIT"

	chmod +x "$SSR_INIT"
	rm -rf "$_tmpd086"

	# 断言四项改动都在；任一缺失即回滚（禁止静默失败）
	_v086_fail=0
	grep -q 'flock -xn 1000; do' "$SSR_INIT" || _v086_fail=1
	grep -q 'exec 1000>&-' "$SSR_INIT" || _v086_fail=1
	grep -q 'grep ssr-rules | awk' "$SSR_INIT" && _v086_fail=1

	if [ "$_v086_fail" = "0" ] && sh -n "$SSR_INIT"; then
		log "init.d/shadowsocksr: v0.8.6 锁与 kill 修复已应用（语法通过）"
	else
		log "ERROR: init.d/shadowsocksr v0.8.6 补丁失败，回滚"
		cp "${SSR_INIT}.orig-v086" "$SSR_INIT"
		chmod +x "$SSR_INIT"
	fi
else
	log "init.d/shadowsocksr: v0.8.6 补丁已存在或文件缺失，跳过"
fi


# ─────────────────────────────────────────────
# 5. DNSMasq → 全部走 dnsproxy (ALL_DOH)
# ─────────────────────────────────────────────
while uci delete dhcp.@dnsmasq[0].server 2>/dev/null; do :; done

uci add_list dhcp.@dnsmasq[0].server='127.0.0.1#5353'
uci set dhcp.@dnsmasq[0].noresolv='1'
uci set dhcp.@dnsmasq[0].cachesize='8192'
uci set dhcp.@dnsmasq[0].ednspacket_max='1232'

# dns-forward-max：dnsmasq 的并发转发槽上限，**默认仅 150**（`dnsmasq --help`
# 原文：Maximum number of concurrent DNS queries. (defaults to 150)）。
#
# 为什么必须显式抬高（v0.8.0）：
#   本固件的 dnsmasq 是**单点串行依赖** —— noresolv=1 没有兜底解析器，且
#   gfw_list.conf 里 23701 个域名被指到 127.0.0.1#5335（SSR-Plus 的 MosDNS）。
#   MosDNS 一旦没起来（init 的 ln_start_bin 用 `>/dev/null 2>&1 &` 静默启动，
#   失败无日志），这 23701 个域名的查询会**占住转发槽直到超时**：
#     · 槽位耗尽后 dnsmasq 拒绝发起新查询，并打
#       `Maximum number of concurrent DNS queries reached (max: 150)`
#     · 于是**国内域名也一起解析失败** —— 这正是「启用 SSR-Plus 后国内外全挂」
#       表现形态的成因之一（离线已复现：并发打满后未查过的国内域名全部
#       `connection timed out`）。
#
# 注意：这是**防御性**配置，不是本次故障的已证根因 —— 2026-10-17 故障窗口内
#   `logread | grep -c 'Maximum number of concurrent'` = 0，说明那次告警并未出现。
#   抬高上限能降低「死上游拖垮国内解析」的概率与烈度，但真正的修法是让
#   SSR-Plus 在装规则前确认 :5335 与 :1234 已监听（见 CHANGELOG v0.8.0）。
#
# 取值依据：dnsmasq 每个在途查询约占一个 fd 与少量内存；1024 在 7GB 级设备上
#   开销可忽略，而 150 → 1024 足以覆盖「数千 gfw 域名冷启动」的场景。
uci set dhcp.@dnsmasq[0].dnsforwardmax='1024'

log "dnsmasq: server=127.0.0.1#5353 (dnsproxy ALL_DOH), dnsforwardmax=1024"

# ─────────────────────────────────────────────
# 6. SSR-Plus: filter_aaaa 的拒绝集语义（详见 docs/adr/0001）
# ─────────────────────────────────────────────
# filter_aaaa=1 → get_filter_aaaa() 让 init 脚本生成
#   main_sequence_disable_IPv6，对 qtype 28(AAAA)/65(HTTPS) 执行 `reject 0`。
#
# 关键：该开关的「正确值」取决于 dnsmasq 的路由是否分裂，而不是开关字面。
#   现网路由（本固件即是）：dnsmasq 默认 server=127.0.0.1#5353（dnsproxy 国内
#   DoH）；仅 gfw_list.conf 的 23614 个域名 + black.list 走 127.0.0.1#5335
#   （mosdns）。因此 MosDNS 的 reject 只作用于「需走代理的域名」——
#   即拒绝集 = 需走代理的域名集，这正是期望语义：
#     · 被墙域名只剩 IPv4 → 回落经 :1234 代理出站，不会被 IPv6 直连 RST；
#     · 其余国外域名（taobao 类国内同理）保留真实 AAAA，走 IPv6 直连。
#
# 【2026-10-09 修正】仓库原值 '0' 是把 v0.3.5 的结论套在了已变化的架构上。
#   v0.3.5 当时的前提是「dnsmasq 把所有域名都指向 5335」，那时 '1' 会全局
#   切断国外 AAAA；而现在路由已分裂，'1' 才等价于上面描述的分类语义。
#   实测（走客户端真实路径 192.168.3.254）：taobao.com 返回 8 条真实 AAAA；
#   google.com / chatgpt.com / steamcommunity.com 返回 mosdns 合成 SOA
#   （fake-ns.mosdns.fake.root）；baidu/qq 的 SOA 来自真实权威（上游确实无
#   AAAA，非被抑制）。若改回 '0'，那 23614 个被墙域名将拿到真实 AAAA 并
#   在 IPv6 上直连被 RST，表现为「有 IPv6 但打不开站点」。
# 说明: SSR-Plus 仅代理 IPv4（无 ip6tables/TPROXY6 规则），其余国外 IPv6 为
#   直连——这是有意取舍，详见 docs/adr/0002。
#
# 【2026-10-09 修正】此处的 `uci set` 同样受「global 段可能尚不存在」影响
#   （根因与对策详见第 4.5 节）。第 4.5 节已保证配置非空且 global 段存在，
#   这里再加一次与 4.5 同源的守卫，防御将来有人调整脚本顺序或单独摘取本节。
if [ ! -s /etc/config/shadowsocksr ]; then
	/etc/init.d/shadowsocksr reset 2>/dev/null
fi
uci -q get shadowsocksr.@global[0] >/dev/null 2>&1 || uci add shadowsocksr global
uci set shadowsocksr.@global[0].filter_aaaa='1' \
	|| log "ERROR: 写入 shadowsocksr.@global[0].filter_aaaa 失败"

log "ssr-plus: filter_aaaa=1 (reject set = domains routed through proxy)"

# ─────────────────────────────────────────────
# 6.9 dnsmasq 日志：从 /dev/null 改为 syslog
# ─────────────────────────────────────────────
#
# 根因（2026-10-23 实测）：
#   上游 `99-default-settings:59-60` 每次构建执行
#       sed -i '/log-facility/d' /etc/dnsmasq.conf
#       echo "log-facility=/dev/null" >> /etc/dnsmasq.conf
#   而生成的 `/var/etc/dnsmasq.conf.*` 第 2 行是
#       conf-file=/etc/dnsmasq.conf
#   于是那行被加载 → **dnsmasq 的日志全部丢弃**。
#   实测：`logqueries=1` 但 `logread | grep -c dnsmasq` 恒为 0。
#
# ⚠️ 三种「看起来对」的修法都失败，已逐一实测排除：
#   ① UCI `dhcp.@dnsmasq[0].logfacility` —— init.d/dnsmasq:944 的
#      `append_parm logfacility --log-facility` 会**再写一条**
#      `log-facility=...` 进生成文件，与 conf-file 里的重复 →
#      `illegal repeated keyword at line 13` → **FAILED to start up**
#      （实测复现两次，dnsmasq 完全起不来，全屋断 DNS）
#   ② `log-facility=/dev/log` —— 该 socket 存在，但 ujail 沙箱未挂载它 →
#      `cannot open log /dev/log: No such device or address` → 同样起不来
#   ③ `log-facility=/tmp/dnsmasq.log` —— 能启动，但**不写文件**
#      （沙箱只允许写白名单路径），日志照样丢
#
#   可用的是 `log-facility=syslog`：dnsmasq 正常启动，日志进 logread。
#   实测发 2 次查询后 logread 新增 30 条，含完整查询详情：
#     `dnsmasq[1]: 10 192.168.3.238/54385 reply xxx is <CNAME>`
#
# 幂等：先删该行再加，重复执行不会叠加。
if grep -q '^log-facility=' /etc/dnsmasq.conf 2>/dev/null; then
	sed -i '/^log-facility=/d' /etc/dnsmasq.conf
fi
echo 'log-facility=syslog' >> /etc/dnsmasq.conf
log "dnsmasq: log-facility=syslog（原 /dev/null 导致日志全丢）"

# ─────────────────────────────────────────────
# 7. 提交全部 UCI 配置
# ─────────────────────────────────────────────
uci commit firewall
uci commit network
uci commit dhcp
uci commit dnsproxy
uci commit shadowsocksr
uci commit turboacc

log "All UCI configs committed. Done."
