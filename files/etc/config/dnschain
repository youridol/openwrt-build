# ============================================================
# dnschain — DNS 链路框架配置
# ------------------------------------------------------------
# 本文件由 openwrt-build 仓库 files/ overlay 提供。
# 设计依据：docs/adr/0003-dns-chain-framework.md
#
# 链路（v0.10.0 起：无 chinadns-ng）：
#   LAN 客户机 → fw4 拦截 53 → dnsmasq:53（唯一缓存层 + DHCP + 唯一策略层）
#     ├─ 国内域名 → dnsproxy:5353 → 国内加密池（DoT/DoH，直连）
#     ├─ 国外域名 → dnsproxy:5353 → 国外 DoH（https://dns.google，经 :1234）
#     └─ nftset=/域名/4#inet#ss_spec#blacklist
#          由 dnsmasq 把国外域名的解析结果直接写入代理 IP 集
#
# 为什么去掉 chinadns-ng（v0.10.0 的关键决策，实测依据）：
#   1. chinadns-ng 的 -t 只支持 udp:// tcp:// tls://，**不支持 DoH**
#      （实测 `invalid proto: 'https://'`，二进制里 doh 字样数 = 0）
#   2. 而落地节点到 8.8.8.8:853 / 1.1.1.1:853 全部不通
#      （实测 `peer sent close notify`，conntrack 显示只回 204 字节）
#      到 443 却完全正常（curl google 302 / youtube 200）
#   3. 故 chinadns-ng 的国外上游在本环境下**永远不可用**，
#      只能退化成「用国内 DNS 查国外」→ 拿到污染答案
#      （实测 google → 104.244.42.197 / AAAA → 2001::1）
#   4. dnsproxy 原生支持 DoH 且支持按域名分流，实测经代理拿到真实答案
#      （google A → 142.251.153.119，AAAA → 2001:4860:4826:7700::）
#
# 为什么不再需要 AAAA 抑制：
#   SSR-Plus 的「IPv6 流量代理」（ipv6_support=1）启用后：
#     - get_filter_aaaa() 直接返回 0（不再抑制 AAAA）
#     - set_ipv6_dns_filter 把 dnsmasq 的 filter_aaaa 设为 0
#     - 装上完整 IPv6 代理链（ss_spec6_*，10 条链 + fwmark 策略路由）
#   实测：curl -6 google → 302、youtube → 200、baidu → 200（国内直连）
#   既然国外 IPv6 也走代理，就没有「IPv6 直连被 RST」的问题，
#   抑制 AAAA 反而会让国外站点失去双栈能力。
#
# 硬约束：
#   - 缓存只在 dnsmasq 一层；dnsproxy 不缓存
#   - 国外域名必须走 DoH（不能用国内上游，会拿到污染答案）
#   - ipv6_support 必须为 1（否则国外 AAAA 无意义）
#   - 任何一处故障都不回落明文上游（ADR §12 降级矩阵）
# ============================================================

config dnschain 'main'
	# 总开关：关闭时整条框架不启（dnsproxy 不监听）
	option enabled '1'
	# 拦截总开关（滑块）：开启时强制拦截静态 + DHCP 客户机的 53
	option intercept '1'
	# 国内域名入口（dnsproxy 实例 1）
	option entry_port '5353'
	# 国外域名入口（dnsproxy 实例 2，只配 DoH 上游）
	option foreign_port '5336'
	# 拒绝 LAN 出向 853（让自带 DoT 的客户端快速失败并回落明文）
	option intercept_dot '1'
	# 尽力而为地阻断已知公共 DoH（443 无法可靠区分，仅标注）
	option intercept_doh '0'

config upstream 'cn'
	# 国内加密池：DoT 与 DoH 混用，dnsproxy 并行查询取最快
	list server 'tls://223.5.5.5'
	list server 'tls://223.6.6.6'
	list server 'https://dns.alidns.com/dns-query'

config upstream 'foreign'
	# 国外加密池：**必须用 DoH**（443），不能用 DoT（853 被落地节点阻断）。
	# 必须用域名形式（不是 IP）：dnsproxy 的 DoH 上游需要 SNI 与 Host，
	# 而经代理的 443 完全正常（实测 TLSv1.3 握手成功）。
	# dnsproxy 会把这里列出的上游应用到 gfw 名单内的域名。
	list server 'https://dns.google/dns-query'
	list server 'https://cloudflare-dns.com/dns-query'
	# 走代理出站（dnsproxy 自身出向由 ss_spec_output 接管，853/443 都在 dports 内）
	option via_proxy '1'
	# DoH 证书校验：开启（有 SNI，可正常校验）
	option cert_verify '1'

config aaaa 'policy'
	# 以下两个字段是**只读**的：它们表达物理约束（节点 IPv4-only）。
	# 但 v0.10.0 起 SSR-Plus 的 IPv6 流量代理会把国外 IPv6 也送进代理，
	# 故国外 AAAA **不再抑制**——保留双栈，客户端可优先走 IPv6 并经代理。
	option domestic 'keep'
	option foreign 'keep'
	# HTTPS/SVCB 记录不再抑制（原来抑制是为了防止 ipv6hint 绕过 AAAA 抑制，
	# 现在不抑制 AAAA，这条也就没有意义了）
	option filter_https_rr '0'

config lists 'lists'
	# 单向只读源：SSR-Plus 自带的 GFW 列表与基础列表
	option gfw_source '/etc/ssrplus/gfw_list.conf'
	option base_source '/etc/ssrplus/gfw_base.conf'
	option black_source '/etc/ssrplus/black.list'
	# 自动导入：收敛器轮询源文件 md5，变化即重导（页面有开关）
	option auto_import '1'
	option import_interval '60'
	# 行数变化超过该百分比才重启 dnsproxy（避免小改动引起解析中断）
	option restart_threshold '1'

config dhcp_dns 'dhcp_dns'
	# 仅在 intercept=0 时下发给 DHCP 客户机的明文 DNS（最多 4 个）
	option enabled '1'
	list server '223.5.5.5'
	list server '119.29.29.29'

config cache 'cache'
	# 唯一缓存层：dnsmasq 的条目数
	option enabled '1'
	option size '8192'

# ============================================================
# 自定义域名列表（v0.13.0）
# ------------------------------------------------------------
# 两个 list 的语义完全不同，不要混：
#
#   domestic  用户手工录入「必须走国内链路」的域名
#             → dnsmasq: server=/域名/127.0.0.1#<entry_port>（直连出口）
#             → 同时写入 nft china 集，保证后续 TCP/UDP 也直连
#
#   foreign   用户手工录入「必须走国外链路」的域名
#             → dnsmasq: server=/域名/127.0.0.1#<foreign_port>（代理出口）
#             → 同时写入 nft blacklist 集，保证后续流量进 :1234
#
# 优先级：自定义 > 数据库（gfw 名单）> 未覆盖。
# 即「用户写的就是最终答案」，名单的自动判定不能覆盖它。
#
# 格式：必须是合法域名（含 xn-- 形式），不接受通配符、IP、URL。
# 校验在页面（保存前）与脚本（生成前）各做一次 —— 页面拦住手误，
# 脚本兜住直接改 UCI 的情形，两道都不放行非法条目。
#
# ⚠️ section 名**不能叫 'foreign'**（v0.13.0 实测踩过）：
#   UCI 的 section 名在**同一个配置文件内必须唯一，与类型无关**。
#   本文件上面已有 `config upstream 'foreign'`，再写
#   `config domains 'foreign'` 会让 uci 直接报
#       Parse error (section of different type overwrites prior section
#       with same name)
#   并且**整个 /etc/config/dnschain 都读不出来** —— 框架所有 uci 取值
#   全部失败，症状是「页面空白 + 服务起不来」，而报错只提 section 重名。
#   故这里统一用 dom_ / for_ 前缀，与类型名区分开。
# ============================================================
config domains 'dom_domestic'
	# 默认留空：不预设任何域名的归属，行为完全由名单与健康检测决定。
	# 空 list 不要写成 `list domain ''` —— 那会落一个空值，
	# 生成分流时要额外过滤一次，而空值在页面上也会显示成一个空条目。

config domains 'dom_foreign'

# ============================================================
# 链路健康检测与自动改道（v0.13.0）
# ------------------------------------------------------------
# 只对 health.watch 里的域名做探测 —— 不做全量探测。
# 理由：全量（3.5 万域名）既不可能（一轮要几小时），也会把
# dnsmasq 与 dnsproxy 打满。故采取「抽样观测」：
#
#   观测列表 = 用户手工指定 + 自动补 4 个国内、4 个国外基准域名
#   一轮只探这十来个，任何一个出问题都能立刻在页面上看到。
#
# 改道规则（需求原文的落地）：
#   未录入自定义列表的域名
#     · 国外链路探测不通 → 改走直连
#     · 国内链路探测不通 → 改走代理
#   即：首选链不通且另一条链通 → 切到另一条。
#   两条链都不通时不改道（那是链路故障，不是分流问题）。
#
# 改道只改 watch.servers（dnsmasq 的 --servers-file）+ SIGHUP，
# 不重启 dnsmasq、不清缓存、不影响未观测的域名。
# ============================================================
config health 'health'
	# 总开关：关闭后不探测、不改道，静态分流照常
	option enabled '1'
	# 单次探测的硬超时（秒）。BusyBox nslookup 没有 -timeout，
	# 框架自己实现硬超时，故这个值就是真实上界。
	option timeout '2'
	# 每次探测的重试次数（不含首次）。单次 UDP 丢包很常见，
	# 不重试会让改道变成随机行为。
	option retries '2'
	# 连续失败多少轮才判定「不通」。取 2 是为了避开单轮抖动：
	# 一轮探测可能同时碰上两个域名各丢一次包。
	option fail_threshold '2'
	# 连续成功多少轮才回切到首选链。取 3 且配合 min_dwell，
	# 避免链路在临界状态下反复横跳（每次横跳都改一次 servers-file）。
	option recover_threshold '3'
	# 改道后至少停留多少秒才允许回切。
	option min_dwell '120'
	# 探测轮询间隔（秒）。0 = 不自动轮询，只能从页面手动触发。
	option interval '60'
	# 观测域名（用户可增删）。清空后脚本会回落到内置基准集，
	# 不会出现「一个都不探 → 页面永远显示无数据」的空转状态。
	list watch 'www.baidu.com'
	list watch 'www.taobao.com'
	list watch 'www.qq.com'
	list watch 'www.163.com'
	list watch 'www.google.com'
	list watch 'www.youtube.com'
	list watch 'github.com'
	list watch 'www.wikipedia.org'

config selftest 'selftest'
	option auto_rollback '1'
	option interval '300'

config ssr 'compat'
	# 期望的 SSR-Plus DNS 后端模式：0 = 不启后端（框架不需要 :5335 了，
	# 但仍要求 0，避免 SSR-Plus 自己起 mosdns/dns2tcp 抢 DNS）
	option mode '0'
	# 收敛器强制写回（关闭时只告警，不修改 SSR 的键）
	option enforce '1'
	# 期望的 IPv6 流量代理开关：1 = 启用（国外 IPv6 也走代理，保留双栈）
	option require_ipv6 '1'
