# ============================================================
# dnsproxy — ALL_DOH 默认配置（openwrt-build 仓库 files/ overlay）
# ------------------------------------------------------------
# 主链路（ALL_DOH，国内国外统一加密解析、不分流）:
#   LAN → dnsmasq:53 → dnsproxy:5353 → DoH/DoT → Internet
# 规则:
#   - 上游一律加密（https:// = DoH），bootstrap 仅用于解析加密上游主机名
#   - 无明文 DNS 上游、无明文 fallback（fallback 亦为 DoH）
#   - UCI 键 dnsproxy.global.lan_dns_intercept 控制 LAN DNS 强制拦截
#     （LuCI 开关「拦截所有客户端 DNS」，由 init 管理；fw3 用 iptables、fw4 用 nftables）
# ============================================================

config dnsproxy 'global'
	option enabled '1'
	list listen_addr '127.0.0.1'
	list listen_addr '::1'
	list listen_port '5353'
	# ALL_DOH: 拦截所有客户端 DNS（默认 ON，LuCI 可切换）
	option lan_dns_intercept '1'
	option log_file ''
	option http3 '0'
	option insecure '0'
	option ipv6_disabled '0'
	option timeout '10s'
	option max_go_routines ''
	option rate_limit ''
	option refuse_any '0'
	option udp_buf_size ''
	option upstream_mode 'load_balance'
	option verbose '0'

config dnsproxy 'bogus_nxdomain'
	list ip_addr ''

config dnsproxy 'cache'
	option enabled '1'
	option cache_optimistic '1'
	option size '8192'
	option min_ttl '60'
	option max_ttl '86400'

config dnsproxy 'dns64'
	option enabled '0'
	option dns64_prefix '64:ff9b::'

config dnsproxy 'edns'
	option enabled '0'
	option edns_addr ''

config dnsproxy 'hosts'
	option enabled '1'
	list hosts_files '/etc/hosts'

config dnsproxy 'private_rdns'
	option enabled '0'
	list upstream '127.0.0.1:53'

config dnsproxy 'servers'
	# 国内/国外统一加密解析，不做 DNS 分流：主上游为国内 DoH（稳定可达），
	# 备选上游与 fallback 亦全部走加密（DoH），禁止明文 DNS 兜底。
	list upstream 'https://dns.alidns.com/dns-query'
	list upstream 'https://doh.pub/dns-query'
	list upstream 'https://doh.360.cn/dns-query'
	# bootstrap 仅用于解析加密上游主机名（明文是它唯一且应有的用途）
	list bootstrap '223.5.5.5'
	list bootstrap '223.6.6.6'
	# fallback 备用通道同样加密（DoH），绝不明文
	list fallback 'https://1.12.12.12/dns-query'
	list fallback 'https://8.8.8.8/dns-query'

config dnsproxy 'tls'
	option enabled '0'
	option tls_crt ''
	option tls_key ''
	option https_port '8443'
	option tls_port '853'
	option quic_port '853'