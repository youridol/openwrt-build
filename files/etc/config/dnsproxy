# ============================================================
# dnsproxy — ALL_DOH 默认配置（openwrt-build 仓库 files/ overlay）
# ------------------------------------------------------------
# 主链路（ALL_DOH 加密解析）:
#   LAN → dnsmasq:53 → dnsproxy:5353 → DoH/DoT → Internet
#   走 MosDNS 的域名由 dnsmasq 的 gfw_list.conf 分流（见下方 servers 段，
#   v0.8.0 起 dnsproxy 自身不再持有任何指向 127.0.0.1:5335 的上游）。
# 规则:
#   - 上游一律加密（https:// = DoH），bootstrap 仅用于解析加密上游主机名
#   - 无明文 DNS 上游、无明文 fallback（fallback 亦为 DoH）
#   - UCI 键 dnsproxy.global.lan_dns_intercept 控制 LAN DNS 强制拦截
#     （LuCI 开关「拦截所有客户端 DNS」，由 init 管理；fw3 用 iptables、fw4 用 nftables）
# ============================================================

config dnsproxy 'global'
	option enabled '1'
	list listen_addr '127.0.0.1'
	list listen_addr '::1'
	list listen_port '5353'
	# ALL_DOH: 拦截所有客户端 DNS（默认 ON，LuCI 可切换）
	option lan_dns_intercept '1'
	option log_file ''
	option http3 '0'
	option insecure '0'
	option ipv6_disabled '0'
	option timeout '10s'
	option max_go_routines ''
	option rate_limit ''
	option refuse_any '0'
	option udp_buf_size ''
	# 上游模式: parallel（并行查全部上游取最快响应）
	# 实测(冷查询中位数): parallel 39.6ms < load_balance 62.5ms < fastest_addr 97.7ms
	# fastest_addr 每次查询额外做 IP 连通性探测，国内 DoH 同质场景纯属开销，不推荐。
	option upstream_mode 'parallel'
	option verbose '0'

config dnsproxy 'bogus_nxdomain'
	list ip_addr ''

config dnsproxy 'cache'
	option enabled '1'
	option cache_optimistic '1'
	option size '8192'
	option min_ttl '60'
	option max_ttl '86400'

config dnsproxy 'dns64'
	option enabled '0'
	option dns64_prefix '64:ff9b::'

config dnsproxy 'edns'
	option enabled '0'
	option edns_addr ''

config dnsproxy 'hosts'
	option enabled '1'
	list hosts_files '/etc/hosts'

config dnsproxy 'private_rdns'
	option enabled '0'
	list upstream '127.0.0.1:53'

config dnsproxy 'servers'
	# 国内/国外统一加密解析主链：主上游为国内 DoH（稳定可达）
	#
	# 2026-09-04 修复（v0.3.4）：
	# - doh.pub（域名型、偶发 502、依赖 bootstrap）→ 1.12.12.12（IP 型直连，china ipset 命中不代理）
	# - fallback 删除 8.8.8.8（其流量被 SSR-Plus 代理接管，SSR 重建窗口必超时 → 日志刷 ERROR）
	#   保留 1.12.12.12（国内可直连、不依赖代理）作最兜底
	list upstream 'https://dns.alidns.com/dns-query'
	list upstream 'https://1.12.12.12/dns-query'
	list upstream 'https://doh.360.cn/dns-query'
	# ── 2026-10-17 移除「24 个国外域名 → 127.0.0.1:5335」例外清单（v0.8.0）──
	#
	# 移除理由（三条，均有实测）：
	#
	# 1) 它 100% 冗余。这 24 个域名在 dnsmasq 的 gfw_list.conf 里**全部命中**
	#    （逐个 grep：google.com / youtube.com / github.com / twitter.com / x.com /
	#    facebook.com / instagram.com / whatsapp.com / telegram.org / reddit.com /
	#    discord.com / spotify.com / netflix.com / cloudflare.com /
	#    cloudflare-dns.com / amazon.com / amazonaws.com / stackoverflow.com /
	#    wikipedia.org / medium.com / notion.so / figma.com / vercel.com /
	#    herokuapp.com —— 24/24 命中，行形如 server=/<域名>/127.0.0.1#5335）。
	#    SSR-Plus 启用时它们本来就会被 dnsmasq 转去 :5335，此处是重复声明。
	#
	# 2) SSR-Plus **禁用**时它把答案污染掉。此时 :5335 无监听，dnsproxy 打
	#    `connection refused` 后回落到 fallback https://1.12.12.12/dns-query，
	#    拿到的是污染答案。2026-10-17 实测：
	#        youtube.com    → 31.13.92.37    （Facebook 的 IP）
	#        wikipedia.org  → 31.13.94.36    （Facebook 的 IP）
	#        wikipedia.org  → 199.59.148.96 / 31.13.73.169
	#    同一时刻不在清单里的域名全部正常：
	#        blogspot.com → 65.49.68.152、wordpress.com → 192.0.78.9、
	#        www.bing.com → 202.89.233.100
	#    dnsproxy 日志相应刷
	#        ERROR exchange failed prefix=dnsproxy upstream=127.0.0.1:5335
	#          question=";www.google.com.\tIN\t HTTPS"
	#          err="... read: connection refused"
	#
	# 3) 它让 dnsproxy 的解析结果隐式依赖「SSR-Plus 是否在运行」。这条耦合本身就是
	#    故障来源：SSR 停止 → 这 24 个域名的所有子域（含冷门子域）解析异常，
	#    而用户看不出与 SSR 有关。移除后 dnsproxy 只依赖国内 DoH 主链，行为可预期。
	#
	# 移除不影响分流能力：国外域名仍经 dnsmasq 的 gfw_list.conf（23701 条）
	# 转去 mosdns:5335，由 MosDNS 经代理查国外 DoH。判定依据见
	#   grep -c '127.0.0.1#5335' /tmp/dnsmasq.d/dnsmasq-ssrplus.d/gfw_list.conf
	#
	# 相关：AGENTS.md 第 5 节（filter_aaaa 语义）、docs/adr/0001。
	# bootstrap 仅用于解析加密上游主机名（明文是它唯一且应有的用途）
	list bootstrap '223.5.5.5'
	list bootstrap '223.6.6.6'
	# fallback 备用通道同样加密（DoH），绝不明文；
	# v0.3.4 起仅保留国内可直连 IP-DoH（1.12.12.12），删除依赖 SSR-Plus 代理的 8.8.8.8，
	# 避免 SSR 规则重建窗口内 fallback 必然超时刷 ERROR
	list fallback 'https://1.12.12.12/dns-query'

config dnsproxy 'tls'
	option enabled '0'
	option tls_crt ''
	option tls_key ''
	option https_port '8443'
	option tls_port '853'
	option quic_port '853'