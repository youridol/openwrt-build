#!/bin/sh /etc/rc.common
# ============================================================
# dnschain — DNS 分流框架服务脚本（procd）
# ------------------------------------------------------------
# 本文件由 openwrt-build 仓库 files/ overlay 提供（非上游源码）。
# 设计依据：docs/adr/0003-dns-chain-framework.md
#
# 职责（v0.10.0 起：无 chinadns-ng）：
#   1. 生成 /var/etc/dnschain/*（dnsproxy.args、dnsproxy-foreign.args、foreign-split.conf）
#   2. 生成 dnsmasq 的 nftset 规则（把国外域名解析结果写入代理 IP 集）
#   3. procd 托管 dnsproxy :5353（唯一路由型解析器，不缓存）
#   4. 写 fw4 片段：拒绝 LAN 出向 853（T2）
#   5. 启动前做上游端口校验，失败即拒绝启动并说明原因
#
# 与 v0.9.x 的关键差异：
#   - **不再启动 chinadns-ng**。它的 -t 不支持 DoH，而落地节点到 853 全部
#     不通（实测 peer sent close notify），到 443 正常。故国外解析改由
#     dnsproxy 用 DoH 承担（实测拿到真实答案）。
#   - **不再抑制 AAAA**。SSR-Plus 的 IPv6 流量代理（ipv6_support=1）会把
#     国外 IPv6 也送进代理，保留双栈即可，无需抑制。
#   - dnsmasq 通过 nftset= 把国外域名的解析结果写入 ss_spec#blacklist，
#     替代 chinadns-ng 的 -A 参数。
#
# 硬约束：
#   - 缓存只在 dnsmasq 一层（ADR §10.5）
#   - /etc/nftables.d/*.nft 只能写裸 chain，禁止 table 声明（AGENTS 红线 7）
# ============================================================

START=95
STOP=10
USE_PROCD=1

. /usr/share/dnschain/dnschain.sh

PROG_DP="/usr/bin/dnsproxy"

# fw4 片段（fw4 自动 include /etc/nftables.d/*.nft）
DOT_NFT_FILE="/etc/nftables.d/15-dnschain-reject-dot.nft"

# dnsmasq 的 dnschain 片段（通过 conf-dir 加载）
DNSMASQ_DC_CONF="${DNSCHAIN_DNSMASQ_CONF_DIR}/dnschain-split.conf"

# ------------------------------------------------------------
# 生成全部运行时配置
# ------------------------------------------------------------
generate_all() {
	local n_db

	mkdir -p "$DNSCHAIN_RUN_DIR" "$DNSCHAIN_STATE_DIR" || return 1

	# 自定义列表与数据库域名集合是「归属判定」的输入，
	# 必须排在任何依赖归属的生成动作之前。
	dc_gen_custom_lists || return 1
	n_db=$(dc_gen_db_domains) || n_db=0
	dnschain_log "数据库国外域名 ${n_db} 条"

	dnschain_log "生成国外域名分流规则..."
	dc_gen_upstream_file >/dev/null || return 1

	dnschain_log "生成国内 dnsproxy 参数..."
	dc_gen_dnsproxy_args >/dev/null || return 1

	dnschain_log "生成国外 dnsproxy 参数..."
	dc_gen_foreign_args >/dev/null || return 1

	# v0.21.0：不再生成 watch.servers（健康改道已删除，见库文件注释）。

	# 记录本次名单指纹，供收敛器判断是否需要重导
	dc_lists_fingerprint > "$DNSCHAIN_STATE_DIR/lists.fingerprint"

	return 0
}

# ------------------------------------------------------------
# 生成 dnsmasq 的分流 + nftset 规则
#
# v0.13.0 起生成逻辑整体移到库函数 dc_gen_dnsmasq_split()：
# 它同时处理三类域名，并把观测域名从静态片段里排除。
#
# 三类（优先级：自定义 > 数据库 > 未覆盖）：
#   数据库国外 − 自定义国内 − 观测域名 → server= 指向 foreign_port + 入 blacklist
#   自定义国外                          → server= 指向 foreign_port + 入 blacklist
#   自定义国内                          → server= 指向 entry_port   + 入 china
#
# 为什么必须收口到一处：
#   此前 init 里内联一段 sed、reconcile 里又生成一次，两处口径稍有
#   差异就会让「页面上显示的分流条数」与「实际生效的规则」不一致。
#   现在只有一个生成函数，页面统计也读它的产物。
#
# 为什么观测域名不写在这里：
#   它们的去向由健康探测动态决定（watch.servers）。同一个域名若同时
#   出现在静态片段与 servers-file 里，dnsmasq 会把两条 server= 当作
#   **候选**（不是后者覆盖前者），改道就退化成「随机走一条」。
# ------------------------------------------------------------
update_dnsmasq_split() {
	local enabled res n_split n_nft

	enabled=$(dc_get main enabled 1)
	mkdir -p "$DNSCHAIN_DNSMASQ_CONF_DIR" || return 1

	if [ "$enabled" != "1" ]; then
		cat > "$DNSMASQ_DC_CONF" <<-EOF
			# dnschain: 分流与 nftset 已关闭（由 init.d/dnschain 管理）
		EOF
		return 0
	fi

	res=$(dc_gen_dnsmasq_split) || {
		dnschain_log "ERROR: 生成 dnsmasq 分流片段失败"
		return 1
	}

	n_split=$(echo "$res" | awk '{print $1}')
	n_nft=$(echo "$res" | awk '{print $2}')
	dnschain_log "dnsmasq 分流 ${n_split:-0} 条 → :$(dc_get main foreign_port 5336)；nftset ${n_nft:-0} 条"
	return 0
}

# ------------------------------------------------------------
# v0.21.0：update_serversfile 已删除
#
# 它原本把 dhcp.@dnsmasq[0].serversfile 设为 watch.servers，让 dnsmasq
# 通过 --servers-file 加载观测域名的动态上游（改道只 SIGHUP 不重启）。
#
# 健康改道删除后不再需要这条通道。而且它正是缺陷根源：
# watch.servers 与 dnschain-split.conf 是两套并存的 server= 源，
# 同域名在两处都有规则时 dnsmasq 当**候选**而非覆盖，取哪条不确定 ——
# 实测 www.wikipedia.org 因此拿到污染答案 31.13.106.4。
#
# ⚠️ 删除前已实测确认（路由器 2026-10-25）：
#   去掉 serversfile 后 dnsmasq 仍正常加载 split.conf
#   （split.conf 走 conf-dir=/tmp/dnsmasq.d，与 servers-file 是两套独立机制）。
#   去掉后 www.wikipedia.org 解析为 103.102.166.224（正确），
#   且 dnsmasq 进程参数里 servers-file 确实消失。
#
# 若将来 dhcp.@dnsmasq[0].serversfile 仍残留旧值，dnsmasq 会尝试读一个
# 可能不存在的文件并报错 —— 所以 start() 里要主动清掉它（见下方）。
# ------------------------------------------------------------

# ------------------------------------------------------------
# 清掉 dnsmasq 的 serversfile 设置（v0.21.0）
#
# 老版本会把 dhcp.@dnsmasq[0].serversfile 设成 watch.servers。
# 升级到本版后该文件不再生成，但 UCI 里的旧值**不会自动消失** ——
# dnsmasq 启动时会去读一个不存在的文件，在日志里报
# `cannot read /var/run/dnsmasq/watch.servers: No such file`。
#
# 所以要主动清。判据用「值是否等于旧的 watch.servers 路径」而不是
# 「值是否非空」—— 用户可能自己配了 serversfile 指向别处，那是他的选择，
# 不该被我们清掉。
# ------------------------------------------------------------
clear_serversfile() {
	local cur

	cur=$(uci -q get dhcp.@dnsmasq[0].serversfile 2>/dev/null)
	[ -n "$cur" ] || return 0

	# 只清我们自己以前写的那个值
	[ "$cur" = "$DNSCHAIN_WATCH_SERVERS" ] || return 0

	uci -q delete dhcp.@dnsmasq[0].serversfile || {
		dnschain_log "ERROR: 清理 dhcp.@dnsmasq[0].serversfile 失败"
		return 1
	}
	uci -q commit dhcp
	dnschain_log "已清理遗留的 serversfile=${cur}（改道通道已废弃）"
	return 0
}

# ------------------------------------------------------------
# 启动前校验
# 失败返回非 0，调用方须拒绝启动（禁止静默失败，AGENTS 红线 3）
# ------------------------------------------------------------
preflight() {
	local cn_up foreign_up bad rc fport _dot_bad

	# 1. 上游端口必须落在 ss_spec_output 的 TCP 端口集内，
	#    否则路由器自身出向不进代理、静默直连后被墙（ADR §10.8）
	#
	#    v0.10.0：国外上游改成 DoH(443)，在端口集内；
	#    国内 DoT(853) 也在端口集内但实际直连（在 china 集里，被 return）。
	cn_up=$(dc_get_list cn server | tr '\n' ' ')
	foreign_up=$(dc_get_list foreign server | tr '\n' ' ')

	bad=$(dc_validate_upstream_ports $cn_up $foreign_up)
	rc=$?
	if [ "$rc" -ne 0 ]; then
		dnschain_log "ERROR: 以下上游端口不在 ss_spec_output 的代理端口集内，"
		dnschain_log "ERROR: 路由器自身出向不会被代理，国外域名会静默失败："
		echo "$bad" | while read -r line; do
			[ -n "$line" ] && dnschain_log "ERROR:   $line"
		done
		return 1
	fi

	# 2. 二进制必须存在
	[ -x "$PROG_DP" ] || { dnschain_log "ERROR: 缺少 ${PROG_DP}"; return 1; }

	# 3. 两个端口不能相同（否则两个实例抢同一端口，后起的静默失败）
	fport=$(dc_get main foreign_port 5336)
	if [ "$fport" = "$(dc_get main entry_port 5353)" ]; then
		dnschain_log "ERROR: entry_port 与 foreign_port 相同（都是 ${fport}），两个实例会抢端口"
		return 1
	fi

	# 4. 国外分流规则非空（空文件意味着所有 gfw 域名都会走国内上游 → 污染）
	if [ ! -s "$DNSCHAIN_RUN_DIR/foreign-split.conf" ]; then
		dnschain_log "ERROR: foreign-split.conf 为空，国外域名会全部走国内上游（污染）"
		dnschain_log "ERROR: 请确认 ${DNSCHAIN_SSR_CONF_DIR}/gfw_list.conf 或 /etc/ssrplus/gfw_list.conf 存在"
		return 1
	fi

	# 5. 国外上游必须是 DoH（443）。DoT(853) 在本环境不可用，
	#    配成 DoT 会让国外域名拿不到答案（实测 peer sent close notify）。
	#    这是硬校验：宁可拒绝启动，也不让用户面对「能解析但全是污染值」。
	_dot_bad=$(dc_get_list foreign server | grep -E '^tls://' || true)
	if [ -n "$_dot_bad" ]; then
		dnschain_log "ERROR: 国外上游不能是 DoT（tls://）：落地节点到 853 不通。"
		dnschain_log "ERROR: 实测 8.8.8.8:853 / 1.1.1.1:853 全部 peer sent close notify，"
		dnschain_log "ERROR: 而 443 正常。请改用 DoH：https://dns.google/dns-query"
		echo "$_dot_bad" | while read -r line; do
			[ -n "$line" ] && dnschain_log "ERROR:   不合规: $line"
		done
		return 1
	fi

	return 0
}

# ------------------------------------------------------------
# fw4 片段：拒绝 LAN 出向 853
#
# 为什么必须写：ss_spec_mangle prerouting 的优先级是 mangle(-150)，
# 而 fw4 的 dns_intercept_lan 是 dstnat+1(-99)，tproxy 先执行。
# 客户机自带 DoT 时会先进 :1234，绕过我们的策略。
#
# 写法约束（AGENTS 红线 7）：只能写裸 chain，禁止 table 声明。
#
# 优先级 -151 已在路由器上实测（2026-10-20）：
#   - 作为 fw4 include 的裸 chain（在 table inet fw4 内部）**语法有效**
#   - nft 将其规范化为 `mangle - 1`，即比 mangle(-150) 更早执行
#   - 单独 `nft -f` 一个裸 chain 会报语法错误（缺 table 上下文），
#     但 fw4 的加载路径是 include 到 table 内，故写法正确
#   - 实测加载后 `nft list chain` 显示 `priority mangle - 1`
# ------------------------------------------------------------
update_dot_reject() {
	local dev enable

	enable=$(dc_get main intercept_dot 1)
	dev=$(uci -q get network.lan.device)
	[ -z "$dev" ] && dev=$(uci -q get network.lan.ifname)
	[ -z "$dev" ] && dev="br-lan"

	mkdir -p /etc/nftables.d || return 1

	if [ "$enable" = "1" ] && [ "$(dc_get main enabled 1)" = "1" ]; then
		cat > "$DOT_NFT_FILE" <<-EOF
			# dnschain: 拒绝 LAN 出向 853（由 init.d/dnschain 管理，勿手工编辑）
			# 目的: 让自带 DoT 的客户端快速失败并回落明文 53，从而被 DNS 策略覆盖。
			# 优先级 -151（nft 显示为 mangle - 1）先于 ss_spec_mangle 的
			# mangle(-150)，否则 tproxy 会抢先。
			# 裸 chain（fw4 在 table inet fw4 内部 include 本目录，禁止再写 table）。
			chain dnschain_reject_dot {
				type filter hook prerouting priority -151; policy accept;
				iifname "$dev" tcp dport 853 reject comment "!dnschain: reject LAN DoT"
				iifname "$dev" udp dport 853 reject comment "!dnschain: reject LAN DoQ"
			}
		EOF
	else
		# 关闭时不删文件，只清空为注释占位。
		# 原因: fw4 对 /etc/nftables.d/*.nft 用 glob include，
		#       目录为空会导致 include 无匹配、fw4 reload 失败。
		cat > "$DOT_NFT_FILE" <<-EOF
			# dnschain: LAN 出向 853 拒绝已关闭（由 init.d/dnschain 管理）
		EOF
	fi

	# 触发 fw4 重载使规则生效/移除
	if [ -x /etc/init.d/firewall ]; then
		/etc/init.d/firewall reload >/dev/null 2>&1
	fi
}

# ------------------------------------------------------------
# 启动国内 dnsproxy 实例（:5353）
# ------------------------------------------------------------
start_dnsproxy() {
	local args

	args=$(dc_args_to_cmdline "$DNSCHAIN_RUN_DIR/dnsproxy.args")
	[ -n "$args" ] || { dnschain_log "ERROR: dnsproxy.args 为空"; return 1; }

	procd_open_instance "dnsproxy"
	procd_set_param command "$PROG_DP" $args
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	# dnsproxy 需要读 /etc/hosts 与 CA 证书；不需要绑定低端口
	procd_add_jail_mount "/etc/hosts"
	procd_add_jail_mount "/etc/ssl/certs/ca-certificates.crt"
	procd_add_jail_mount "$DNSCHAIN_RUN_DIR"
	procd_close_instance
}

# ------------------------------------------------------------
# 启动国外 dnsproxy 实例（:5336，只配 DoH）
#
# 为什么单独一个实例（关键设计决策）：
#   最初尝试用单实例 + [/域名/]https://dns.google 分流（17767 条），
#   实测**完全失败**：dnsproxy 为每个域名各注册一条 reserved 上游
#   （verbose 日志 idx=3..17769），资源耗尽后查询直接
#   `connection timed out; no servers could be reached`。
#   拆成两个实例 + dnsmasq 的 server=/域名/ 分流后实测正常。
# ------------------------------------------------------------
start_foreign_dnsproxy() {
	local args

	args=$(dc_args_to_cmdline "$DNSCHAIN_RUN_DIR/dnsproxy-foreign.args")
	[ -n "$args" ] || { dnschain_log "ERROR: dnsproxy-foreign.args 为空"; return 1; }

	procd_open_instance "dnsproxy-foreign"
	procd_set_param command "$PROG_DP" $args
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_add_jail_mount "/etc/hosts"
	procd_add_jail_mount "/etc/ssl/certs/ca-certificates.crt"
	procd_add_jail_mount "$DNSCHAIN_RUN_DIR"
	procd_close_instance
}

# ------------------------------------------------------------
# 重启 dnsmasq 使 nftset 片段生效
#
# 注意：必须用 restart 而非 reload。实测 reload（SIGHUP）不重读 conf-dir，
# 新生成的 nftset 规则不会被加载（AGENTS §4.4）。
# ------------------------------------------------------------
# ⚠️ DNSCHAIN_SKIP_DNSMASQ_RESTART=1 时只登记「待重启」，不真的重启。
#
# 为什么需要（v0.14.3 修 S3）：`reload_service` 原本的调用链是
#   reload_service → reload_dnsmasq   （第 1 次）
#                 → stop → stop_service → reload_dnsmasq（第 2 次）
#                 → start → start_service → reload_dnsmasq（第 3 次）
# 实测一次 `/etc/init.d/dnschain reload` 期间 dnsmasq 主进程出现了
# **4 个不同 PID**（6576→7704→7873→9467），即至少重启 3 次。
# 而 AGENTS §4.4 实测 restart 约 3 秒完全不可用 → 一次配置应用断 9 秒以上。
#
# 更糟的是第 2 次发生在 `stop_service` 已把分流片段写成「服务已停止」
# 注释之后、`start` 重建之前 —— 那几秒 dnsmasq 跑在**没有分流片段**
# 的中间状态下，所有国外域名走默认上游。
#
# 现在：reload_service 设标志 → 中间各步只登记 → 末尾统一重启一次。
# 用**标记文件**而不是环境变量：procd 的 stop/start 会重新 exec
# 本脚本，导出的变量跨不过那道边界（实测用环境变量只能减到 2 次）。
DNSCHAIN_RESTART_FLAG="/var/run/dnschain/.dnsmasq-dirty"

reload_dnsmasq() {
	if [ -f "$DNSCHAIN_RESTART_FLAG" ]; then
		# 已被 reload_service 接管：只登记，不重启
		return 0
	fi
	if [ -x /etc/init.d/dnsmasq ]; then
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
	fi
}

# ------------------------------------------------------------
# 启动健康探测守护进程（procd 托管）
#
# 为什么单独一个 procd 实例而不是塞进 dnsproxy 的 shell 包装：
#   dnsproxy 是外部二进制，它的 respawn 语义是「进程退出就重启」。
#   若把探测循环挂在它旁边，探测崩溃会连带重启 dnsproxy，
#   造成不必要的解析中断。独立实例各管各的。
#
# 为什么 enabled=0 时不启动：
#   用户可能只想保留静态分流（明确的自定义列表），不要自动改道。
#   此时不建实例，procd 也不会反复重启一个「什么都不做」的进程。
# ------------------------------------------------------------
start_health_daemon() {
	local enabled interval

	enabled=$(dc_get health enabled 1)
	[ "$enabled" = "1" ] || return 0

	interval=$(dc_get health interval 60)
	[ "$interval" -gt 0 ] 2>/dev/null || return 0

	procd_open_instance "health"
	procd_set_param command /usr/bin/dnschain-health daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	config_load "$DNSCHAIN_CONF"

	if [ "$(dc_get main enabled 1)" != "1" ]; then
		dnschain_log "框架未启用（dnschain.main.enabled=0），不启动任何进程"
		update_dot_reject
		update_dnsmasq_split
		reload_dnsmasq
		return 0
	fi

	# 生成配置 → 校验 → 启动
	generate_all || { dnschain_log "ERROR: 生成运行时配置失败，中止启动"; return 1; }

	if ! preflight; then
		dnschain_log "ERROR: 启动前校验失败，拒绝启动（禁止静默失败）"
		return 1
	fi

	# 先生成 dnsmasq 的分流片段，再启动两个 dnsproxy 实例
	update_dnsmasq_split
	clear_serversfile
	reload_dnsmasq

	start_dnsproxy
	start_foreign_dnsproxy

	update_dot_reject

	# 健康探测在实例起来之后才启动（它自己也会等一轮 interval 再探）
	start_health_daemon

	dnschain_log "已启动：国内 :$(dc_get main entry_port 5353)、国外 :$(dc_get main foreign_port 5336)"

	# 名单指纹留给收敛器比较
	dc_lists_fingerprint > "$DNSCHAIN_STATE_DIR/lists.fingerprint" 2>/dev/null
	return 0
}

stop_service() {
	# procd 会负责杀进程；这里只清理 fw4 片段与 dnsmasq 片段
	# 注意：不删文件，清空为注释占位（理由同 update_dot_reject）
	mkdir -p /etc/nftables.d 2>/dev/null
	cat > "$DOT_NFT_FILE" <<-EOF
		# dnschain: 服务已停止（由 init.d/dnschain 管理）
	EOF
	mkdir -p "$DNSCHAIN_DNSMASQ_CONF_DIR" 2>/dev/null
	cat > "$DNSMASQ_DC_CONF" <<-EOF
		# dnschain: 服务已停止（由 init.d/dnschain 管理）
	EOF

	# v0.21.0：健康状态与 watch.servers 都已随改道功能删除。
	#
	# 原来这里做两件事：
	#   ① rm -f health.state       —— 丢掉「已改道」状态
	#   ② 把 watch.servers 清成注释占位 —— 防 dnsmasq 重启后读到
	#      指向已停端口的 server=，导致观测域名稳定解析失败
	#
	# 两者都不再需要：没有改道就没有 health.state，也不再生成 watch.servers。
	# 但**仍要清掉可能残留的 watch.servers 文件** —— 从老版本升级上来时
	# 它可能还在 tmpfs 里（tmpfs 不随 stop 消失），而 dnsmasq 若仍带着
	# --servers-file 就会读它。clear_serversfile 已清掉 UCI 设置，
	# 这里把文件本身也删掉，双保险。
	rm -f "$DNSCHAIN_HEALTH_STATE" 2>/dev/null
	[ -n "$DNSCHAIN_WATCH_SERVERS" ] && rm -f "$DNSCHAIN_WATCH_SERVERS" 2>/dev/null

	if [ -x /etc/init.d/firewall ]; then
		/etc/init.d/firewall reload >/dev/null 2>&1
	fi
	reload_dnsmasq
	dnschain_log "已停止"
}

reload_service() {
	# 配置变更后重新生成并重启实例
	#
	# ⚠️ 全程抑制 dnsmasq 重启，最后统一重启**一次**（v0.14.3 修 S3）。
	#    理由见 reload_dnsmasq 上方的注释：原调用链会重启 3 次，
	#    且中间那次让 dnsmasq 跑在「没有分流片段」的状态下。
	mkdir -p /var/run/dnschain 2>/dev/null
	: > "$DNSCHAIN_RESTART_FLAG" 2>/dev/null

	config_load "$DNSCHAIN_CONF"
	generate_all || { rm -f "$DNSCHAIN_RESTART_FLAG"; return 1; }
	if [ "$(dc_get main enabled 1)" = "1" ]; then
		preflight || { rm -f "$DNSCHAIN_RESTART_FLAG"; return 1; }
	fi
	update_dnsmasq_split
	clear_serversfile
	update_dot_reject

	# 让 procd 重启实例（内部两次 reload_dnsmasq 都只登记）
	stop
	start

	# 解除抑制，统一重启**一次**
	rm -f "$DNSCHAIN_RESTART_FLAG" 2>/dev/null
	if [ -x /etc/init.d/dnsmasq ]; then
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
		dnschain_log "dnsmasq 已重启（一次性，配置变更后生效）"
	fi
}

service_triggers() {
	procd_add_reload_trigger "$DNSCHAIN_CONF"
}
