@@ -39,9 +64,31 @@ define Package/$(PKG_NAME)/postinst
 chmod 0600 "$${IPKG_INSTROOT}/etc/config/trafficctl" 2>/dev/null || true
 if [ -z "$${IPKG_INSTROOT}" ]; then
