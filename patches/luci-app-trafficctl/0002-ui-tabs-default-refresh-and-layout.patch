+    background: var(--tc-bg);
+}
+.tc-settings-title {
+    font-size: 13px;
+    font-weight: 700;
+    color: var(--tc-text, inherit);
+    letter-spacing: .2px;
+}
+.tc-settings-hint {
+    font-size: 11px;
+    color: var(--tc-faint, var(--tc-muted));
 }
-.tc-settings-toggle {
-    padding: 8px 14px;
+.tc-settings-body {
+    padding: 12px 14px 14px;
+}
+
+/* ── Settings tabs ─────────────────────────────────────────────────── */
+.tc-settings-tabs {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 4px;
+    margin-bottom: 12px;
+    border-bottom: 1px solid var(--tc-border);
+}
+.tc-stab {
+    padding: 6px 14px;
     cursor: pointer;
     user-select: none;
+    font-size: 12px;
+    font-weight: 600;
+    color: var(--tc-muted);
+    border: 1px solid transparent;
+    border-bottom: 2px solid transparent;
+    border-radius: 4px 4px 0 0;
+    margin-bottom: -1px;
+    transition: color .12s ease, background .12s ease;
+}
+.tc-stab:hover {
+    color: var(--tc-text, inherit);
+    background: var(--tc-bg);
+}
+.tc-stab--active {
+    color: var(--tc-speed);
+    border-bottom-color: var(--tc-speed);
+    background: var(--tc-bg);
+}
+
+/* ── Settings cards：多列瀑布流 ──────────────────────────────────────
+   卡片高度不一（Telegram 1.2k px、显示 ~100 px），用 CSS 多列让浏览器
+   自动均衡分列，避免网格「按行取最高卡片」留下的大片空白。 */
+.tc-settings-pane {
+    column-count: 2;
+    column-gap: 12px;
+}
+@media (max-width: 760px) {
+    .tc-settings-pane { column-count: 1; }
+}
+.tc-card {
+    break-inside: avoid;
+    -webkit-column-break-inside: avoid;
+    page-break-inside: avoid;
+    display: inline-block;
+    width: 100%;
+    margin: 0 0 12px;
+    border: 1px solid var(--tc-border);
+    border-radius: 5px;
+    background: var(--tc-bg);
+    overflow: hidden;
+}
+/* 展开态用左侧色条标示，比整框变色更克制、也更容易扫视 */
+.tc-card--open {
+    border-left: 3px solid var(--tc-speed, var(--tc-border));
+}
+.tc-collapsible-head {
     display: flex;
     align-items: center;
     gap: 6px;
-    font-size: 12px;
+    cursor: pointer;
+    user-select: none;
+    padding: 9px 12px !important;
+    margin: 0 !important;
+    border-bottom: 1px solid transparent;
     font-weight: 600;
+    font-size: 12px;
+    transition: background .12s ease;
+}
+.tc-collapsible-head:hover {
+    background: var(--tc-bg-alt);
+}
+.tc-card--open .tc-collapsible-head {
+    border-bottom-color: var(--tc-border);
+}
+.tc-collapse-arrow {
+    font-size: 10px;
     color: var(--tc-muted);
+    width: 10px;
+    display: inline-block;
+    text-align: center;
+    flex: 0 0 auto;
 }
-.tc-settings-body {
-    padding: 0 14px 10px;
+.tc-card .tc-collapsible-body {
+    padding: 10px 12px;
+}
+/* chips 容器：上游**完全没有**为 .tc-chips-wrap 定义样式，导致「可见列」
+   一长串 chips 不换行、右侧被卡片 overflow:hidden 裁掉。 */
+.tc-chips-wrap {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: 2px;
+    margin-bottom: 2px;
+    max-width: 100%;
 }
 .tc-settings-section-row {
     display: flex;
