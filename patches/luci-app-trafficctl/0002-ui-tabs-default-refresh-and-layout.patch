-/* ── Settings panel (collapsible) ────────────────────────────────── */
+/* ── Settings panel ───────────────────────────────────────────────────
+   【本仓库补丁（相对上游 1.21.4）】
+   上游把整个设置区包在可折叠容器内且初始隐藏（.tc-settings-toggle +
+   .tc-settings-body.tc-hidden），用户必须点标题才能看到设置项。
+   本仓库改为：常显标题栏 + 内容始终可见。
+
+   Telegram Bot 已提升为**页面级独立 tab**（telegram.js，由 menu.d 生成，
+   与「设备」「端口转发」并列），故这里不再有内层 tab —— 两级 tab 会让人
+   分不清哪一层在切页。相关样式（.tc-settings-tabs / .tc-stab）已移除。
+   ─────────────────────────────────────────────────────────────────── */
 .tc-settings-panel {
-    border-radius: 4px;
-    margin-bottom: 10px;
+    border-radius: 6px;
+    margin-bottom: 12px;
     background: var(--tc-bg-alt);
     border: 1px solid var(--tc-border);
+    overflow: hidden;
 }
-.tc-settings-toggle {
-    padding: 8px 14px;
-    cursor: pointer;
-    user-select: none;
+.tc-settings-head {
+    display: flex;
+    align-items: baseline;
+    gap: 10px;
+    padding: 10px 14px;
+    border-bottom: 1px solid var(--tc-border);
+    background: var(--tc-bg);
+}
+.tc-settings-title {
+    font-size: 13px;
+    font-weight: 700;
+    color: var(--tc-text, inherit);
+    letter-spacing: .2px;
+}
+.tc-settings-hint {
+    font-size: 11px;
+    color: var(--tc-faint, var(--tc-muted));
+}
+/* 卡片瀑布流：卡片高度不一，用 CSS 多列让浏览器自动均衡分列，
+   避免网格「按行取最高卡片」留下的大片空白。 */
+.tc-settings-body {
+    padding: 12px 14px 14px;
+    column-count: 2;
+    column-gap: 12px;
+}
+@media (max-width: 760px) {
+    .tc-settings-body { column-count: 1; }
+}
+
+/* Telegram 独立页：内容较长，单列铺满，不做多列（表单需要整行宽度）。 */
+.tg-page {
+    margin-top: 4px;
+}
+
+/* ── Settings cards ──────────────────────────────────────────────────
+   卡片高度不一（Telegram 1.2k px、显示 ~100 px），由 .tc-settings-body 上的
+   column-count 让浏览器自动均衡分列，避免网格「按行取最高卡片」留下空白。 */
+.tc-card {
+    break-inside: avoid;
+    -webkit-column-break-inside: avoid;
+    page-break-inside: avoid;
+    display: inline-block;
+    width: 100%;
+    margin: 0 0 12px;
+    border: 1px solid var(--tc-border);
+    border-radius: 5px;
+    background: var(--tc-bg);
+    overflow: hidden;
+}
+/* 展开态用左侧色条标示，比整框变色更克制、也更容易扫视 */
+.tc-card--open {
+    border-left: 3px solid var(--tc-speed, var(--tc-border));
+}
+.tc-collapsible-head {
     display: flex;
     align-items: center;
     gap: 6px;
-    font-size: 12px;
+    cursor: pointer;
+    user-select: none;
+    padding: 9px 12px !important;
+    margin: 0 !important;
+    border-bottom: 1px solid transparent;
     font-weight: 600;
+    font-size: 12px;
+    transition: background .12s ease;
+}
+.tc-collapsible-head:hover {
+    background: var(--tc-bg-alt);
+}
+.tc-card--open .tc-collapsible-head {
+    border-bottom-color: var(--tc-border);
+}
+.tc-collapse-arrow {
+    font-size: 10px;
     color: var(--tc-muted);
+    width: 10px;
+    display: inline-block;
+    text-align: center;
+    flex: 0 0 auto;
 }
-.tc-settings-body {
-    padding: 0 14px 10px;
+.tc-card .tc-collapsible-body {
+    padding: 10px 12px;
+}
+/* chips 容器：上游**完全没有**为 .tc-chips-wrap 定义样式，导致「可见列」
+   一长串 chips 不换行、右侧被卡片 overflow:hidden 裁掉。 */
+.tc-chips-wrap {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: 2px;
+    margin-bottom: 2px;
+    max-width: 100%;
 }
 .tc-settings-section-row {
     display: flex;
