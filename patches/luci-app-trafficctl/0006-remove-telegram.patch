-get_device_conns() {
-	local ip="$1" n
-	# grep -c prints 0 itself on no match (with exit status 1), so an
-	# "|| echo 0" here would emit a second line and corrupt the value.
-	n=$(grep -c "src=$ip " /proc/net/nf_conntrack 2>/dev/null)
-	echo "${n:-0}"
-}
