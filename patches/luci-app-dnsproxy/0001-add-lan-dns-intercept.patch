diff --git a/www/luci-static/resources/tools/dnsproxy/settings.js b/www/luci-static/resources/tools/dnsproxy/settings.js
index 0ada5bb..7f221d2 100644
--- a/www/luci-static/resources/tools/dnsproxy/settings.js
+++ b/www/luci-static/resources/tools/dnsproxy/settings.js
@@ -66,6 +66,16 @@ return L.Class.extend({
     o.cfgvalue = function() { return uci.get('dnsproxy', 'global', 'log_file'); };
     o.write    = function(sid, val) { uci.set('dnsproxy', 'global', 'log_file', val); };
 
+    /* ── ALL_DOH: LAN DNS 强制拦截（本地 patch 新增，勿在上游修改）── */
+    o = s.taboption('general', form.Flag, 'lan_dns_intercept',
+      '拦截所有客户端 DNS（Intercept all client DNS）',
+      '将所有 LAN 客户端发往任意地址的 DNS 查询（UDP/TCP 端口 53）强制重定向到本机 dnsproxy 链路，' +
