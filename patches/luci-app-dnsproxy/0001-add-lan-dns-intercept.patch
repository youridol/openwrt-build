+      '通过 dnsproxy init + firewall4(/etc/nftables.d) 自动管理，UCI 键: dnsproxy.global.lan_dns_intercept');
+    o.rmempty = false;
+    o.cfgvalue = function() { return uci.get('dnsproxy', 'global', 'lan_dns_intercept'); };
+    o.write    = function(sid, val) { uci.set('dnsproxy', 'global', 'lan_dns_intercept', val); };
+
     /* ── Servers ── */
     o = s.taboption('servers', form.DynamicList, 'upstream', _('Upstream servers'),
       _('Supports plain DNS, DoT (tls://), DoH (https://), DoQ (quic://), DNSCrypt (sdns://)'));
diff --git a/www/luci-static/resources/view/dnsproxy/main.js b/www/luci-static/resources/view/dnsproxy/main.js
index ba9cf10..f17c585 100644
--- a/www/luci-static/resources/view/dnsproxy/main.js
