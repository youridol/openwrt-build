+// ALL_DOH patch: 兼容 opkg 固件(lede/24.10) — /usr/lib/opkg/status 的格式:
+//   Package: dnsproxy
+//   Version: 0.83.0-1
+//   以空行分隔。解析失败返回 null(视为未安装)。
+function parseVersion(pkgDb) {
+    if (!pkgDb) return null
+    var blocks = pkgDb.split('\n\n')
     for (var i = 0; i < blocks.length; i++) {
+        // apk 格式: P:<name> + V:<version>
         if (/^P:dnsproxy$/m.test(blocks[i])) {
             var m = blocks[i].match(/^V:(.+)$/m)
             return m ? m[1].trim() : null
         }
+        // opkg 格式: Package: <name> + Version: <version>
+        if (/^Package:\s*dnsproxy$/m.test(blocks[i])) {
+            var m2 = blocks[i].match(/^Version:\s*(.+)$/m)
+            return m2 ? m2[1].trim() : null
+        }
     }
     return null // пакет не найден в базе — не установлен
 }
@@ -309,8 +319,12 @@ return view.extend({
         return Promise.all([
             uci.load('dnsproxy'),
